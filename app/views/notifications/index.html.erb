<div class="container mt-4" style="max-width: 800px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 fw-bold mb-1"><i class="bi bi-bell-fill me-2 text-primary"></i>Mis Notificaciones</h1>
      <p class="text-muted mb-0">Revisa las alertas y avisos del sistema.</p>
    </div>
    <% if @notifications.unread.any? %>
      <%= button_to "Marcar todas como leídas", mark_all_as_read_notifications_path, method: :patch, class: "btn btn-primary btn-sm" %>
    <% end %>
  </div>

  <div class="card shadow-sm">
    <div class="card-body p-0">
      <% if @notifications.any? %>
        <ul class="list-group list-group-flush">
          <% @notifications.each do |notification| %>
            <li class="list-group-item <%= 'bg-primary-subtle' unless notification.read? %>">
              <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                  <div class="d-flex align-items-center gap-2">
                    <span class="fw-semibold"><%= notification.title %></span>
                    <% unless notification.read? %>
                      <span class="badge text-bg-primary rounded-pill">Nueva</span>
                    <% end %>
                  </div>
                  <p class="text-muted small mb-1 mt-1"><%= notification.message %></p>
                  <% if notification.notifiable_type == 'PasswordResetRequest' %>
                    <%= link_to "Ver solicitud", password_reset_request_path(notification.notifiable_id), class: "small" %>
                  <% end %>
                </div>
                <div class="text-end">
                  <p class="text-muted small mb-1"><%= time_ago_in_words(notification.created_at) %> atrás</p>
                  <% unless notification.read? %>
                    <%= button_to "Marcar leída", mark_as_read_notification_path(notification), method: :patch, class: "btn btn-sm btn-link p-0" %>
                  <% end %>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-bell-slash d-block mb-2 fs-3 opacity-50"></i>
          No tienes notificaciones por el momento.
        </div>
      <% end %>
    </div>
  </div>
</div>
