<div class="max-w-4xl mx-auto mt-8 px-4 sm:px-6 lg:px-8">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Mis Notificaciones</h1>
      <p class="mt-2 text-sm text-gray-600">Revisa las alertas y avisos del sistema.</p>
    </div>
    <% if @notifications.unread.any? %>
      <%= button_to "Marcar todas como leídas", mark_all_as_read_notifications_path, method: :patch, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700" %>
    <% end %>
  </div>

  <div class="bg-white shadow overflow-hidden sm:rounded-md">
    <% if @notifications.any? %>
      <ul role="list" class="divide-y divide-gray-200">
        <% @notifications.each do |notification| %>
          <li class="<%= notification.read? ? 'bg-white' : 'bg-blue-50' %> hover:bg-gray-50">
            <div class="px-4 py-4 flex items-center sm:px-6">
              <div class="min-w-0 flex-1 sm:flex sm:items-center sm:justify-between">
                <div class="truncate">
                  <div class="flex text-sm">
                    <p class="font-medium <%= notification.read? ? 'text-gray-900' : 'text-blue-900' %> truncate"><%= notification.title %></p>
                    <% unless notification.read? %>
                      <span class="ml-2 flex-shrink-0 inline-block px-2 py-0.5 text-xs font-medium bg-blue-100 text-blue-800 rounded-full">Nueva</span>
                    <% end %>
                  </div>
                  <div class="mt-2 flex">
                    <div class="flex items-center text-sm text-gray-500">
                      <p><%= notification.message %></p>
                      <% if notification.notifiable_type == 'PasswordResetRequest' %>
                        <%= link_to "Ver solicitud", password_reset_request_path(notification.notifiable_id), class: "ml-4 text-blue-600 hover:underline" %>
                      <% end %>
                    </div>
                  </div>
                </div>
                <div class="mt-4 flex-shrink-0 sm:mt-0 sm:ml-5">
                  <div class="flex items-center text-sm text-gray-500 space-x-4">
                    <p><%= time_ago_in_words(notification.created_at) %> atrás</p>
                    <% unless notification.read? %>
                      <%= button_to "Marcar leída", mark_as_read_notification_path(notification), method: :patch, class: "text-blue-600 hover:text-blue-900 font-medium" %>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="px-4 py-12 text-center text-gray-500">
        No tienes notificaciones por el momento.
      </div>
    <% end %>
  </div>
</div>
