<div class="card shadow-sm">
  <div class="card-header bg-white">
    <h5 class="mb-0">
      <i class="bi bi-file-earmark-pdf text-danger me-2"></i>
      <%= document.persisted? ? "Editar Documento" : "Nuevo Documento" %>
    </h5>
  </div>
  <div class="card-body">
    <%= form_with(model: [vehicle, document], local: true, html: { enctype: "multipart/form-data" }) do |f| %>

      <% if document.errors.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% document.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="row g-3">
        <div class="col-md-6">
          <%= f.label :doc_type, "Tipo de Documento", class: "form-label fw-medium" %>
          <%= f.select :doc_type,
                VehicleDocument.doc_types.keys.map { |k| [vehicle_doc_type_label(k), k] },
                { prompt: "Selecciona un tipo…" },
                class: "form-select" %>
        </div>

        <div class="col-md-6">
          <%= f.label :due_on, "Fecha de Vencimiento", class: "form-label fw-medium" %>
          <%= f.date_field :due_on, class: "form-control" %>
        </div>

        <div class="col-md-6">
          <%= f.label :status, "Estado", class: "form-label fw-medium" %>
          <%= f.select :status,
                VehicleDocument.statuses.keys.map { |k| [document_status_label(k), k] },
                { prompt: "Selecciona estado…" },
                class: "form-select" %>
        </div>

        <div class="col-12">
          <%= f.label :notes, "Notas (opcional)", class: "form-label fw-medium" %>
          <%= f.text_area :notes, rows: 3, class: "form-control",
                placeholder: "Observaciones adicionales…" %>
        </div>

        <div class="col-12">
          <%= f.label :file, class: "form-label fw-medium" do %>
            <i class="bi bi-paperclip me-1"></i>
            Archivo PDF
            <% if document.persisted? && document.file.attached? %>
              <span class="text-muted fw-normal small">(dejar vacío para mantener el actual)</span>
            <% end %>
          <% end %>
          <%= f.file_field :file, accept: "application/pdf",
                class: "form-control",
                id: "document_file" %>
          <% if document.persisted? && document.file.attached? %>
            <div class="mt-2 small text-muted">
              <i class="bi bi-file-earmark-pdf text-danger me-1"></i>
              Archivo actual: <strong><%= document.file.filename %></strong>
              (<%= number_to_human_size(document.file.byte_size) %>)
            </div>
          <% end %>
          <div class="form-text">Solo se aceptan archivos en formato PDF.</div>
        </div>
      </div>

      <div class="d-flex gap-2 mt-4">
        <%= f.submit document.persisted? ? "Guardar Cambios" : "Crear Documento",
              class: "btn btn-primary" %>
        <%= link_to "Cancelar", vehicle_path(vehicle), class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>
