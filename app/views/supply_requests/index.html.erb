<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0"><i class="bi bi-inboxes me-2"></i>Solicitudes de suministros</h1>
      <p class="text-muted mb-0">Pedidos de repuestos a bodega para cada vehículo.</p>
    </div>
    <% if policy(SupplyRequest).create? %>
      <%= link_to new_supply_request_path, class: "btn btn-primary" do %>
        <i class="bi bi-plus-lg me-1"></i>Nueva solicitud
      <% end %>
    <% end %>
  </div>

  <div class="card">
    <% if @supply_requests.any? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Folio</th>
              <th>Vehículo</th>
              <th>Estado</th>
              <th>Fecha</th>
              <th class="text-end">Repuestos</th>
              <th>Solicitante</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>
          <% editable_ids = @supply_requests.select { |r| policy(r).edit? && !r.delivered? }.map(&:id) %>
          <tbody>
            <% @supply_requests.each do |req| %>
              <tr>
                <td class="fw-bold text-muted">#<%= req.id %></td>
                <td class="fw-bold"><%= req.vehicle.plate %></td>
                <td><%= status_badge(supply_request_status_label(req.status), req.status) %></td>
                <td><%= l(req.created_at.to_date) %></td>
                <td class="text-end"><%= req.supply_request_lines.size %></td>
                <td class="text-muted small"><%= req.user.email %></td>
                <td class="text-end">
                  <div class="gf-row-actions">
                    <%= link_to req, class: "btn btn-sm btn-outline-primary", title: "Ver", "aria-label": "Ver" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <% if editable_ids.include?(req.id) %>
                      <%= link_to edit_supply_request_path(req), class: "btn btn-sm btn-outline-secondary", title: "Editar", "aria-label": "Editar" do %>
                        <i class="bi bi-pencil"></i>
                      <% end %>
                    <% elsif editable_ids.any? %>
                      <%# Hueco del botón Editar (solicitud entregada) para que el ojo quede alineado con las otras filas. %>
                      <span class="btn btn-sm invisible" aria-hidden="true"><i class="bi bi-pencil"></i></span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5 px-3 text-muted">
        <i class="bi bi-inboxes d-block opacity-50"></i>
        <p class="mb-1 fw-bold text-body">No hay solicitudes de suministros</p>
        <p class="small mb-0">
          <% if policy(SupplyRequest).create? %>
            Crea una con el botón «Nueva solicitud» para pedir repuestos a bodega.
          <% else %>
            Cuando un mecánico pida repuestos para un vehículo, la solicitud aparecerá aquí.
          <% end %>
        </p>
      </div>
    <% end %>
  </div>
  <%= render "shared/pagination", pagy: @pagy %>
</div>
