<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0"><i class="bi bi-file-earmark-text me-2 text-primary"></i> Solicitud #<%= @supply_request.id %></h1>
      <p class="text-muted mb-0 mt-1">Generada el <strong><%= l(@supply_request.created_at, format: :long) %></strong> por <%= @supply_request.user.email %></p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to "Volver atrás", supply_requests_path, class: "btn btn-outline-secondary btn-sm shadow-sm" %>
      <% if policy(@supply_request).edit? && @supply_request.status != 'delivered' %>
        <%= link_to "Modificar", edit_supply_request_path(@supply_request), class: "btn btn-outline-primary btn-sm shadow-sm" %>
      <% end %>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-md-8">
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
          <h5 class="mb-0 fw-bold">Repuestos Requeridos (<%= @supply_request.supply_request_lines.count %>)</h5>
        </div>
        <div class="card-body p-0 mt-3">
          <ul class="list-group list-group-flush">
            <% @supply_request.supply_request_lines.each do |line| %>
              <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                <div>
                  <h6 class="mb-0 fw-bold"><%= line.part.name %></h6>
                  <small class="text-muted">SKU: <%= line.part.sku %></small>
                </div>
                <span class="badge bg-primary rounded-pill px-3 py-2 fs-6 shadow-sm">
                  <%= number_with_precision(line.quantity, precision: 2, strip_insignificant_zeros: true) %> <%= line.part.unit_of_measure %>
                </span>
              </li>
            <% end %>
          </ul>
        </div>
      </div>

      <% if @supply_request.admin_notes.present? %>
        <div class="card shadow-sm border-0 border-start border-4 border-warning bg-light">
          <div class="card-body">
            <h6 class="fw-bold text-warning-emphasis"><i class="bi bi-chat-square-text me-2"></i>Notas / Observaciones</h6>
            <p class="mb-0 text-muted"><%= simple_format(@supply_request.admin_notes) %></p>
          </div>
        </div>
      <% end %>
    </div>

    <div class="col-md-4">
      <div class="card shadow-sm border-0 mb-4 bg-primary text-white">
        <div class="card-body text-center py-4">
          <i class="bi bi-truck display-5 opacity-75 mb-2 d-block"></i>
          <h4 class="fw-bold mb-0 text-white"><%= @supply_request.vehicle.plate %></h4>
          <span class="opacity-75">Vehículo Objetivo</span>
        </div>
      </div>

      <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-1">
          <h5 class="fw-bold mb-0 text-center"><i class="bi bi-signpost-split me-2 text-primary"></i> Workflow</h5>
        </div>
        <div class="card-body">
          <ul class="list-group list-group-flush">
            <% 
               states = { requested: 1, received: 2, purchasing: 3, delivered: 4 } 
               current_idx = states[@supply_request.status.to_sym]
            %>
            <% SupplyRequest.statuses.keys.each do |state| %>
              <li class="list-group-item border-0 px-0 py-2 d-flex align-items-center">
                <% if states[state.to_sym] < current_idx %>
                  <i class="bi bi-check-circle-fill text-success fs-4 me-3"></i>
                  <span class="text-muted text-decoration-line-through"><%= SupplyRequest.human_status(state) %></span>
                <% elsif states[state.to_sym] == current_idx %>
                  <i class="bi bi-circle-fill text-primary fs-5 me-3 ms-1"></i>
                  <span class="fw-bold fs-5"><%= SupplyRequest.human_status(state) %></span>
                <% else %>
                  <i class="bi bi-circle text-muted fs-5 me-3 ms-1"></i>
                  <span class="text-muted"><%= SupplyRequest.human_status(state) %></span>
                <% end %>
              </li>
            <% end %>
          </ul>

          <% if policy(@supply_request).change_status? && @supply_request.status != 'delivered' %>
            <div class="mt-4 pt-3 border-top text-center">
              <label class="form-label small text-muted text-uppercase fw-bold">Acción de Administrador</label>
              <% next_state = SupplyRequest.statuses.keys[current_idx] %>
              <%= button_to change_status_supply_request_path(@supply_request, status: next_state), 
                    method: :patch, 
                    class: "btn btn-#{next_state == 'delivered' ? 'success' : 'primary'} w-100 shadow-sm",
                    form_class: "d-block",
                    data: { turbo_confirm: next_state == 'delivered' ? "¿Confirma entregar los repuestos? Esto descontará del inventario permanentemente." : "Avanzar al estado #{SupplyRequest.human_status(next_state)}" } do %>
                Avanzar a <%= SupplyRequest.human_status(next_state) %> <i class="bi bi-arrow-right ms-1"></i>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
