<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0"><i class="bi bi-pencil-square me-2"></i>Editar solicitud #<%= @supply_request.id %></h1>
      <p class="text-muted mb-0">Ajusta el vehículo, las notas o los repuestos pedidos.</p>
    </div>
    <%= link_to supply_request_path(@supply_request), class: "btn btn-outline-secondary text-nowrap" do %>
      <i class="bi bi-eye me-1"></i>Ver solicitud
    <% end %>
  </div>

  <% provide(:submit_text, "Guardar cambios") %>
  <%= render "form", supply_request: @supply_request %>
</div>
