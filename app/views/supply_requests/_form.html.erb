<%= form_with(model: supply_request, local: true, id: "supply-request-form") do |f| %>
  <%= render "shared/form_errors", object: supply_request, subject: "la solicitud" %>

  <div class="row g-4">
    <div class="col-lg-5">
      <div class="card h-100">
        <div class="card-header bg-white">
          <%= inventory_card_title("Datos generales", icon: "bi-truck") %>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <%= f.label :vehicle_id, class: "form-label" do %>Vehículo <span class="text-danger">*</span><% end %>
            <% vehicle_error = supply_request.errors.include?(:vehicle) || supply_request.errors.include?(:vehicle_id) %>
            <%= f.collection_select :vehicle_id, @vehicles, :id, :plate, { prompt: "Selecciona un vehículo" }, { class: ["form-select", ("is-invalid" if vehicle_error)], required: true, onchange: "updateAvailableParts(this.value)" } %>
            <% if vehicle_error %>
              <div class="invalid-feedback d-block">Selecciona el vehículo para el que pides los repuestos.</div>
            <% end %>
          </div>

          <div>
            <%= f.label :admin_notes, "Notas para bodega (opcional)", class: "form-label" %>
            <%= f.text_area :admin_notes, class: "form-control", rows: 4, placeholder: "Ej.: urgente, el vehículo está detenido en el taller." %>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-7">
      <div class="card h-100">
        <div class="card-header bg-white">
          <%= inventory_card_title("Repuestos solicitados", icon: "bi-tools") %>
        </div>
        <div class="card-body">
          <div class="row g-2 d-none d-md-flex mb-2" aria-hidden="true">
            <div class="col-md-7 form-label mb-0">Repuesto <span class="text-danger">*</span></div>
            <div class="col-md-4 form-label mb-0">Cantidad <span class="text-danger">*</span></div>
          </div>
          <div id="request-lines-container">
            <%= f.fields_for :supply_request_lines do |line_form| %>
              <% line = line_form.object %>
              <% part_error = line.errors.include?(:part) || line.errors.include?(:part_id) %>
              <% quantity_error = line.errors.include?(:quantity) %>
              <div class="request-line pb-3 mb-3 border-bottom">
                <div class="row g-2 align-items-start">
                  <div class="col-12 col-md-7">
                    <%= line_form.label :part_id, class: "form-label d-md-none" do %>Repuesto <span class="text-danger">*</span><% end %>
                    <%= line_form.collection_select :part_id, Part.all, :id, :name, { prompt: "Selecciona un repuesto" }, { class: ["form-select part-selector", ("is-invalid" if part_error)], required: true, "aria-label": "Repuesto", "data-fitments" => PartFitment.all.to_json(only: [:part_id, :vehicle_id]) } %>
                    <% if part_error %>
                      <div class="invalid-feedback d-block">Elige el repuesto que necesitas.</div>
                    <% end %>
                  </div>
                  <div class="col col-md-4">
                    <%= line_form.label :quantity, class: "form-label d-md-none" do %>Cantidad <span class="text-danger">*</span><% end %>
                    <%= line_form.number_field :quantity, value: decimal_field_value(line.quantity), step: :any, class: ["form-control", ("is-invalid" if quantity_error)], placeholder: "Cantidad", "aria-label": "Cantidad", required: true %>
                    <% if quantity_error %>
                      <div class="invalid-feedback d-block">Ingresa una cantidad mayor que 0.</div>
                    <% end %>
                  </div>
                  <div class="col-auto col-md-1 text-end pt-1">
                    <span class="form-label d-block d-md-none invisible" aria-hidden="true">Quitar</span>
                    <% if line.persisted? %>
                      <%= line_form.hidden_field :_destroy, class: "destroy-input" %>
                    <% end %>
                    <button type="button" class="btn btn-outline-danger btn-sm border-0" onclick="removeRequestLine(this)" title="Quitar repuesto" aria-label="Quitar repuesto">
                      <i class="bi bi-trash3"></i>
                    </button>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
          <button type="button" class="btn btn-sm btn-outline-primary" onclick="addRequestLine()">
            <i class="bi bi-plus-lg me-1"></i>Agregar repuesto
          </button>
          <p class="form-text d-flex gap-2 mt-3 mb-0">
            <i class="bi bi-info-circle flex-shrink-0"></i>
            <span>Solo aparecen los repuestos compatibles con el vehículo elegido.</span>
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="d-flex justify-content-end gap-2 mt-4">
    <%= link_to "Cancelar", supply_request.persisted? ? supply_request_path(supply_request) : supply_requests_path, class: "btn btn-outline-secondary" %>
    <%= f.submit yield(:submit_text), class: "btn btn-primary" %>
  </div>
<% end %>

<template id="line-template">
  <div class="request-line pb-3 mb-3 border-bottom">
    <div class="row g-2 align-items-start">
      <div class="col-12 col-md-7">
        <label class="form-label d-md-none" aria-hidden="true">Repuesto <span class="text-danger">*</span></label>
        <select name="supply_request[supply_request_lines_attributes][NEW_RECORD][part_id]" class="form-select part-selector" aria-label="Repuesto" required>
          <option value="">Selecciona un repuesto</option>
          <% Part.all.each do |p| %>
            <option value="<%= p.id %>"><%= p.name %></option>
          <% end %>
        </select>
      </div>
      <div class="col col-md-4">
        <label class="form-label d-md-none" aria-hidden="true">Cantidad <span class="text-danger">*</span></label>
        <input type="number" name="supply_request[supply_request_lines_attributes][NEW_RECORD][quantity]" step="any" class="form-control" placeholder="Cantidad" aria-label="Cantidad" required>
      </div>
      <div class="col-auto col-md-1 text-end pt-1">
        <span class="form-label d-block d-md-none invisible" aria-hidden="true">Quitar</span>
        <button type="button" class="btn btn-outline-danger btn-sm border-0" onclick="removeRequestLine(this)" title="Quitar repuesto" aria-label="Quitar repuesto">
          <i class="bi bi-trash3"></i>
        </button>
      </div>
    </div>
  </div>
</template>

<script>
  // En un bloque propio: Turbo vuelve a ejecutar este script al mostrar el formulario
  // con errores, y las constantes globales no se pueden declarar dos veces.
  (function() {
    const fitments = <%= raw PartFitment.all.to_json(only: [:part_id, :vehicle_id]) %>;
    const allParts = <%= raw Part.all.map { |p| { id: p.id, name: p.name } }.to_json %>;

    window.addRequestLine = function() {
      const time = new Date().getTime();
      const template = document.getElementById('line-template').innerHTML.replace(/NEW_RECORD/g, time);
      const container = document.getElementById('request-lines-container');
      container.insertAdjacentHTML('beforeend', template);

      const vehicleId = document.getElementById('supply_request_vehicle_id').value;
      if(vehicleId) { updateAvailableParts(vehicleId); }
    }

    window.removeRequestLine = function(btn) {
      const line = btn.closest('.request-line');
      const destroyInput = line.querySelector('.destroy-input');
      if(destroyInput) {
        destroyInput.value = '1';
        line.style.display = 'none';
      } else {
        line.remove();
      }
    }

    window.updateAvailableParts = function(vehicleId) {
      const vehicleIdInt = parseInt(vehicleId);
      const allowedPartIds = fitments.filter(f => f.vehicle_id === vehicleIdInt).map(f => f.part_id);
      const selectors = document.querySelectorAll('.part-selector');

      selectors.forEach(select => {
        const currentValue = select.value;
        select.innerHTML = '';

        if (allowedPartIds.length === 0 && vehicleIdInt) {
          select.innerHTML = '<option value="">Este vehículo no tiene repuestos compatibles</option>';
        } else {
          select.innerHTML = '<option value="">Selecciona un repuesto</option>';
          allParts.forEach(part => {
            if (allowedPartIds.includes(part.id)) {
              const opt = document.createElement('option');
              opt.value = part.id;
              opt.text = part.name;
              if (currentValue == part.id) opt.selected = true;
              select.appendChild(opt);
            }
          });
        }
      });
    }
  })();

  document.addEventListener("turbo:load", () => {
    const select = document.getElementById('supply_request_vehicle_id');
    if (select && select.value) { updateAvailableParts(select.value); }
  });
</script>
