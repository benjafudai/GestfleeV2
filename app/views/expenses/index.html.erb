<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3"><i class="bi bi-wallet2 me-2"></i> Control de Costos</h1>
    <% if policy(Expense).create? %>
      <%= link_to new_expense_path, class: "btn btn-primary shadow-sm" do %>
        <i class="bi bi-plus-lg me-1"></i> Registrar Gasto
      <% end %>
    <% end %>
  </div>

  <div class="row mb-4">
    <div class="col-md-4">
      <div class="card bg-primary text-white shadow-sm border-0 h-100">
        <div class="card-body">
          <h6 class="text-uppercase fw-semibold mb-1 opacity-75" style="letter-spacing: 0.5px; font-size: 0.8rem;">Gasto Total (Unificado)</h6>
          <%
            clp_sum = @expenses.where(currency: 'CLP').sum(:amount)
            usd_sum = @expenses.where(currency: 'USD').sum(:amount)
            total_clp = clp_sum + converted_to_clp(usd_sum, 'USD')
            total_usd = usd_sum + converted_to_usd(clp_sum, 'CLP')
          %>
          <div class="d-flex justify-content-between align-items-center">
            <h3 class="fw-bold mb-0" id="total_display_clp"><%= format_money(total_clp, 'CLP') %></h3>
            <h3 class="fw-bold mb-0 d-none" id="total_display_usd"><%= format_money(total_usd, 'USD') %></h3>
            
            <select class="form-select form-select-sm bg-transparent text-white border-light mt-1 ms-3" style="width: 80px;" onchange="document.getElementById('total_display_clp').classList.toggle('d-none'); document.getElementById('total_display_usd').classList.toggle('d-none');">
              <option value="CLP" class="text-dark">CLP</option>
              <option value="USD" class="text-dark">USD</option>
            </select>
          </div>
          <div class="mt-3 py-2 px-3 bg-dark bg-opacity-25 rounded border border-light border-opacity-25 d-flex justify-content-between align-items-center">
            <span class="small text-white opacity-75"><i class="bi bi-graph-up-arrow me-1"></i> Tasa Mercado:</span>
            <span class="text-warning fw-bold"><%= format_money(CurrencyConverter.usd_to_clp, 'CLP') %> / USD</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>ID</th>
              <th>Fecha</th>
              <th>Categoría</th>
              <th>Vehículo</th>
              <th>Proveedor</th>
              <th class="text-end">Monto</th>
              <th class="text-center">Reserva</th>
              <th class="text-end" style="min-width: 150px;">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% if @expenses.any? %>
              <% @expenses.each do |expense| %>
                <tr class="<%= expense.restricted_access ? 'table-warning' : '' %>">
                  <td class="fw-medium text-muted">#<%= expense.id %></td>
                  <td><%= expense.date.strftime("%d/%m/%Y") %></td>
                  <td>
                    <% case expense.category %>
                    <% when 'maintenance' %>
                      <span class="badge bg-info text-dark rounded-pill px-3"><i class="bi bi-tools me-1"></i> Mantenimiento</span>
                    <% when 'fuel' %>
                      <span class="badge bg-warning text-dark rounded-pill px-3"><i class="bi bi-fuel-pump me-1"></i> Combustible</span>
                    <% when 'parts' %>
                      <span class="badge bg-secondary rounded-pill px-3"><i class="bi bi-gear me-1"></i> Repuestos</span>
                    <% when 'tolls' %>
                      <span class="badge bg-dark rounded-pill px-3"><i class="bi bi-signpost-2 me-1"></i> Peajes</span>
                    <% when 'insurance' %>
                      <span class="badge bg-primary rounded-pill px-3"><i class="bi bi-shield-check me-1"></i> Seguros</span>
                    <% else %>
                      <span class="badge bg-light text-dark border rounded-pill px-3">Otros</span>
                    <% end %>
                  </td>
                  <td>
                    <% if expense.vehicle %>
                      <span class="fw-medium"><%= expense.vehicle.plate %></span>
                    <% else %>
                      <span class="text-muted fst-italic">Gasto General</span>
                    <% end %>
                  </td>
                  <td><%= expense.provider.presence || "-" %></td>
                  <td class="text-end fw-bold">
                    <%= format_money(expense.amount, expense.currency) %>
                    <% if expense.currency == 'USD' %>
                      <div class="small fw-normal text-muted mt-1"><%= format_money(converted_to_clp(expense.amount, 'USD'), 'CLP') %></div>
                    <% end %>
                  </td>
                  <td class="text-center">
                    <% if expense.restricted_access %>
                      <i class="bi bi-lock-fill text-danger" title="Acceso restringido (Sólo Admin)"></i>
                    <% else %>
                      <i class="bi bi-unlock text-success" title="Público"></i>
                    <% end %>
                  </td>
                  <td class="text-end">
                    <%= link_to expense, class: "btn btn-sm btn-outline-primary shadow-sm me-1", title: "Ver detalles" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <% if policy(expense).edit? %>
                      <%= link_to edit_expense_path(expense), class: "btn btn-sm btn-outline-secondary shadow-sm", title: "Editar" do %>
                        <i class="bi bi-pencil"></i>
                      <% end %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="8" class="text-center py-5 text-muted">
                  <i class="bi bi-receipt display-4 d-block mb-3 opacity-50"></i>
                  No hay gastos registrados en el sistema.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
