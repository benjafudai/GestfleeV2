<%
  can_create = policy(Expense).create?
  clp_sum = @expenses_scope.where(currency: 'CLP').sum(:amount)
  usd_sum = @expenses_scope.where(currency: 'USD').sum(:amount)
  total_clp = clp_sum + converted_to_clp(usd_sum, 'USD')
  total_usd = usd_sum + converted_to_usd(clp_sum, 'CLP')
  category_totals = expense_totals_by_category(@expenses_scope)
  records_count = @pagy.respond_to?(:count) ? @pagy.count : @expenses_scope.count
  month_total = expense_total_in_clp(@expenses_scope.where(date: Date.current.all_month))
  month_total_usd = converted_to_usd(month_total, 'CLP')
  average_total = records_count.positive? ? total_clp / records_count : 0
  average_total_usd = records_count.positive? ? total_usd / records_count : 0
%>
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0"><i class="bi bi-wallet2 me-2"></i>Control de costos</h1>
      <p class="text-muted mb-0">Gastos de la flota por categoría, vehículo y proveedor.</p>
    </div>
    <% if can_create %>
      <%= link_to new_expense_path, class: "btn btn-primary text-nowrap" do %>
        <i class="bi bi-plus-lg me-1"></i>Registrar gasto
      <% end %>
    <% end %>
  </div>

  <div class="row g-3 mb-4">
    <div class="<%= category_totals.any? ? 'col-lg-4' : 'col-md-6 col-lg-4' %>">
      <div class="card bg-primary text-white h-100">
        <div class="card-body d-flex flex-column">
          <div class="d-flex justify-content-between align-items-start gap-3">
            <div class="min-w-0">
              <div class="small text-white opacity-75 fw-semibold">Gasto total</div>
              <div class="h3 fw-bold mb-0 mt-1 text-nowrap" data-currency="CLP"><%= format_money(total_clp, 'CLP') %></div>
              <div class="h3 fw-bold mb-0 mt-1 text-nowrap d-none" data-currency="USD"><%= format_money(total_usd, 'USD') %></div>
            </div>
            <select class="form-select form-select-sm bg-transparent text-white border-light flex-shrink-0" style="width: 84px;"
                    aria-label="Moneda del gasto total"
                    onchange="this.closest('.card').querySelectorAll('[data-currency]').forEach((el) => el.classList.toggle('d-none', el.dataset.currency !== this.value));">
              <option value="CLP" class="text-dark">CLP</option>
              <option value="USD" class="text-dark">USD</option>
            </select>
          </div>
          <p class="small text-white opacity-75 mb-0 mt-1">
            <%= records_count == 1 ? "1 gasto registrado" : "#{number_with_delimiter(records_count)} gastos registrados" %> · montos en USD convertidos
          </p>
          <div class="row g-0 mt-3 pt-3 border-top border-light border-opacity-25">
            <div class="col-6 pe-2">
              <div class="small text-white opacity-75">Gasto en <%= l(Date.current, format: "%B") %></div>
              <div class="fw-bold fs-5 text-nowrap" data-currency="CLP"><%= format_money(month_total, 'CLP') %></div>
              <div class="fw-bold fs-5 text-nowrap d-none" data-currency="USD"><%= format_money(month_total_usd, 'USD') %></div>
            </div>
            <div class="col-6 ps-3 border-start border-light border-opacity-25">
              <div class="small text-white opacity-75">Promedio por gasto</div>
              <div class="fw-bold fs-5 text-nowrap" data-currency="CLP"><%= format_money(average_total, 'CLP') %></div>
              <div class="fw-bold fs-5 text-nowrap d-none" data-currency="USD"><%= format_money(average_total_usd, 'USD') %></div>
            </div>
          </div>
          <div class="mt-auto pt-3">
            <div class="py-2 px-3 bg-dark bg-opacity-25 rounded-3 d-flex justify-content-between align-items-center gap-2">
              <span class="small text-white opacity-75 text-nowrap"><i class="bi bi-graph-up-arrow me-1"></i>Tasa de mercado</span>
              <span class="fw-bold text-white text-nowrap"><%= format_money(CurrencyConverter.usd_to_clp, 'CLP') %> / USD</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <% if category_totals.any? %>
      <div class="col-lg-8">
        <div class="card h-100">
          <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 class="h6 mb-0">Gasto por categoría</h2>
            <span class="small text-muted fw-normal">En CLP, sobre todos los gastos</span>
          </div>
          <div class="card-body">
            <div class="row g-3">
              <% category_totals.each do |category, amount| %>
                <% share = total_clp.positive? ? (amount.to_f / total_clp.to_f * 100) : 0.0 %>
                <div class="col-sm-6">
                  <div class="d-flex align-items-center gap-3">
                    <%= expense_category_icon_circle(category, style: "width: 38px; height: 38px; font-size: 1rem;") %>
                    <div class="flex-grow-1 min-w-0">
                      <div class="d-flex justify-content-between align-items-baseline gap-2">
                        <span class="fw-semibold text-truncate"><%= expense_category_label(category) %></span>
                        <span class="fw-bold text-nowrap"><%= format_money(amount, 'CLP') %></span>
                      </div>
                      <div class="d-flex align-items-center gap-2 mt-1">
                        <div class="progress flex-grow-1" style="height: 6px;" role="progressbar"
                             aria-label="<%= expense_category_label(category) %>" aria-valuenow="<%= share.round %>" aria-valuemin="0" aria-valuemax="100">
                          <div class="progress-bar <%= expense_category_bar_class(category) %>" style="width: <%= share.round(1) %>%"></div>
                        </div>
                        <span class="small text-muted text-end" style="min-width: 3.2rem;"><%= expense_percent(share) %></span>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="card">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
      <h2 class="h6 mb-0">Gastos registrados</h2>
      <% if @expenses.any? %>
        <span class="small text-muted fw-normal">Del más reciente al más antiguo</span>
      <% end %>
    </div>
    <% if @expenses.any? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="d-none d-md-table-cell">ID</th>
              <th class="d-none d-md-table-cell">Fecha</th>
              <th>Categoría</th>
              <th class="d-none d-md-table-cell">Vehículo</th>
              <th class="d-none d-lg-table-cell">Proveedor</th>
              <th class="text-end">Monto</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% @expenses.each do |expense| %>
              <tr class="<%= 'table-warning' if expense.restricted_access %>">
                <td class="d-none d-md-table-cell text-muted">#<%= expense.id %></td>
                <td class="d-none d-md-table-cell text-nowrap"><%= l(expense.date) %></td>
                <td>
                  <span class="d-inline-flex align-items-center gap-2">
                    <%= expense_category_badge(expense.category) %>
                    <% if expense.restricted_access %>
                      <i class="bi bi-lock-fill text-danger" title="Restringido: solo administradores" aria-label="Restringido: solo administradores"></i>
                    <% end %>
                  </span>
                  <div class="small text-muted mt-1 d-md-none">
                    <%= l(expense.date) %> · <%= expense.vehicle ? expense.vehicle.plate : "Gasto general" %>
                  </div>
                </td>
                <td class="d-none d-md-table-cell">
                  <% if expense.vehicle %>
                    <span class="fw-semibold"><%= expense.vehicle.plate %></span>
                  <% else %>
                    <span class="text-muted fst-italic">Gasto general</span>
                  <% end %>
                </td>
                <td class="d-none d-lg-table-cell">
                  <% if expense.provider.present? %>
                    <%= expense.provider %>
                  <% else %>
                    <span class="text-muted">—</span>
                  <% end %>
                </td>
                <td class="text-end text-nowrap">
                  <span class="fw-bold"><%= format_money(expense.amount, expense.currency) %></span>
                  <% if expense.currency == 'USD' %>
                    <div class="small text-muted"><%= format_money(converted_to_clp(expense.amount, 'USD'), 'CLP') %></div>
                  <% end %>
                </td>
                <td class="text-end">
                  <div class="gf-row-actions">
                    <%= link_to expense, class: "btn btn-sm btn-outline-primary", title: "Ver", "aria-label": "Ver" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <% if policy(expense).edit? %>
                      <%= link_to edit_expense_path(expense), class: "btn btn-sm btn-outline-secondary", title: "Editar", "aria-label": "Editar" do %>
                        <i class="bi bi-pencil"></i>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5 px-3 text-muted">
        <i class="bi bi-receipt d-block opacity-50"></i>
        <p class="mb-1 fw-bold text-body">No hay gastos registrados</p>
        <p class="small mb-0">
          <% if can_create %>
            Usa “Registrar gasto” para anotar mantenciones, repuestos, peajes o seguros. Las cargas de combustible se suman solas.
          <% else %>
            Cuando se registren gastos de la flota, aparecerán aquí.
          <% end %>
        </p>
      </div>
    <% end %>
  </div>
  <%= render "shared/pagination", pagy: @pagy %>
</div>
