<div class="container mt-4">
  <div class="row mb-4 align-items-center">
    <div class="col">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
          <li class="breadcrumb-item"><%= link_to "Costos", expenses_path, class: "text-decoration-none" %></li>
          <li class="breadcrumb-item active" aria-current="page">Gasto #<%= @expense.id %></li>
        </ol>
      </nav>
      <div class="d-flex align-items-center gap-3">
        <h1 class="h3 mb-0"><i class="bi bi-receipt me-2"></i> Detalle del Gasto #<%= @expense.id %></h1>
        <% if @expense.restricted_access %>
          <span class="badge border border-danger text-danger px-2 py-1"><i class="bi bi-lock-fill me-1"></i> Restringido</span>
        <% end %>
      </div>
    </div>
    <div class="col-auto d-flex gap-2">
      <%= link_to expenses_path, class: "btn btn-outline-secondary shadow-sm" do %>
        <i class="bi bi-arrow-left me-1"></i> Volver
      <% end %>
      
      <% if policy(@expense).edit? %>
        <%= link_to edit_expense_path(@expense), class: "btn btn-primary shadow-sm" do %>
          <i class="bi bi-pencil me-1"></i> Editar
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="row">
    <!-- Información Principal -->
    <div class="col-md-7">
      <div class="card shadow-sm border-0 mb-4 h-100">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
          <h5 class="fw-bold mb-0">Información del Registro</h5>
        </div>
        <div class="card-body">
          <div class="row bg-light rounded p-3 mb-4 text-center">
            <div class="col-6 border-end">
              <span class="d-block text-muted small text-uppercase fw-semibold mb-1">Monto Total</span>
              <span class="fs-3 fw-bold text-primary mb-0"><%= format_money(@expense.amount, @expense.currency) %></span>
              <% if @expense.currency == 'USD' %>
                <div class="small fw-normal text-muted mt-1"><%= format_money(converted_to_clp(@expense.amount, 'USD'), 'CLP') %></div>
              <% end %>
            </div>
            <div class="col-6">
              <span class="d-block text-muted small text-uppercase fw-semibold mb-1">Fecha</span>
              <span class="fs-4 fw-medium"><%= l(@expense.date, format: :long) %></span>
            </div>
          </div>

          <dl class="row mb-0 mt-2">
            <dt class="col-sm-4 text-muted fw-normal mb-2">Categoría</dt>
            <dd class="col-sm-8 mb-2 fw-medium"><%= expense_category_label(@expense.category) %></dd>

            <dt class="col-sm-4 text-muted fw-normal mb-2">Vehículo</dt>
            <dd class="col-sm-8 mb-2">
              <% if @expense.vehicle %>
                <%= link_to @expense.vehicle.plate, @expense.vehicle, class: "text-decoration-none fw-medium" %>
                <span class="text-muted small ms-1">(<%= @expense.vehicle.brand %>)</span>
              <% else %>
                <span class="text-muted fst-italic">Gasto General / Corporativo</span>
              <% end %>
            </dd>

            <dt class="col-sm-4 text-muted fw-normal mb-2">Proveedor</dt>
            <dd class="col-sm-8 mb-2"><%= @expense.provider.presence || "-" %></dd>

            <dt class="col-sm-12 text-muted fw-normal mt-3">Descripción</dt>
            <dd class="col-sm-12 mt-1 p-3 border rounded text-break bg-light">
              <%= @expense.description.presence || "Sin observaciones." %>
            </dd>
          </dl>
        </div>
      </div>
    </div>

    <!-- Facturas y Archivos -->
    <div class="col-md-5">
      <div class="card shadow-sm border-0 mb-4 h-100">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0">Comprobantes y Facturas</h5>
          <span class="badge bg-secondary rounded-pill"><%= @expense.documents.count %></span>
        </div>
        <div class="card-body">
          <% if @expense.documents.attached? %>
            <div class="row g-3">
              <% @expense.documents.each do |document| %>
                <div class="col-12">
                  <div class="card bg-light border">
                    <div class="card-body p-3 d-flex align-items-center justify-content-between">
                      <div class="d-flex align-items-center overflow-hidden">
                        <% if document.image? %>
                          <i class="bi bi-image fs-3 text-primary me-3 flex-shrink-0"></i>
                        <% elsif document.content_type == "application/pdf" %>
                          <i class="bi bi-file-earmark-pdf fs-3 text-danger me-3 flex-shrink-0"></i>
                        <% else %>
                          <i class="bi bi-file-earmark-text fs-3 text-secondary me-3 flex-shrink-0"></i>
                        <% end %>
                        <div class="text-truncate">
                          <div class="fw-medium text-truncate" title="<%= document.filename %>"><%= document.filename %></div>
                          <div class="small text-muted"><%= number_to_human_size(document.byte_size) %></div>
                        </div>
                      </div>
                      <div class="ms-2 flex-shrink-0">
                        <%= link_to rails_blob_path(document, disposition: "preview"), target: "_blank", class: "btn btn-sm btn-outline-primary" do %>
                          <i class="bi bi-box-arrow-up-right"></i> Ver
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-5 rounded bg-light mt-2">
              <i class="bi bi-folder-x display-4 text-muted opacity-50 d-block mb-3"></i>
              <p class="text-muted mb-0">No se han adjuntado comprobantes.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
