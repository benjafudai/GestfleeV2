<%
  expense = @expense
  vehicle = expense.vehicle
  category_style = expense_category_style(expense.category)
  can_edit = policy(expense).edit?
  fuel_source = expense.source if expense.source_type == "FuelFill"
  documents = expense.documents.attachments
%>
<div class="container mt-4" style="max-width: 1080px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0">
        <i class="bi bi-receipt me-2"></i>Gasto #<%= expense.id %>
        <% if expense.restricted_access %>
          <span class="badge text-bg-danger align-middle ms-1 fs-6 fw-semibold"><i class="bi bi-lock-fill me-1"></i>Restringido</span>
        <% end %>
      </h1>
      <p class="text-muted mb-0">
        <%= expense_category_label(expense.category) %> · <%= l(expense.date, format: :long) %>
      </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <% if can_edit %>
        <%= link_to edit_expense_path(expense), class: "btn btn-primary text-nowrap" do %>
          <i class="bi bi-pencil me-1"></i>Editar
        <% end %>
      <% end %>
      <%= link_to expenses_path, class: "btn btn-outline-secondary text-nowrap" do %>
        <i class="bi bi-arrow-left me-1"></i>Volver
      <% end %>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
      <div class="card h-100">
        <div class="card-body d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-2 gap-sm-3">
          <%= expense_icon_circle("bi-cash-stack", "success") %>
          <div class="min-w-0">
            <div class="small text-muted">Monto total</div>
            <div class="h4 mb-0 text-nowrap"><%= format_money(expense.amount, expense.currency) %></div>
            <% if expense.currency == 'USD' %>
              <div class="small text-muted text-nowrap">≈ <%= format_money(converted_to_clp(expense.amount, 'USD'), 'CLP') %></div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card h-100">
        <div class="card-body d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-2 gap-sm-3">
          <%= expense_icon_circle("bi-calendar-event", "primary") %>
          <div class="min-w-0">
            <div class="small text-muted">Fecha</div>
            <div class="h4 mb-0 text-nowrap"><%= l(expense.date) %></div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card h-100">
        <div class="card-body d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-2 gap-sm-3">
          <%= expense_category_icon_circle(expense.category) %>
          <div class="min-w-0">
            <div class="small text-muted">Categoría</div>
            <div class="h4 mb-0 text-truncate"><%= expense_category_label(expense.category) %></div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card h-100">
        <div class="card-body d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-2 gap-sm-3">
          <%= expense_icon_circle("bi-truck-front", "info") %>
          <div class="min-w-0">
            <div class="small text-muted">Vehículo</div>
            <% if vehicle %>
              <div class="h4 mb-0 text-nowrap">
                <% if policy(vehicle).show? %>
                  <%= link_to vehicle.plate, vehicle, class: "text-reset" %>
                <% else %>
                  <%= vehicle.plate %>
                <% end %>
              </div>
              <div class="small text-muted text-truncate"><%= [vehicle.brand, vehicle.model].compact_blank.join(" ") %></div>
            <% else %>
              <div class="h4 mb-0 text-nowrap">General</div>
              <div class="small text-muted">Sin vehículo asociado</div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-7">
      <div class="card h-100">
        <div class="card-header bg-white">
          <h2 class="h6 mb-0">Información del gasto</h2>
        </div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-sm-4 text-muted fw-normal">Proveedor</dt>
            <dd class="col-sm-8 mb-3">
              <% if expense.provider.present? %>
                <span class="fw-semibold"><%= expense.provider %></span>
              <% else %>
                <span class="text-muted">Sin proveedor</span>
              <% end %>
            </dd>

            <% if fuel_source %>
              <dt class="col-sm-4 text-muted fw-normal">Origen</dt>
              <dd class="col-sm-8 mb-3">
                <i class="bi bi-fuel-pump text-muted me-1"></i>
                <% if policy(fuel_source).show? %>
                  <%= link_to "Carga de combustible ##{fuel_source.id}", fuel_fill_path(fuel_source) %>
                <% else %>
                  Carga de combustible #<%= fuel_source.id %>
                <% end %>
                <div class="small text-muted">Este gasto se registró automáticamente con la carga.</div>
              </dd>
            <% end %>

            <% if can_edit %>
              <dt class="col-sm-4 text-muted fw-normal">Visibilidad</dt>
              <dd class="col-sm-8 mb-3">
                <% if expense.restricted_access %>
                  <span class="text-danger-emphasis"><i class="bi bi-lock-fill me-1"></i>Solo administradores</span>
                <% else %>
                  <span><i class="bi bi-people text-muted me-1"></i>Administradores y analistas</span>
                <% end %>
              </dd>
            <% end %>

            <dt class="col-sm-4 text-muted fw-normal">Descripción</dt>
            <dd class="col-sm-8 mb-0">
              <% if expense.description.present? %>
                <div class="p-3 rounded-3 bg-body-tertiary text-break" style="white-space: pre-line;"><%= expense.description %></div>
              <% else %>
                <span class="text-muted">Sin observaciones.</span>
              <% end %>
            </dd>
          </dl>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="card h-100">
        <div class="card-header bg-white d-flex justify-content-between align-items-center gap-2">
          <h2 class="h6 mb-0">Comprobantes y facturas</h2>
          <span class="badge text-bg-secondary"><%= documents.size %></span>
        </div>
        <% if documents.any? %>
          <ul class="list-group list-group-flush">
            <% documents.each do |document| %>
              <%
                file_icon, file_tone = if document.image?
                  ["bi-image", "primary"]
                elsif document.content_type == "application/pdf"
                  ["bi-file-earmark-pdf", "danger"]
                else
                  ["bi-file-earmark-text", "secondary"]
                end
              %>
              <li class="list-group-item d-flex align-items-center gap-3 py-3">
                <%= expense_icon_circle(file_icon, file_tone, style: "width: 38px; height: 38px; font-size: 1rem;") %>
                <div class="min-w-0 flex-grow-1">
                  <div class="fw-semibold text-truncate" title="<%= document.filename %>"><%= document.filename %></div>
                  <div class="small text-muted"><%= number_to_human_size(document.byte_size) %></div>
                </div>
                <%= link_to rails_blob_path(document, disposition: "preview"), target: "_blank", rel: "noopener", class: "btn btn-sm btn-outline-primary text-nowrap flex-shrink-0" do %>
                  <i class="bi bi-box-arrow-up-right me-1"></i>Ver
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <div class="text-center py-5 px-3 text-muted">
            <i class="bi bi-folder-x d-block opacity-50"></i>
            <p class="mb-1 fw-bold text-body">No hay comprobantes adjuntos</p>
            <p class="small mb-0">
              <% if can_edit %>
                Puedes adjuntar la boleta o factura al editar el gasto.
              <% else %>
                Este gasto no tiene boletas ni facturas adjuntas.
              <% end %>
            </p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
