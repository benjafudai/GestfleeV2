<div class="container mt-4" style="max-width: 1080px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0"><i class="bi bi-pencil-square me-2"></i>Editar gasto #<%= @expense.id %></h1>
      <p class="text-muted mb-0">
        <%= expense_category_label(@expense.category_was || @expense.category) %>
        <% if @expense.date_was %>
          · <%= l(@expense.date_was, format: :long) %>
        <% end %>
      </p>
    </div>
  </div>

  <%= render "form", expense: @expense %>
</div>
