<div class="container mt-4">
  <div class="mb-4">
    <h1 class="h3 fw-bold mb-1"><i class="bi bi-shield-exclamation me-2 text-warning"></i>Tablero de Cumplimiento y Alertas</h1>
    <p class="text-muted mb-0">Revisa los documentos vencidos o próximos a vencer de los vehículos y del personal.</p>
  </div>

  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
      <h6 class="mb-0"><i class="bi bi-truck-front me-1"></i> Alertas de Vehículos</h6>
    </div>
    <% if @vehicle_documents.any? %>
      <ul class="list-group list-group-flush">
        <% @vehicle_documents.each do |doc| %>
          <li class="list-group-item d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
              <p class="fw-medium mb-0">Patente: <%= doc.vehicle.plate %> (<%= doc.vehicle.model %>)</p>
              <p class="text-muted small mb-0"><%= vehicle_doc_type_label(doc.doc_type) %></p>
            </div>
            <div class="d-flex align-items-center gap-3">
              <span class="text-muted small">Vence: <%= l doc.due_on, format: :short %></span>
              <% badge_class = case doc.status
                   when 'ok'       then 'text-bg-success'
                   when 'expiring' then 'text-bg-warning'
                   else 'text-bg-danger'
                   end %>
              <span class="badge <%= badge_class %> rounded-pill"><%= document_status_label(doc.status) %></span>
              <%= link_to "Ver Vehículo", vehicle_path(doc.vehicle), class: "btn btn-sm btn-outline-primary" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="text-center py-4 text-muted">No hay alertas pendientes para vehículos.</div>
    <% end %>
  </div>

  <div class="card shadow-sm">
    <div class="card-header bg-white">
      <h6 class="mb-0"><i class="bi bi-person-badge me-1"></i> Alertas de Personal</h6>
    </div>
    <% if @user_documents.any? %>
      <ul class="list-group list-group-flush">
        <% @user_documents.each do |doc| %>
          <li class="list-group-item d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
              <p class="fw-medium mb-0">Usuario: <%= doc.user.email %> (<%= role_label(doc.user.role) %>)</p>
              <p class="text-muted small mb-0"><%= user_doc_type_label(doc.doc_type) %></p>
            </div>
            <div class="d-flex align-items-center gap-3">
              <span class="text-muted small">Vence: <%= l doc.due_on, format: :short %></span>
              <% badge_class = case doc.status
                   when 'ok'       then 'text-bg-success'
                   when 'expiring' then 'text-bg-warning'
                   else 'text-bg-danger'
                   end %>
              <span class="badge <%= badge_class %> rounded-pill"><%= document_status_label(doc.status) %></span>
              <%= link_to "Ver Perfil", user_path(doc.user), class: "btn btn-sm btn-outline-primary" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="text-center py-4 text-muted">No hay alertas pendientes para el personal.</div>
    <% end %>
  </div>
</div>
