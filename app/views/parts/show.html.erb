<% best = @part.best_quote %>
<% vehicles = @part.vehicles.sort_by(&:plate) %>
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div class="min-w-0">
      <h1 class="h3 mb-0"><i class="bi bi-box-seam me-2"></i><%= @part.name %></h1>
      <p class="text-muted mb-0">SKU <strong class="text-body"><%= @part.sku %></strong> · Unidad de medida: <%= @part.unit_of_measure %></p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <% if policy(@part).edit? %>
        <%= link_to edit_part_path(@part), class: "btn btn-primary" do %>
          <i class="bi bi-pencil me-1"></i>Editar
        <% end %>
      <% end %>
      <%= link_to parts_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-1"></i>Volver
      <% end %>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-4">
      <div class="card h-100">
        <div class="card-body d-flex align-items-center gap-3">
          <% if @part.stock.positive? %>
            <span class="gf-action-icon is-success"><i class="bi bi-box-seam"></i></span>
          <% else %>
            <span class="gf-action-icon is-warning"><i class="bi bi-exclamation-triangle"></i></span>
          <% end %>
          <div class="min-w-0">
            <div class="small text-muted">Stock actual</div>
            <% if @part.stock.positive? %>
              <div class="h4 mb-0"><%= format_quantity(@part.stock) %> <span class="d-block d-sm-inline fs-6 fw-normal text-muted"><%= unit_of_measure_label(@part.stock, @part.unit_of_measure) %></span></div>
            <% else %>
              <div class="h4 mb-0 text-danger">Sin stock</div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-4">
      <div class="card h-100">
        <div class="card-body d-flex align-items-center gap-3">
          <span class="gf-action-icon is-primary"><i class="bi bi-cash-coin"></i></span>
          <div class="min-w-0">
            <div class="small text-muted">Costo<span class="d-none d-sm-inline"> unitario</span></div>
            <div class="h4 mb-0"><%= format_money(@part.cost, @part.currency) %></div>
            <% if @part.currency == "USD" %>
              <div class="small text-muted">≈ <%= format_money(converted_to_clp(@part.cost, "USD"), "CLP") %></div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <div class="col-12 col-lg-4">
      <div class="card h-100">
        <div class="card-body d-flex align-items-center gap-3">
          <span class="gf-action-icon is-warning"><i class="bi bi-tags"></i></span>
          <div class="min-w-0">
            <div class="small text-muted">Mejor precio (últimos 90 días)</div>
            <% if best %>
              <div class="h4 mb-0"><%= format_money(best.price, best.currency) %></div>
              <div class="small text-muted text-truncate"><%= best.supplier %> · <%= l(best.quoted_on) %></div>
            <% else %>
              <div class="h4 mb-0 text-muted">—</div>
              <div class="small text-muted">Sin cotizaciones recientes</div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center gap-2">
      <%= inventory_card_title("Vehículos compatibles", icon: "bi-truck") %>
      <% if vehicles.any? %>
        <span class="badge text-bg-secondary"><%= vehicles.size %></span>
      <% end %>
    </div>
    <div class="card-body">
      <% if vehicles.any? %>
        <div class="d-flex flex-wrap gap-2">
          <% vehicles.each do |vehicle| %>
            <span class="d-inline-flex align-items-center gap-2 border rounded-pill px-3 py-2">
              <i class="bi bi-truck text-primary"></i>
              <span class="fw-bold"><%= vehicle.plate %></span>
              <% model = [vehicle.brand, vehicle.model].compact_blank.join(" ") %>
              <% if model.present? %><span class="small text-muted"><%= model %></span><% end %>
            </span>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-3 px-3 text-muted">
          <i class="bi bi-truck d-block opacity-50"></i>
          <p class="mb-1 fw-bold text-body">Sin vehículos compatibles</p>
          <p class="small mb-0">
            <% if policy(@part).edit? %>
              Asígnalos con el botón «Editar» para que el repuesto aparezca en las solicitudes de esos vehículos.
            <% else %>
              Este repuesto todavía no tiene vehículos asignados.
            <% end %>
          </p>
        </div>
      <% end %>
    </div>
  </div>

  <%= render "quotes", part: @part, best: best %>
</div>
