<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0"><i class="bi bi-box-seam me-2 text-primary"></i> <%= @part.name %></h1>
      <p class="text-muted mb-0 mt-1"><i class="bi bi-upc-scan me-1"></i> SKU: <strong><%= @part.sku %></strong></p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to "Volver al Catálogo", parts_path, class: "btn btn-outline-secondary btn-sm shadow-sm" %>
      <% if policy(@part).edit? %>
        <%= link_to "Editar", edit_part_path(@part), class: "btn btn-outline-primary btn-sm shadow-sm" %>
      <% end %>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-md-5">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
          <h5 class="mb-0 fw-bold">Detalles del Repuesto</h5>
        </div>
        <div class="card-body">
          <ul class="list-group list-group-flush mt-3">
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
              <span class="text-muted"><i class="bi bi-boxes me-2"></i>Stock Actual</span>
              <span class="badge <%= @part.stock > 0 ? 'text-bg-success' : 'text-bg-danger' %> px-3 py-2 rounded-pill fs-6 shadow-sm">
                <%= number_with_precision(@part.stock, precision: 2, strip_insignificant_zeros: true) %> <%= @part.unit_of_measure %>
              </span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
              <h6 class="text-uppercase text-muted fw-bold mb-1" style="font-size: 0.8rem; letter-spacing: 0.5px;">Costo Unitario</h6>
            <div>
              <span class="fw-bold fs-5 text-success"><%= format_money(@part.cost, @part.currency) %></span>
              <% if @part.currency == 'USD' %>
                <div class="small fw-normal text-muted mt-1"><%= format_money(converted_to_clp(@part.cost, 'USD'), 'CLP') %></div>
              <% end %>
            </div>
          </ul>
        </div>
      </div>
    </div>

    <div class="col-md-7">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
          <h5 class="mb-0 fw-bold"><i class="bi bi-truck me-2 text-primary"></i> Vehículos Compatibles</h5>
        </div>
        <div class="card-body">
          <% if @part.vehicles.any? %>
            <div class="row g-3 mt-1">
              <% @part.vehicles.each do |vehicle| %>
                <div class="col-sm-6 col-md-4">
                  <div class="p-3 border rounded text-center bg-light shadow-sm">
                    <i class="bi bi-check-circle-fill text-success mb-2 fs-4 d-block"></i>
                    <span class="fw-bold"><%= vehicle.plate %></span>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="p-5 text-center text-muted bg-light rounded mt-3">
              <i class="bi bi-exclamation-triangle display-6 d-block mb-3 opacity-50"></i>
              Este repuesto no tiene vehículos compatibles asignados.
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%= render "quotes", part: @part %>
</div>
