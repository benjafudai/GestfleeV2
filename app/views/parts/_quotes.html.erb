<% quotes = part.part_quotes.recent_first.limit(20) %>
<% best = part.best_quote %>
<div class="card shadow-sm border-0 mt-4">
  <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h5 class="mb-0 fw-bold"><i class="bi bi-tags me-2 text-primary"></i>Cotizaciones de proveedores</h5>
    <%= link_to part_search_path(q: part.name), class: "btn btn-sm btn-outline-primary" do %>
      <i class="bi bi-search me-1"></i> Buscar en tiendas
    <% end %>
  </div>
  <div class="card-body">
    <% if best %>
      <div class="alert alert-success rounded-3 py-2">
        Mejor precio de los últimos 90 días: <strong><%= format_money(best.price, best.currency) %></strong>
        en <strong><%= best.supplier %></strong> (<%= l(best.quoted_on) %>)
      </div>
    <% end %>

    <% if quotes.any? %>
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Fecha</th>
              <th>Proveedor</th>
              <th>Precio</th>
              <th>Notas</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% quotes.each do |quote| %>
              <tr class="<%= 'table-success' if quote == best %>">
                <td><%= l(quote.quoted_on) %></td>
                <td>
                  <% if quote.url.present? %>
                    <%= link_to quote.supplier, quote.url, target: "_blank", rel: "noopener noreferrer" %>
                  <% else %>
                    <%= quote.supplier %>
                  <% end %>
                </td>
                <td class="fw-bold"><%= format_money(quote.price, quote.currency) %></td>
                <td class="small text-muted"><%= quote.notes %></td>
                <td class="text-end">
                  <% if policy(quote).destroy? %>
                    <%= button_to part_part_quote_path(part, quote), method: :delete, class: "btn btn-sm btn-outline-danger",
                          form: { data: { turbo_confirm: "¿Eliminar esta cotización?" } }, title: "Eliminar" do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-muted mb-0">Todavía no hay cotizaciones para este repuesto.</p>
    <% end %>

    <% new_quote = PartQuote.new(part: part, company_id: part.company_id, quoted_on: Date.current, currency: "CLP") %>
    <% if policy(new_quote).create? %>
      <hr>
      <h6 class="fw-bold mb-3">Registrar cotización</h6>
      <%= form_with model: [part, new_quote], local: true, class: "row g-2 align-items-end" do |f| %>
        <div class="col-md-3">
          <%= f.label :supplier, "Proveedor", class: "form-label small fw-bold" %>
          <%= f.text_field :supplier, class: "form-control", required: true %>
        </div>
        <div class="col-md-2">
          <%= f.label :price, "Precio", class: "form-label small fw-bold" %>
          <%= f.number_field :price, class: "form-control", step: "0.01", min: "0.01", required: true %>
        </div>
        <div class="col-md-1">
          <%= f.label :currency, "Moneda", class: "form-label small fw-bold" %>
          <%= f.select :currency, %w[CLP USD], {}, class: "form-select" %>
        </div>
        <div class="col-md-2">
          <%= f.label :quoted_on, "Fecha", class: "form-label small fw-bold" %>
          <%= f.date_field :quoted_on, class: "form-control", required: true %>
        </div>
        <div class="col-md-2">
          <%= f.label :url, "Enlace (opcional)", class: "form-label small fw-bold" %>
          <%= f.url_field :url, class: "form-control", placeholder: "https://" %>
        </div>
        <div class="col-md-2 d-grid">
          <%= f.submit "Guardar", class: "btn btn-primary" %>
        </div>
        <div class="col-12">
          <%= f.text_field :notes, class: "form-control form-control-sm", placeholder: "Notas (plazo de entrega, marca, etc.)" %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
