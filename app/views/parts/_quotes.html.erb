<% quotes = part.part_quotes.recent_first.limit(20) %>
<% best = local_assigns.fetch(:best) { part.best_quote } %>
<% show_actions = quotes.any? { |quote| policy(quote).destroy? } %>
<% new_quote = PartQuote.new(part: part, company_id: part.company_id, quoted_on: Date.current, currency: "CLP") %>
<% can_quote = policy(new_quote).create? %>
<div class="card">
  <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
    <%= inventory_card_title("Cotizaciones de proveedores", icon: "bi-tags") %>
    <%= link_to part_search_path(q: part.name), class: "btn btn-sm btn-outline-primary" do %>
      <i class="bi bi-shop me-1"></i>Buscar en tiendas
    <% end %>
  </div>

  <% if quotes.any? %>
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Proveedor</th>
            <th class="text-end">Precio</th>
            <th>Fecha</th>
            <th>Notas</th>
            <% if show_actions %>
              <th class="text-end">Acciones</th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% quotes.each do |quote| %>
            <tr>
              <td>
                <% if quote.url.present? %>
                  <%= link_to quote.url, target: "_blank", rel: "noopener noreferrer", class: "fw-bold" do %>
                    <%= quote.supplier %><i class="bi bi-box-arrow-up-right ms-1 small"></i>
                  <% end %>
                <% else %>
                  <span class="fw-bold"><%= quote.supplier %></span>
                <% end %>
                <% if quote == best %>
                  <div><span class="badge text-bg-success mt-1"><i class="bi bi-trophy me-1"></i>Mejor precio</span></div>
                <% end %>
              </td>
              <td class="text-end fw-bold"><%= format_money(quote.price, quote.currency) %></td>
              <td><%= l(quote.quoted_on) %></td>
              <td class="small text-muted"><%= quote.notes.presence || "—" %></td>
              <% if show_actions %>
                <td class="text-end">
                  <% if policy(quote).destroy? %>
                    <div class="gf-row-actions">
                      <%= button_to part_part_quote_path(part, quote), method: :delete, class: "btn btn-sm btn-outline-danger",
                            title: "Eliminar", "aria-label": "Eliminar",
                            form: { data: { turbo_confirm: "¿Eliminar esta cotización?" } } do %>
                        <i class="bi bi-trash"></i>
                      <% end %>
                    </div>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="card-body">
      <div class="text-center py-4 px-3 text-muted">
        <i class="bi bi-tags d-block opacity-50"></i>
        <p class="mb-1 fw-bold text-body">Todavía no hay cotizaciones</p>
        <p class="small mb-0">
          <% if can_quote %>
            Registra abajo el precio que te dé un proveedor para compararlo con otros.
          <% else %>
            Cuando bodega registre precios de proveedores, aparecerán aquí.
          <% end %>
        </p>
      </div>
    </div>
  <% end %>

  <% if can_quote %>
    <div class="card-footer p-4">
      <div class="mb-3"><%= inventory_card_title("Registrar cotización", icon: "bi-plus-lg", tone: "success", tag_name: :h6) %></div>
      <%= form_with model: [part, new_quote], local: true do |f| %>
        <div class="row g-3">
          <div class="col-12 col-lg-4">
            <%= f.label :supplier, class: "form-label" do %>Proveedor <span class="text-danger">*</span><% end %>
            <%= f.text_field :supplier, class: "form-control", placeholder: "Ej.: Repuestos Sur", required: true %>
          </div>
          <div class="col-7 col-sm-4 col-lg-3">
            <%= f.label :price, class: "form-label" do %>Precio <span class="text-danger">*</span><% end %>
            <%= f.number_field :price, class: "form-control", step: "0.01", min: "0.01", required: true %>
          </div>
          <div class="col-5 col-sm-3 col-lg-2">
            <%= f.label :currency, "Moneda", class: "form-label" %>
            <%= f.select :currency, %w[CLP USD], {}, class: "form-select" %>
          </div>
          <div class="col-12 col-sm-5 col-lg-3">
            <%= f.label :quoted_on, class: "form-label" do %>Fecha <span class="text-danger">*</span><% end %>
            <%= f.date_field :quoted_on, class: "form-control", required: true %>
          </div>
          <div class="col-md-6">
            <%= f.label :url, "Enlace (opcional)", class: "form-label" %>
            <%= f.url_field :url, class: "form-control", placeholder: "https://" %>
          </div>
          <div class="col-md-6">
            <%= f.label :notes, "Notas (opcional)", class: "form-label" %>
            <%= f.text_field :notes, class: "form-control", placeholder: "Plazo de entrega, marca, etc." %>
          </div>
        </div>
        <div class="d-flex justify-content-end mt-3">
          <%= f.submit "Guardar cotización", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
