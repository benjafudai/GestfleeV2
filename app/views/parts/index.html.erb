<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3"><i class="bi bi-boxes me-2"></i> Catálogo de Repuestos</h1>
    <% if policy(Part).create? %>
      <%= link_to new_part_path, class: "btn btn-primary shadow-sm" do %>
        <i class="bi bi-plus-lg me-1"></i> Añadir Repuesto
      <% end %>
    <% end %>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>SKU</th>
              <th>Nombre</th>
              <th>Unidad</th>
              <th>Stock</th>
              <th>Costo</th>
              <th class="text-end" style="min-width: 150px;">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% if @parts.any? %>
              <% @parts.each do |part| %>
                <tr>
                  <td class="fw-medium text-muted"><%= part.sku %></td>
                  <td class="fw-bold"><%= part.name %></td>
                  <td><span class="badge bg-secondary opacity-75"><%= part.unit_of_measure %></span></td>
                  <td>
                    <span class="badge <%= part.stock > 0 ? 'text-bg-success' : 'text-bg-danger' %> rounded-pill px-3 py-2 shadow-sm">
                      <i class="bi <%= part.stock > 0 ? 'bi-check-circle' : 'bi-exclamation-circle' %> me-1"></i>
                      <%= number_with_precision(part.stock, precision: 2, strip_insignificant_zeros: true) %>
                    </span>
                  </td>
                  <td>
                    <%= format_money(part.cost, part.currency) %>
                    <% if part.currency == 'USD' %>
                      <div class="small fw-normal text-muted mt-1"><%= format_money(converted_to_clp(part.cost, 'USD'), 'CLP') %></div>
                    <% end %>
                  </td>
                  <td class="text-end">
                    <%= link_to part, class: "btn btn-sm btn-outline-primary shadow-sm me-1", title: "Ver detalles" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <% if policy(part).edit? %>
                      <%= link_to edit_part_path(part), class: "btn btn-sm btn-outline-secondary shadow-sm", title: "Editar" do %>
                        <i class="bi bi-pencil"></i>
                      <% end %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6" class="text-center py-5 text-muted">
                  <i class="bi bi-inbox display-4 d-block mb-3 opacity-50"></i>
                  No hay repuestos registrados en el inventario.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <%= render "shared/pagination", pagy: @pagy %>
</div>
