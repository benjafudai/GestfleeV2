<% vehicles = Vehicle.all.order(:plate) %>
<%= form_with(model: part, local: true) do |f| %>
  <%= render "shared/form_errors", object: part, subject: "el repuesto" %>

  <div class="card mb-4">
    <div class="card-header bg-white">
      <%= inventory_card_title("Datos del repuesto", icon: "bi-card-text") %>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <%= f.label :sku, class: "form-label" do %>SKU <span class="text-danger">*</span><% end %>
          <%= f.text_field :sku, class: "form-control", placeholder: "Ej.: FIL-ACE-001", required: true %>
        </div>
        <div class="col-md-8">
          <%= f.label :name, class: "form-label" do %>Nombre <span class="text-danger">*</span><% end %>
          <%= f.text_field :name, class: "form-control", placeholder: "Ej.: Filtro de aceite camioneta", required: true %>
        </div>

        <div class="col-sm-6 col-md-4">
          <%= f.label :unit_of_measure, class: "form-label" do %>Unidad de medida <span class="text-danger">*</span><% end %>
          <%= f.text_field :unit_of_measure, class: "form-control", placeholder: "Ej.: unidad, litro, juego", required: true %>
          <div class="form-text">Escríbela en singular: el plural se agrega solo.</div>
        </div>
        <div class="col-sm-6 col-md-3">
          <%= f.label :stock, class: "form-label" do %><%= part.new_record? ? "Stock inicial" : "Stock actual" %> <span class="text-danger">*</span><% end %>
          <%= f.number_field :stock, value: decimal_field_value(part.stock), step: :any, min: 0, class: "form-control", required: true %>
        </div>
        <div class="col-4 col-md-2">
          <%= f.label :currency, "Moneda", class: "form-label" %>
          <%= f.select :currency, ["CLP", "USD"], {}, { class: "form-select" } %>
        </div>
        <div class="col-8 col-md-3">
          <%= f.label :cost, class: "form-label" do %>Costo unitario <span class="text-danger">*</span><% end %>
          <%= f.number_field :cost, value: decimal_field_value(part.cost), step: :any, min: 0, class: "form-control", required: true %>
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header bg-white">
      <%= inventory_card_title("Vehículos compatibles", icon: "bi-truck") %>
    </div>
    <div class="card-body">
      <p class="form-text mt-0 mb-3">Marca los vehículos que usan este repuesto: solo esos podrán pedirlo en una solicitud de suministros.</p>
      <% if vehicles.any? %>
        <div class="row g-2">
          <%= f.collection_check_boxes :vehicle_ids, vehicles, :id, :plate do |b| %>
            <div class="col-6 col-sm-4 col-md-3 col-xl-2">
              <div class="form-check">
                <%= b.check_box class: "form-check-input" %>
                <%= b.label class: "form-check-label" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-muted small">
          <%= f.hidden_field :vehicle_ids, value: "", multiple: true %>
          Todavía no hay vehículos registrados.
        </div>
      <% end %>
    </div>
  </div>

  <div class="d-flex justify-content-end gap-2 mt-4">
    <%= link_to "Cancelar", part.persisted? ? part_path(part) : parts_path, class: "btn btn-outline-secondary" %>
    <%= f.submit yield(:submit_text), class: "btn btn-primary" %>
  </div>
<% end %>
