<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div class="min-w-0">
      <h1 class="h3 mb-0"><i class="bi bi-pencil-square me-2"></i>Editar repuesto</h1>
      <p class="text-muted mb-0"><%= @part.name_was.presence || @part.name %> · SKU <%= @part.sku_was.presence || @part.sku %></p>
    </div>
    <%= link_to part_path(@part), class: "btn btn-outline-secondary text-nowrap" do %>
      <i class="bi bi-eye me-1"></i>Ver repuesto
    <% end %>
  </div>

  <% provide(:submit_text, "Guardar cambios") %>
  <%= render "form", part: @part %>
</div>
