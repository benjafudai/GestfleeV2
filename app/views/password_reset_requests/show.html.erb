<% reset_request = @password_reset_request %>
<% user = reset_request.user %>
<% status_labels = { "pending" => "Pendiente", "approved" => "Aprobada", "completed" => "Completada", "rejected" => "Rechazada" } %>
<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-lg-9 col-xl-7">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div class="min-w-0">
          <h1 class="h3 mb-0"><i class="bi bi-key-fill me-2"></i>Solicitud de clave</h1>
          <p class="text-muted mb-0">Recibida el <%= l(reset_request.created_at, format: :long) %></p>
        </div>
        <%= link_to password_reset_requests_path, class: "btn btn-outline-secondary text-nowrap" do %>
          <i class="bi bi-arrow-left me-1"></i>Volver
        <% end %>
      </div>

      <div class="card">
        <div class="card-header bg-white d-flex align-items-center gap-3 py-3">
          <%= user_avatar(user, size: :lg) %>
          <div class="min-w-0 flex-grow-1">
            <div class="text-break"><%= user.email %></div>
            <div class="small text-muted fw-normal">
              <%= user.company&.name || "Sin empresa" %> · <%= role_label(user.role) %>
            </div>
          </div>
          <%= status_badge(status_labels.fetch(reset_request.status.to_s, reset_request.status.to_s.humanize), reset_request.status) %>
        </div>

        <div class="card-body p-4">
          <% if reset_request.pending? %>
            <p class="text-muted mb-4">
              Asigna una contraseña temporal y comunícasela al usuario por un canal seguro.
              Al entrar con ella, GestFlee le pedirá que la cambie por una propia.
            </p>

            <% if user.access_locked? %>
              <div class="alert alert-warning d-flex flex-column flex-sm-row align-items-sm-center gap-2 gap-sm-3 mb-4">
                <div class="d-flex align-items-baseline gap-2 flex-grow-1">
                  <i class="bi bi-lock-fill flex-shrink-0" aria-hidden="true"></i>
                  <span>
                    <strong>La cuenta está bloqueada</strong> por intentos fallidos y se desbloquea sola el
                    <%= auto_unlock_time(user) %>. Si no la desbloqueas, no podrá entrar
                    con la contraseña temporal hasta esa hora.
                  </span>
                </div>
                <%= unlock_account_button(user, label: "Desbloquear cuenta") %>
              </div>
            <% end %>

            <%= form_with url: password_reset_request_path(reset_request), method: :patch, local: true do |f| %>
              <div class="row g-3">
                <div class="col-md-6">
                  <%= f.label :password, class: "form-label" do %>Nueva contraseña temporal <span class="text-danger">*</span><% end %>
                  <%= f.password_field :password, class: "form-control", required: true, minlength: User.password_length.min,
                        autocomplete: "new-password" %>
                  <div class="form-text">Mínimo <%= User.password_length.min %> caracteres.</div>
                </div>

                <div class="col-md-6">
                  <%= f.label :password_confirmation, class: "form-label" do %>Confirmar contraseña <span class="text-danger">*</span><% end %>
                  <%= f.password_field :password_confirmation, class: "form-control", required: true, minlength: User.password_length.min,
                        autocomplete: "new-password" %>
                </div>
              </div>

              <div class="d-flex justify-content-end gap-2 mt-4">
                <%= link_to "Cancelar", password_reset_requests_path, class: "btn btn-outline-secondary" %>
                <%= f.submit "Guardar contraseña temporal", class: "btn btn-primary" %>
              </div>
            <% end %>
          <% else %>
            <% rejected = reset_request.rejected? %>
            <div class="d-flex align-items-start gap-3">
              <span class="gf-action-icon <%= rejected ? "bg-danger-subtle text-danger-emphasis" : "is-success" %>" aria-hidden="true">
                <i class="bi <%= rejected ? "bi-x-lg" : "bi-check-lg" %>"></i>
              </span>
              <div class="min-w-0">
                <p class="fw-bold mb-1">
                  Resuelta el <%= l(reset_request.updated_at, format: :long) %><% if reset_request.admin %> por <%= reset_request.admin.email %><% end %>.
                </p>
                <p class="text-muted mb-0">
                  <% if rejected %>
                    La contraseña no se modificó. Si el usuario la necesita, puede volver a pedirla.
                  <% else %>
                    Se asignó una contraseña temporal; el usuario deberá cambiarla al entrar.
                  <% end %>
                </p>
              </div>
            </div>
          <% end %>
        </div>

        <% if reset_request.pending? %>
          <div class="card-footer d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2 gap-sm-3 px-4 py-3">
            <small class="text-muted">
              ¿No corresponde atender esta solicitud? Recházala: la contraseña no cambia y el usuario puede volver a pedirla.
            </small>
            <%= button_to "Rechazar solicitud", reject_password_reset_request_path(reset_request), method: :patch,
                  data: { turbo_confirm: "¿Rechazar la solicitud de #{user.email}?" },
                  class: "btn btn-sm btn-outline-danger text-nowrap" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
