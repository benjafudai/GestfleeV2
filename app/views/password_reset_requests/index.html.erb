<div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Solicitudes de Recuperación de Contraseña</h2>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      <% if @pending_requests.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>Usuario</th>
                <th>Empresa</th>
                <th>Fecha de Solicitud</th>
                <th>Estado</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% @pending_requests.each do |request| %>
                <tr>
                  <td>
                    <div class="fw-bold"><%= request.user.email %> <%= account_locked_badge(request.user) %></div>
                  </td>
                  <td><%= request.user.company&.name || "—" %></td>
                  <td><%= request.created_at.strftime("%d/%m/%Y %H:%M") %></td>
                  <td>
                    <span class="badge bg-warning text-dark">Pendiente</span>
                  </td>
                  <td>
                    <div class="d-flex gap-2">
                      <%= link_to "Validar y Asignar Contraseña", password_reset_request_path(request), class: "btn btn-sm btn-primary" %>
                      <%= button_to "Rechazar", reject_password_reset_request_path(request), method: :patch,
                            data: { turbo_confirm: "¿Rechazar la solicitud de #{request.user.email}?" },
                            class: "btn btn-sm btn-outline-danger" %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-5">
          <p class="text-muted mb-0">No hay solicitudes de recuperación de contraseña pendientes.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
