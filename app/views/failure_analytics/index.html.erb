<%
  page_subtitle = if @vehicle
    "#{[@vehicle.brand, @vehicle.model].compact_blank.join(' ')} · fallas, repuestos y tiempo fuera de servicio."
  else
    "Fallas reportadas, costo de repuestos y tiempo fuera de servicio por unidad."
  end
  worst_failures = @worst_vehicle_by_failures if @worst_vehicle_by_failures && (@worst_vehicle_by_failures[:incidents] + @worst_vehicle_by_failures[:corrective]) > 0
  worst_downtime = @worst_vehicle_by_downtime if @worst_vehicle_by_downtime && @worst_vehicle_by_downtime[:total_downtime] > 0
  chart_has_data = Array(@chart_incident_counts).sum.positive?
  chart_labels = Array(@chart_labels).map { |label| failure_chart_short_label(label) }
  chart_range = [Array(@chart_labels).first, Array(@chart_labels).last].compact.map { |label| label.to_s.downcase }.join(" a ")
%>
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0">
        <i class="bi bi-clipboard2-pulse me-2"></i><%= @vehicle ? "Análisis de fallas de #{@vehicle.plate}" : "Análisis de fallas y mantención" %>
      </h1>
      <p class="text-muted mb-0"><%= page_subtitle %></p>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body py-3 d-flex flex-column flex-sm-row align-items-sm-center gap-2 gap-sm-3">
      <label for="vehicle_selector" class="form-label mb-0 text-nowrap">
        <i class="bi bi-funnel me-1"></i>Ver por vehículo
      </label>
      <select id="vehicle_selector" class="form-select" style="max-width: 360px;"
              onchange="if (this.value) { window.location.href = this.value }">
        <option value="<%= failure_analytics_path %>" <%= "selected" if @vehicle.nil? %>>Toda la flota</option>
        <% @vehicles.each do |v| %>
          <option value="<%= failure_analytics_path(vehicle_id: v.id) %>" <%= "selected" if @vehicle == v %>>
            <%= v.plate %> — <%= v.brand %> <%= v.model %>
          </option>
        <% end %>
      </select>
      <% if @vehicle %>
        <%= link_to failure_analytics_path, class: "btn btn-link btn-sm px-0 ms-sm-auto align-self-start align-self-sm-center text-nowrap" do %>
          <i class="bi bi-arrow-left"></i> Volver a toda la flota
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
      <div class="card h-100">
        <div class="card-body d-flex flex-column flex-sm-row align-items-start gap-2 gap-sm-3">
          <%= expense_icon_circle("bi-exclamation-triangle", "danger") %>
          <div class="min-w-0">
            <div class="small text-muted">Fallas reportadas</div>
            <div class="h4 mb-0 text-nowrap"><%= number_with_delimiter(@total_incidents) %></div>
            <% if @incidents_by_severity.any? %>
              <div class="d-flex gap-1 flex-wrap mt-2">
                <% failure_severity_sorted(@incidents_by_severity).each do |severity, count| %>
                  <%= failure_severity_badge(severity, count) %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-xl-3">
      <div class="card h-100">
        <div class="card-body d-flex flex-column flex-sm-row align-items-start gap-2 gap-sm-3">
          <%= expense_icon_circle("bi-wrench-adjustable", "warning") %>
          <div class="min-w-0">
            <div class="small text-muted">OT correctivas</div>
            <div class="h4 mb-0 text-nowrap"><%= number_with_delimiter(@total_corrective) %></div>
            <div class="small text-muted"><%= expense_percent(@corrective_rate) %> del total de OT</div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-xl-3">
      <div class="card h-100">
        <div class="card-body d-flex flex-column flex-sm-row align-items-start gap-2 gap-sm-3">
          <%= expense_icon_circle("bi-box-seam", "info") %>
          <div class="min-w-0">
            <div class="small text-muted">Valor de repuestos usados</div>
            <div class="h4 mb-0 text-nowrap"><%= format_money(@total_parts_value, 'CLP') %></div>
            <div class="small text-muted">En las órdenes de trabajo</div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-xl-3">
      <div class="card h-100">
        <div class="card-body d-flex flex-column flex-sm-row align-items-start gap-2 gap-sm-3">
          <%= expense_icon_circle("bi-clock-history", "primary") %>
          <div class="min-w-0">
            <div class="small text-muted">Tiempo promedio en taller</div>
            <div class="h4 mb-0 text-nowrap"><%= failure_hours(@avg_downtime_hours) %></div>
            <div class="small text-muted"><%= @avg_downtime_hours ? "Por OT completada" : "Sin OT completadas aún" %></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-6">
      <div class="card h-100">
        <div class="card-body d-flex align-items-center gap-3">
          <%= expense_icon_circle("bi-truck-front", "danger") %>
          <div class="min-w-0">
            <div class="small text-muted"><%= @vehicle ? "Vehículo con más fallas de la flota" : "Vehículo con más fallas" %></div>
            <% if worst_failures %>
              <div class="h5 mb-0">
                <%= link_to worst_failures[:vehicle].plate, failure_analytics_path(vehicle_id: worst_failures[:vehicle].id), class: "text-reset" %>
              </div>
              <div class="small text-muted">
                <%= failure_count_label(worst_failures[:incidents]) %> · <%= corrective_count_label(worst_failures[:corrective]) %>
              </div>
            <% else %>
              <div class="h5 mb-0 text-muted">—</div>
              <div class="small text-muted">Sin fallas registradas</div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card h-100">
        <div class="card-body d-flex align-items-center gap-3">
          <%= expense_icon_circle("bi-hourglass-split", "warning") %>
          <div class="min-w-0">
            <div class="small text-muted"><%= @vehicle ? "Más tiempo fuera de servicio en la flota" : "Vehículo con más tiempo fuera de servicio" %></div>
            <% if worst_downtime %>
              <div class="h5 mb-0">
                <%= link_to worst_downtime[:vehicle].plate, failure_analytics_path(vehicle_id: worst_downtime[:vehicle].id), class: "text-reset" %>
              </div>
              <div class="small text-muted"><%= failure_hours(worst_downtime[:total_downtime]) %> acumuladas en taller</div>
            <% else %>
              <div class="h5 mb-0 text-muted">—</div>
              <div class="small text-muted">Sin OT completadas aún</div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
      <h2 class="h6 mb-0">Fallas reportadas por mes</h2>
      <span class="small text-muted fw-normal">Últimos 6 meses<%= " (#{chart_range})" if chart_range.present? %></span>
    </div>
    <% if chart_has_data %>
      <div class="card-body">
        <div style="height: 260px;">
          <canvas role="img" aria-label="Gráfico de fallas reportadas por mes"
                  data-controller="failures-chart"
                  data-failures-chart-labels-value="<%= chart_labels.to_json %>"
                  data-failures-chart-counts-value="<%= @chart_incident_counts.to_json %>"></canvas>
        </div>
      </div>
    <% else %>
      <div class="text-center py-5 px-3 text-muted">
        <i class="bi bi-bar-chart d-block opacity-50"></i>
        <p class="mb-1 fw-bold text-body">No hay fallas en los últimos 6 meses</p>
        <p class="small mb-0">Cuando se reporten incidentes<%= " de #{@vehicle.plate}" if @vehicle %>, verás aquí su evolución mes a mes.</p>
      </div>
    <% end %>
  </div>

  <div class="card">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
      <h2 class="h6 mb-0">Detalle por vehículo</h2>
      <% if @per_vehicle.any? %>
        <span class="small text-muted fw-normal">Toca una patente para ver su análisis</span>
      <% end %>
    </div>
    <% if @per_vehicle.any? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Vehículo</th>
              <th class="text-center">Fallas</th>
              <th class="text-center">OT correctivas</th>
              <th class="text-end">Valor repuestos</th>
              <th class="text-end">Prom. en taller</th>
              <th class="text-end">Total fuera de servicio</th>
            </tr>
          </thead>
          <tbody>
            <% @per_vehicle.each do |row| %>
              <% vehicle = row[:vehicle] %>
              <% selected = @vehicle == vehicle %>
              <%= tag.tr class: ("table-primary" if selected), style: ("--bs-table-border-color: var(--line);" if selected), "aria-current": ("true" if selected) do %>
                <td>
                  <%= link_to vehicle.plate, failure_analytics_path(vehicle_id: vehicle.id), class: "fw-bold text-reset text-nowrap" %>
                  <% vehicle_model = [vehicle.brand, vehicle.model].compact_blank.join(" ") %>
                  <% if vehicle_model.present? %>
                    <div class="small text-muted d-none d-md-block"><%= vehicle_model %></div>
                  <% end %>
                </td>
                <td class="text-center">
                  <% if row[:incidents] > 0 %>
                    <span class="badge text-bg-danger"><%= row[:incidents] %></span>
                  <% else %>
                    <span class="text-muted">0</span>
                  <% end %>
                </td>
                <td class="text-center <%= 'text-muted' if row[:corrective].zero? %>"><%= row[:corrective] %></td>
                <td class="text-end <%= 'text-muted' if row[:parts_value].to_f.zero? %>"><%= format_money(row[:parts_value], 'CLP') %></td>
                <td class="text-end <%= 'text-muted' unless row[:avg_downtime] %>"><%= failure_hours(row[:avg_downtime]) %></td>
                <td class="text-end <%= 'text-muted' unless row[:total_downtime] > 0 %>"><%= row[:total_downtime] > 0 ? failure_hours(row[:total_downtime]) : "—" %></td>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5 px-3 text-muted">
        <i class="bi bi-truck-front d-block opacity-50"></i>
        <p class="mb-1 fw-bold text-body">No hay vehículos registrados</p>
        <p class="small mb-0">Cuando la empresa tenga vehículos, aquí verás sus fallas y tiempos en taller.</p>
      </div>
    <% end %>
  </div>
</div>
