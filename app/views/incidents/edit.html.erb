<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Editar incidente #<%= @incident.id %></h1>
      <p class="text-muted mb-0"><%= incident_vehicle_label(@incident.vehicle) %></p>
    </div>
    <%= link_to @incident, class: "btn btn-outline-secondary text-nowrap" do %>
      <i class="bi bi-eye me-1"></i>Ver incidente
    <% end %>
  </div>

  <%= render "form", incident: @incident %>
</div>
