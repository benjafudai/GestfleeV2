<div class="container mt-4">
  <%= render "dashboards/welcome", icon: "bi-graph-up-arrow", title: "Bienvenido, #{current_user.email}", tag: "Analista" %>

  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <div class="text-muted small text-uppercase fw-semibold mb-1">Gasto Total del Mes</div>
          <div class="h4 fw-bold mb-0"><%= number_to_currency(@total_month_cost, unit: "$", precision: 0) %></div>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <div class="text-muted small text-uppercase fw-semibold mb-1">Gasto en Combustible</div>
          <div class="h4 fw-bold mb-0"><%= number_to_currency(@fuel_month_cost, unit: "$", precision: 0) %></div>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <div class="text-muted small text-uppercase fw-semibold mb-1">Gasto en Mantenimiento</div>
          <div class="h4 fw-bold mb-0"><%= number_to_currency(@maintenance_month_cost, unit: "$", precision: 0) %></div>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <div class="text-muted small text-uppercase fw-semibold mb-1">Solicitudes Pendientes</div>
          <div class="h4 fw-bold mb-0"><%= @pending_supply_requests_count %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4 mb-4">
    <div class="col-md-3">
      <div class="card shadow-sm h-100 border-start border-4 border-primary">
        <div class="card-body">
          <h5 class="card-title"><i class="bi bi-coins me-2"></i> Costos</h5>
          <p class="card-text text-muted small">Analiza los gastos registrados por unidad y período.</p>
          <%= link_to "Ver Costos", expenses_path, class: "btn btn-outline-primary btn-sm" %>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card shadow-sm h-100 border-start border-4 border-primary">
        <div class="card-body">
          <h5 class="card-title"><i class="bi bi-fuel-pump-fill me-2"></i> Combustible</h5>
          <p class="card-text text-muted small">Rendimiento y consumo de la flota.</p>
          <%= link_to "Ver Combustible", fuel_fills_path, class: "btn btn-outline-primary btn-sm" %>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card shadow-sm h-100 border-start border-4 border-primary">
        <div class="card-body">
          <h5 class="card-title"><i class="bi bi-boxes me-2"></i> Inventario</h5>
          <p class="card-text text-muted small">Stock y valorización de repuestos.</p>
          <%= link_to "Ver Inventario", parts_path, class: "btn btn-outline-primary btn-sm" %>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card shadow-sm h-100 border-start border-4 border-danger">
        <div class="card-body">
          <h5 class="card-title"><i class="bi bi-shield-exclamation me-2"></i> Alertas</h5>
          <p class="card-text text-muted small">Documentos vencidos o próximos a vencer.</p>
          <%= link_to "Ver Alertas", alerts_path, class: "btn btn-outline-danger btn-sm" %>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card shadow-sm h-100 border-start border-4 border-primary">
        <div class="card-body">
          <h5 class="card-title"><i class="bi bi-clipboard2-pulse me-2"></i> Fallas y Mantención</h5>
          <p class="card-text text-muted small">Fallas, costo de repuestos y tiempo fuera de servicio.</p>
          <%= link_to "Ver Análisis", failure_analytics_path, class: "btn btn-outline-primary btn-sm" %>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-header bg-white">
          <h6 class="mb-0">Gasto del Mes por Categoría</h6>
        </div>
        <div class="card-body p-0">
          <% if @expenses_by_category.any? %>
            <ul class="list-group list-group-flush">
              <% @expenses_by_category.sort_by { |_cat, amount| -amount }.each do |category, amount| %>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                  <span><%= expense_category_label(category) %></span>
                  <span class="fw-medium"><%= number_to_currency(amount, unit: "$", precision: 0) %></span>
                </li>
              <% end %>
            </ul>
          <% else %>
            <div class="text-center py-4 text-muted">No hay gastos registrados este mes.</div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
