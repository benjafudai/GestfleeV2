<div class="container mt-4">

  <%# ── Bienvenida (con la acción principal del día) ── %>
  <% checklist_action = if @vehicle
       link_to new_checklist_submission_path, class: "btn btn-primary text-nowrap" do
         safe_join([tag.i(class: "bi bi-clipboard-check me-1"), "Completar checklist del día"])
       end
     end %>
  <%= render "dashboards/welcome", icon: "bi-truck", title: "Mi unidad",
        subtitle: dashboard_greeting(current_user), action: checklist_action %>

  <% if @vehicle %>
    <div class="row g-3">

      <%# Card info vehículo %>
      <div class="col-lg-5">
        <div class="card h-100">
          <div class="card-body">
            <div class="d-flex align-items-center gap-3 mb-3">
              <%= dashboard_icon_circle("bi-car-front") %>
              <div class="min-w-0 flex-grow-1">
                <div class="small text-muted">Mi vehículo asignado</div>
                <h2 class="h4 mb-0 text-nowrap"><%= @vehicle.plate %></h2>
              </div>
              <%= status_badge(vehicle_status_label(@vehicle.status), @vehicle.status) %>
            </div>

            <ul class="list-group list-group-flush">
              <li class="list-group-item d-flex justify-content-between gap-3 px-0">
                <span class="text-muted">Marca</span>
                <span class="text-body text-end"><%= @vehicle.brand %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between gap-3 px-0">
                <span class="text-muted">Modelo</span>
                <span class="text-body text-end"><%= @vehicle.model %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between gap-3 px-0">
                <span class="text-muted">Año</span>
                <span class="text-body text-end"><%= @vehicle.year %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between gap-3 px-0">
                <span class="text-muted">Odómetro</span>
                <span class="text-body text-end text-nowrap"><%= number_with_delimiter(@vehicle.odometer) %> km</span>
              </li>
              <li class="list-group-item d-flex justify-content-between gap-3 px-0">
                <span class="text-muted">Asignado desde</span>
                <span class="text-body text-end"><%= l(@assignment.started_on, format: :long) %></span>
              </li>
            </ul>

            <% if @assignment.notes.present? %>
              <div class="mt-3 p-3 bg-light rounded-3 small text-muted d-flex gap-2">
                <i class="bi bi-chat-left-text"></i>
                <span><%= @assignment.notes %></span>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <%# Card documentos del vehículo %>
      <div class="col-lg-7">
        <div class="card h-100">
          <div class="card-header bg-white">
            <h2 class="h6 mb-0">Documentos del vehículo</h2>
          </div>
          <% if @documents.any? %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Documento</th>
                    <th>Estado</th>
                    <th class="text-end">PDF</th>
                  </tr>
                </thead>
                <tbody>
                  <% @documents.each do |doc| %>
                    <% doc_status = dashboard_document_status(doc) %>
                    <tr>
                      <td>
                        <span class="fw-bold text-body"><%= vehicle_doc_type_label(doc.doc_type) %></span>
                        <div class="small <%= doc_status == 'ok' ? 'text-muted' : "text-#{status_tone(doc_status)}-emphasis" %>"><%= dashboard_due_text(doc.due_on) %></div>
                      </td>
                      <td><%= status_badge(document_status_label(doc_status), doc_status) %></td>
                      <td class="text-end">
                        <% if doc.file.attached? %>
                          <div class="gf-row-actions">
                            <%= link_to rails_blob_path(doc.file, disposition: "inline"),
                                  target: "_blank",
                                  class: "btn btn-sm btn-outline-danger",
                                  title: doc.file.filename.to_s,
                                  "aria-label": "Ver PDF" do %>
                              <i class="bi bi-file-earmark-pdf"></i>
                            <% end %>
                          </div>
                        <% else %>
                          <span class="text-muted small">—</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5 px-3 text-muted">
              <i class="bi bi-file-earmark-x d-block opacity-50"></i>
              <p class="mb-1 fw-bold text-body">Sin documentos registrados</p>
              <p class="small mb-0">Tu administrador cargará aquí el permiso de circulación, la revisión técnica y el seguro.</p>
            </div>
          <% end %>
        </div>
      </div>

    </div><%# /row g-3 %>

    <%# ── Checklists recientes ── %>
    <div class="card mt-4">
      <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 class="h6 mb-0">Mis checklists recientes</h2>
        <%= link_to checklist_submissions_path, class: "btn btn-sm btn-link px-0 text-nowrap" do %>Ver todos <i class="bi bi-arrow-right"></i><% end %>
      </div>
      <% if @my_submissions.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="d-none d-sm-table-cell">Plantilla</th>
                <th>Fecha</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% @my_submissions.each do |sub| %>
                <tr>
                  <td class="d-none d-sm-table-cell"><%= sub.checklist_template.name %></td>
                  <td class="text-nowrap"><%= l(sub.submitted_at, format: :short) %></td>
                  <td><%= status_badge(dashboard_checklist_status_label(sub.status), sub.status) %></td>
                  <td class="text-end">
                    <div class="gf-row-actions">
                      <%= link_to sub, class: "btn btn-sm btn-outline-primary", title: "Ver", "aria-label": "Ver" do %>
                        <i class="bi bi-eye"></i>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-5 px-3 text-muted">
          <i class="bi bi-clipboard-check d-block opacity-50"></i>
          <p class="mb-1 fw-bold text-body">Aún no has completado ningún checklist</p>
          <p class="small mb-0">Completa el checklist pre-operativo antes de salir a ruta.</p>
        </div>
      <% end %>
    </div>

  <% else %>
    <%# Sin asignación activa %>
    <div class="card">
      <div class="text-center py-5 px-3 text-muted">
        <i class="bi bi-truck d-block opacity-50"></i>
        <p class="mb-1 fw-bold text-body">Sin vehículo asignado</p>
        <p class="small mb-0">Aún no tienes un vehículo asignado. Contacta a tu administrador para que te asigne uno.</p>
      </div>
    </div>
  <% end %>

</div>
