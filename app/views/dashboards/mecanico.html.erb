<div class="container mt-4">
  <%= render "dashboards/welcome", icon: "bi-wrench-adjustable-circle", title: "Bienvenido, #{current_user.email}", tag: "Mecánico" %>

  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <div class="text-muted small text-uppercase fw-semibold mb-1">OTs Pendientes</div>
          <div class="h4 fw-bold mb-0"><%= @pending_work_orders.size %></div>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <div class="text-muted small text-uppercase fw-semibold mb-1">OTs En Progreso</div>
          <div class="h4 fw-bold mb-0"><%= @in_progress_work_orders.size %></div>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <div class="text-muted small text-uppercase fw-semibold mb-1">Completadas Este Mes</div>
          <div class="h4 fw-bold mb-0"><%= @completed_this_month.size %></div>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card shadow-sm h-100 <%= 'border-start border-4 border-warning' if @low_stock_parts.any? %>">
        <div class="card-body">
          <div class="text-muted small text-uppercase fw-semibold mb-1">Repuestos Stock Bajo</div>
          <div class="h4 fw-bold mb-0"><%= @low_stock_parts.size %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4 mb-4">
    <div class="col-md-4">
      <div class="card shadow-sm h-100 border-start border-4 border-primary">
        <div class="card-body">
          <h5 class="card-title"><i class="bi bi-clipboard-check me-2"></i> Órdenes de Trabajo</h5>
          <p class="card-text text-muted small">Crea y gestiona las órdenes de mantenimiento de la flota.</p>
          <%= link_to "Ir a Órdenes OT", work_orders_path, class: "btn btn-outline-primary btn-sm" %>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card shadow-sm h-100 border-start border-4 border-primary">
        <div class="card-body">
          <h5 class="card-title"><i class="bi bi-boxes me-2"></i> Inventario</h5>
          <p class="card-text text-muted small">Consulta stock y costos de repuestos disponibles.</p>
          <%= link_to "Ver Inventario", parts_path, class: "btn btn-outline-primary btn-sm" %>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card shadow-sm h-100 border-start border-4 border-primary">
        <div class="card-body">
          <h5 class="card-title"><i class="bi bi-cart-plus me-2"></i> Solicitudes de Repuestos</h5>
          <p class="card-text text-muted small">Pide los repuestos necesarios para tus órdenes de trabajo.</p>
          <%= link_to "Ir a Repuestos", supply_requests_path, class: "btn btn-outline-primary btn-sm" %>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-7">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
          <h6 class="mb-0">Órdenes de Trabajo Recientes</h6>
          <%= link_to "Ver todas", work_orders_path, class: "btn btn-sm btn-link text-decoration-none" %>
        </div>
        <div class="card-body p-0">
          <% if @recent_work_orders.any? %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Vehículo</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  <% @recent_work_orders.each do |wo| %>
                    <tr>
                      <td class="small fw-medium"><%= wo.vehicle&.plate %></td>
                      <td>
                        <% badge_class, label = case wo.status
                             when 'pending'     then ['text-bg-warning', 'Pendiente']
                             when 'in_progress' then ['text-bg-primary', 'En Progreso']
                             when 'completed'   then ['text-bg-success', 'Completada']
                             when 'cancelled'   then ['text-bg-danger', 'Cancelada']
                             end %>
                        <span class="badge <%= badge_class %> rounded-pill"><%= label %></span>
                      </td>
                      <td class="text-end">
                        <%= link_to "Ver", wo, class: "btn btn-sm btn-outline-secondary" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-4 text-muted">No hay órdenes de trabajo registradas.</div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-white">
          <h6 class="mb-0">Mis Solicitudes de Repuestos</h6>
        </div>
        <div class="card-body p-0">
          <% if @pending_supply_requests.any? %>
            <ul class="list-group list-group-flush">
              <% @pending_supply_requests.each do |req| %>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                  <div>
                    <span class="fw-medium small"><%= req.vehicle.plate %></span>
                    <span class="text-muted small d-block"><%= l req.created_at.to_date, format: :short %></span>
                  </div>
                  <span class="badge text-bg-secondary rounded-pill"><%= SupplyRequest.human_status(req.status) %></span>
                </li>
              <% end %>
            </ul>
          <% else %>
            <div class="text-center py-4 text-muted">Sin solicitudes pendientes.</div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
