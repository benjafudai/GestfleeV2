<div class="container mt-4">
  <% new_user_action = link_to new_user_path, class: "btn btn-primary text-nowrap" do
       safe_join([tag.i(class: "bi bi-person-plus me-1"), "Nuevo usuario"])
     end %>
  <%= render "dashboards/welcome", icon: "bi-shield-lock", title: "Panel global",
        subtitle: dashboard_greeting(current_user), action: new_user_action %>

  <div class="row g-3 mb-4">
    <div class="col-6 col-xl-4">
      <%= dashboard_stat "Empresas", number_with_delimiter(@companies_count), icon: "bi-buildings" %>
    </div>
    <div class="col-6 col-xl-4">
      <%= dashboard_stat "Usuarios", number_with_delimiter(@users_count), icon: "bi-people" %>
    </div>
    <div class="col-12 col-xl-4">
      <%= dashboard_stat "Empresas sin administrador", number_with_delimiter(@companies_without_admin.size),
            icon: @companies_without_admin.any? ? "bi-exclamation-octagon" : "bi-check2-circle",
            tone: @companies_without_admin.any? ? :danger : :success %>
    </div>
  </div>

  <% if @companies_without_admin.any? %>
    <div class="alert alert-danger d-flex align-items-start gap-2 mb-4">
      <i class="bi bi-exclamation-triangle mt-1"></i>
      <div>
        <strong>Empresas sin ningún administrador:</strong>
        <%= @companies_without_admin.map(&:name).join(", ") %>
      </div>
    </div>
  <% end %>

  <div class="row g-3">
    <div class="col-md-6 col-xl-4">
      <%= dashboard_action_card "Empresas", "Activa o desactiva módulos (Mecánico, Analista) para cada empresa.",
            path: companies_path, link_text: "Ver empresas", icon: "bi-buildings" %>
    </div>
    <div class="col-md-6 col-xl-4">
      <%= dashboard_action_card "Usuarios", "Administra los usuarios y administradores de todas las empresas.",
            path: users_path, link_text: "Ver usuarios", icon: "bi-people", tone: :success %>
    </div>
    <div class="col-md-12 col-xl-4">
      <%= dashboard_action_card "Solicitudes de clave", "Atiende los pedidos de recuperación de contraseña de los usuarios.",
            path: password_reset_requests_path, link_text: "Ver solicitudes", icon: "bi-key", tone: :warning %>
    </div>
  </div>
</div>
