<div class="container mt-4">
  <div class="row mb-4">
    <div class="col-12">
      <div class="card border-0 bg-primary-subtle shadow-sm">
        <div class="card-body d-flex align-items-center gap-3 py-3">
          <i class="bi bi-shield-lock fs-2 text-primary"></i>
          <div>
            <h4 class="mb-0 fw-semibold">Dashboard Administrador</h4>
            <span class="badge bg-primary text-white"><%= current_user.company&.name || "Sin Empresa" %></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <%# Módulo de Vehículos (Link rápido) %>
    <div class="col-md-4">
      <div class="card shadow-sm h-100 border-start border-4 border-info">
        <div class="card-body">
          <h5 class="card-title"><i class="bi bi-truck me-2"></i> Flota</h5>
          <p class="card-text text-muted small">Gestión de vehículos, documentos y asignación de choferes.</p>
          <%= link_to "Ir a Vehículos", vehicles_path, class: "btn btn-outline-info btn-sm" %>
        </div>
      </div>
    </div>

    <%# Módulo de Checklists (Configuración) %>
    <div class="col-md-4">
      <div class="card shadow-sm h-100 border-start border-4 border-primary">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <h5 class="card-title"><i class="bi bi-clipboard me-2"></i> Plantillas Checklist</h5>
            <span class="badge text-bg-primary rounded-pill"><%= @templates_count %></span>
          </div>
          <p class="card-text text-muted small">Configura las preguntas dinámicas que los choferes deben responder.</p>
          <%= link_to "Gestionar Plantillas", checklist_templates_path, class: "btn btn-outline-primary btn-sm" %>
        </div>
      </div>
    </div>

    <%# Módulo de Auditoría (Submissions recientes) %>
    <div class="col-md-4">
      <div class="card shadow-sm h-100 border-start border-4 border-warning">
        <div class="card-body">
          <h5 class="card-title"><i class="bi bi-shield-check me-2"></i> Auditoría Inspecciones</h5>
          <p class="card-text text-muted small">Aprueba o rechaza los checklists completados por el equipo.</p>
          <%= link_to "Ver Todos los Envíos", checklist_submissions_path, class: "btn btn-outline-warning btn-sm" %>
        </div>
      </div>
    </div>
  </div>

  <div class="row mt-4">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
          <h6 class="mb-0">Últimos Checklists Recibidos</h6>
          <%= link_to "Ver listado completo", checklist_submissions_path, class: "btn btn-sm btn-link text-decoration-none" %>
        </div>
        <div class="card-body p-0">
          <% if @recent_submissions.any? %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Plantilla</th>
                    <th>Vehículo</th>
                    <th>Chofer</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  <% @recent_submissions.each do |sub| %>
                    <tr>
                      <td class="fw-medium small"><%= sub.checklist_template.name %></td>
                      <td class="small"><%= sub.vehicle.plate %></td>
                      <td class="small text-muted"><%= sub.user.email %></td>
                      <td class="small"><%= l(sub.submitted_at, format: :short) %></td>
                      <td>
                        <% badge_class = case sub.status
                            when 'pending'  then 'text-bg-warning'
                            when 'approved' then 'text-bg-success'
                            when 'rejected' then 'text-bg-danger'
                            end %>
                        <span class="badge <%= badge_class %>">
                          <%= sub.status == 'pending' ? 'Pendiente' : sub.status == 'approved' ? 'Aprobado' : 'Rechazado' %>
                        </span>
                      </td>
                      <td class="text-end">
                        <%= link_to "Revisar", sub, class: "btn btn-sm btn-outline-primary" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-4 text-muted">
              No hay envíos recientes.
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>