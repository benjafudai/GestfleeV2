<div class="container mt-4">
  <%= render "dashboards/welcome", icon: "bi-person-gear", title: "Panel de administración",
        subtitle: dashboard_greeting(current_user) %>

  <div class="row g-3">
    <%# Módulo de Vehículos (Link rápido) %>
    <div class="col-md-4">
      <%= dashboard_action_card "Flota", "Gestión de vehículos, documentos y asignación de choferes.",
            path: vehicles_path, link_text: "Ver vehículos", icon: "bi-truck-front" %>
    </div>

    <%# Módulo de Checklists (Configuración) %>
    <div class="col-md-4">
      <%= dashboard_action_card "Plantillas de checklist", "Configura las preguntas que los choferes deben responder.",
            path: checklist_templates_path, link_text: "Gestionar plantillas", icon: "bi-list-check", tone: :success,
            count: pluralize(@templates_count, "plantilla") %>
    </div>

    <%# Módulo de Auditoría (Submissions recientes) %>
    <div class="col-md-4">
      <%= dashboard_action_card "Auditoría de inspecciones", "Aprueba o rechaza los checklists completados por los choferes.",
            path: checklist_submissions_path, link_text: "Ver todos los envíos", icon: "bi-clipboard-check", tone: :warning %>
    </div>
  </div>

  <div class="card mt-4">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
      <h2 class="h6 mb-0">Últimos checklists recibidos</h2>
      <%= link_to checklist_submissions_path, class: "btn btn-sm btn-link px-0 text-nowrap" do %>Ver todos <i class="bi bi-arrow-right"></i><% end %>
    </div>
    <% if @recent_submissions.any? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Vehículo</th>
              <th class="d-none d-lg-table-cell">Plantilla</th>
              <th class="d-none d-md-table-cell">Chofer</th>
              <th class="d-none d-sm-table-cell">Fecha</th>
              <th>Estado</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_submissions.each do |sub| %>
              <tr>
                <td>
                  <span class="fw-bold text-body"><%= sub.vehicle.plate %></span>
                  <div class="small text-muted d-sm-none"><%= l(sub.submitted_at, format: :short) %></div>
                </td>
                <td class="d-none d-lg-table-cell"><%= sub.checklist_template.name %></td>
                <td class="d-none d-md-table-cell text-muted"><%= sub.user.email %></td>
                <td class="d-none d-sm-table-cell text-nowrap"><%= l(sub.submitted_at, format: :short) %></td>
                <td><%= status_badge(dashboard_checklist_status_label(sub.status), sub.status) %></td>
                <td class="text-end">
                  <div class="gf-row-actions">
                    <%= link_to sub, class: "btn btn-sm btn-outline-primary", title: "Revisar", "aria-label": "Revisar" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5 px-3 text-muted">
        <i class="bi bi-clipboard-check d-block opacity-50"></i>
        <p class="mb-1 fw-bold text-body">No hay checklists recibidos</p>
        <p class="small mb-0">Cuando los choferes completen su checklist del día, aparecerá aquí para revisarlo.</p>
      </div>
    <% end %>
  </div>
</div>
