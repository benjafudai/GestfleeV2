<div class="container mt-4">
  <%= render "dashboards/welcome", icon: "bi-shield-lock", title: "Dashboard Administrador",
        tag: current_user.company&.name || "Sin Empresa" %>

  <div class="row g-4">
    <%# Módulo de Vehículos (Link rápido) %>
    <div class="col-md-4">
      <div class="gf-action-card">
        <div class="gf-action-head">
          <span class="gf-action-icon is-primary"><i class="bi bi-truck"></i></span>
          <h5 class="gf-action-title">Flota</h5>
        </div>
        <p class="gf-action-text">Gestión de vehículos, documentos y asignación de choferes.</p>
        <%= link_to vehicles_path, class: "gf-action-link" do %>Ir a Vehículos <i class="bi bi-arrow-right"></i><% end %>
      </div>
    </div>

    <%# Módulo de Checklists (Configuración) %>
    <div class="col-md-4">
      <div class="gf-action-card">
        <div class="gf-action-head">
          <span class="gf-action-icon is-success"><i class="bi bi-clipboard-check"></i></span>
          <h5 class="gf-action-title">Plantillas Checklist</h5>
          <span class="gf-action-count"><%= pluralize(@templates_count, "plantilla") %></span>
        </div>
        <p class="gf-action-text">Configura las preguntas dinámicas que los choferes deben responder.</p>
        <%= link_to checklist_templates_path, class: "gf-action-link" do %>Gestionar Plantillas <i class="bi bi-arrow-right"></i><% end %>
      </div>
    </div>

    <%# Módulo de Auditoría (Submissions recientes) %>
    <div class="col-md-4">
      <div class="gf-action-card">
        <div class="gf-action-head">
          <span class="gf-action-icon is-warning"><i class="bi bi-shield-check"></i></span>
          <h5 class="gf-action-title">Auditoría Inspecciones</h5>
        </div>
        <p class="gf-action-text">Aprueba o rechaza los checklists completados por el equipo.</p>
        <%= link_to checklist_submissions_path, class: "gf-action-link" do %>Ver Todos los Envíos <i class="bi bi-arrow-right"></i><% end %>
      </div>
    </div>
  </div>

  <div class="row mt-4">
    <div class="col-12">
      <div class="card shadow-sm gf-card-round">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
          <h6 class="mb-0">Últimos Checklists Recibidos</h6>
          <%= link_to "Ver listado completo", checklist_submissions_path, class: "btn btn-sm btn-link text-decoration-none" %>
        </div>
        <div class="card-body p-0">
          <% if @recent_submissions.any? %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Plantilla</th>
                    <th>Vehículo</th>
                    <th>Chofer</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  <% @recent_submissions.each do |sub| %>
                    <tr>
                      <td class="fw-medium small"><%= sub.checklist_template.name %></td>
                      <td class="small"><%= sub.vehicle.plate %></td>
                      <td class="small text-muted"><%= sub.user.email %></td>
                      <td class="small"><%= l(sub.submitted_at, format: :short) %></td>
                      <td>
                        <% badge_class = case sub.status
                            when 'pending'  then 'text-bg-warning'
                            when 'approved' then 'text-bg-success'
                            when 'rejected' then 'text-bg-danger'
                            end %>
                        <span class="badge <%= badge_class %>">
                          <%= sub.status == 'pending' ? 'Pendiente' : sub.status == 'approved' ? 'Aprobado' : 'Rechazado' %>
                        </span>
                      </td>
                      <td class="text-end">
                        <%= link_to "Revisar", sub, class: "btn btn-sm btn-outline-primary" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-4 text-muted">
              No hay envíos recientes.
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>