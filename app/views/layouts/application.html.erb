      <div class="app-header-right">
        <%# Campana de notificaciones %>
        <%= link_to notifications_path, class: "app-header-bell" do %>
          <i class="fa-solid fa-bell"></i>
          <% if current_user.notifications.unread.any? %>
            <span class="bell-badge"><%= current_user.notifications.unread.count %></span>
          <% end %>
        <% end %>

        <%# Badge de rol %>
        <% role_class = current_user.role.to_s %>
        <span class="role-badge <%= role_class %>">
          <% role_icons = { "admin" => "fa-user-gear", "chofer" => "fa-truck", "mecanico" => "fa-wrench", "analista" => "fa-chart-column", "superadmin" => "fa-shield", "bodeguero" => "fa-boxes-stacked" } %>
          <i class="fa-solid <%= role_icons[role_class] || 'fa-user' %>"></i>
          <%= role_label(current_user.role) %>
        </span>

        <%# Email del usuario %>
        <span class="app-header-user"><%= current_user.email %></span>

        <%# Botón salir %>
        <div data-controller="logout">
          <%= button_to destroy_user_session_path, method: :delete,
              data: { action: "click->logout#clearStorage" },
