<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <title><%= content_for?(:title) ? yield(:title) : "GestFlee — Gestión de Flota" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Sistema integral de gestión de flota vehicular.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" type="image/png" href="/icon-192.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta name="theme-color" content="#0e2240">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <%= stylesheet_link_tag "gestflee", "data-turbo-track": "reload" %>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>

    <script>
      /* Sidebar: collapsed state persists per browser; drawer on small screens.
         Runs once (head scripts aren't re-run on Turbo visits), so listeners are
         delegated on document and survive page changes. */
      (function () {
        var root = document.documentElement;
        try { if (localStorage.getItem("gfSidebar") === "collapsed") root.classList.add("gf-collapsed"); } catch (e) {}

        var isMobile = function () { return window.matchMedia("(max-width: 991.98px)").matches; };

        var syncCollapseButton = function () {
          var button = document.querySelector(".gf-sidebar-collapse");
          if (!button) return;
          var text = root.classList.contains("gf-collapsed") ? "Expandir menú" : "Contraer menú";
          button.title = text;
          button.setAttribute("aria-label", text);
          button.querySelector(".gf-nav-label").textContent = text;
        };

        document.addEventListener("click", function (event) {
          if (event.target.closest("[data-gf-sidebar-toggle]")) {
            if (isMobile()) {
              root.classList.toggle("gf-drawer-open");
            } else {
              var collapsed = root.classList.toggle("gf-collapsed");
              try { localStorage.setItem("gfSidebar", collapsed ? "collapsed" : "expanded"); } catch (e) {}
              syncCollapseButton();
            }
          } else if (event.target.closest("[data-gf-sidebar-close]")) {
            root.classList.remove("gf-drawer-open");
          }
        });

        document.addEventListener("turbo:load", syncCollapseButton);
        document.addEventListener("turbo:visit", function () { root.classList.remove("gf-drawer-open"); });
      })();

      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker.register("/service_worker.js");
        });
      }
    </script>
  </head>

  <% app_shell = user_signed_in? && !content_for?(:auth_page) %>
  <body class="<%= app_shell ? 'gf-app' : 'gf-public' %>">
    <% if app_shell %>
      <%= render "layouts/sidebar" %>
      <div class="gf-backdrop" data-gf-sidebar-close></div>

      <div class="gf-main">
        <%= render "layouts/topbar" %>

        <% if notice || alert %>
          <div class="gf-flash">
            <% if notice %>
              <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-circle-check"></i>
                <span><%= notice %></span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
              </div>
            <% end %>
            <% if alert %>
              <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-circle-exclamation"></i>
                <span><%= alert %></span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
              </div>
            <% end %>
          </div>
        <% end %>

        <main class="gf-content">
          <%= yield %>
        </main>
      </div>
    <% else %>
      <%= yield %>
    <% end %>
  </body>
</html>
