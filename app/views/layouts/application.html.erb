    <script>
      (function() {
        var SCROLL_KEY = 'gfNavScroll';

        function getNav()  { return document.getElementById('gfTabs'); }
        function getPrev() { return document.getElementById('gfNavPrev'); }
        function getNext() { return document.getElementById('gfNavNext'); }

        function updateArrows() {
          var nav = getNav();
          if (!nav) return;
          var atStart = nav.scrollLeft <= 4;
          var atEnd   = nav.scrollLeft + nav.clientWidth >= nav.scrollWidth - 4;
          var prev = getPrev(), next = getNext();
          var hasOverflow = nav.scrollWidth > nav.clientWidth + 8;
          if (prev) { prev.disabled = atStart;  prev.style.display = hasOverflow ? 'flex' : 'none'; }
          if (next) { next.disabled = atEnd;    next.style.display = hasOverflow ? 'flex' : 'none'; }
        }

        window.gfNavScroll = function(dir) {
          var nav = getNav();
          if (!nav) return;
          var firstTab = nav.querySelector('.gf-tab');
          var step = firstTab ? (firstTab.offsetWidth + 5) * 3 : 400;
          nav.scrollLeft += dir * step;
          setTimeout(updateArrows, 350);
        };

        /* Guardar posición ANTES de cada navegación Turbo */
        document.addEventListener('turbo:before-visit', function() {
          var nav = getNav();
          if (nav) sessionStorage.setItem(SCROLL_KEY, nav.scrollLeft);
        });

        function initNav() {
          var nav = getNav();
          if (!nav) return;

          /* 1. Restaurar posición previa (si existe) */
          var saved = parseFloat(sessionStorage.getItem(SCROLL_KEY) || '0');
          nav.scrollLeft = saved;

          /* 2. Solo ajustar si el tab activo quedó fuera del área visible */
          var active = nav.querySelector('.gf-tab.active');
          if (active) {
            var navLeft  = nav.scrollLeft;
            var navRight = navLeft + nav.clientWidth;
            var tabLeft  = active.offsetLeft;
            var tabRight = tabLeft + active.offsetWidth;

            if (tabLeft < navLeft) {
              /* Oculto por la izquierda → traerlo al borde izquierdo */
              nav.scrollLeft = tabLeft - 8;
            } else if (tabRight > navRight) {
              /* Oculto por la derecha → traerlo al borde derecho */
              nav.scrollLeft = tabRight - nav.clientWidth + 8;
            }
            /* Ya visible → no mover */
          }

          nav.removeEventListener('scroll', updateArrows);
          nav.addEventListener('scroll', updateArrows);
          updateArrows();
        }

        document.addEventListener('DOMContentLoaded', initNav);
        document.addEventListener('turbo:load', initNav);
      })();
    </script>

    <%# ── FLASH MESSAGES ── %>
    <% if (notice || alert) && !devise_controller? %>
      <div class="gf-flash">
        <% if notice %>
          <div class="gf-flash-notice">
            <i class="fa-solid fa-circle-check"></i> <%= notice %>
          </div>
        <% end %>
        <% if alert %>
          <div class="gf-flash-alert">
            <i class="fa-solid fa-circle-exclamation"></i> <%= alert %>
          </div>
        <% end %>
