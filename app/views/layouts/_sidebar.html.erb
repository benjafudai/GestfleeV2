<aside class="gf-sidebar" aria-label="Navegación principal">
  <%= link_to dashboard_path, class: "gf-sidebar-brand" do %>
    <span class="gf-brand-mark"><i class="fa-solid fa-truck-fast"></i></span>
    <span class="gf-brand-text">
      <span class="gf-brand-name">GestFlee</span>
      <span class="gf-brand-sub">Gestión de Flota</span>
    </span>
  <% end %>

  <nav class="gf-sidebar-nav">
    <% sidebar_sections.each do |section| %>
      <div class="gf-nav-section">
        <% if section[:title] %>
          <div class="gf-nav-title"><%= section[:title] %></div>
        <% end %>
        <% section[:items].each do |item| %>
          <% active = nav_item_active?(item) %>
          <%= link_to item[:path],
                class: ["gf-nav-link", ("active" if active), ("is-#{item[:tone]}" if item[:tone])].compact.join(" "),
                title: item[:label],
                "aria-current": (active ? "page" : nil) do %>
            <i class="fa-solid <%= item[:icon] %> fa-fw"></i>
            <span class="gf-nav-label"><%= item[:label] %></span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </nav>

  <button type="button" class="gf-sidebar-collapse" data-gf-sidebar-toggle title="Contraer menú" aria-label="Contraer menú">
    <i class="fa-solid fa-angles-left fa-fw"></i>
    <span class="gf-nav-label">Contraer menú</span>
  </button>
</aside>
