<% companies = @companies.to_a %>
<% counts = company_counts(companies) %>
<div class="container mt-4" data-controller="delete-confirmation">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0"><i class="bi bi-buildings me-2"></i>Empresas</h1>
      <p class="text-muted mb-0">Empresas que usan GestFlee, con sus módulos y configuración.</p>
    </div>
    <%= link_to new_company_path, class: "btn btn-primary text-nowrap" do %>
      <i class="bi bi-plus-lg me-1"></i>Nueva empresa
    <% end %>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <%= form_with url: companies_path, method: :get, class: "row g-3 align-items-end" do |f| %>
        <div class="col-md-6 col-lg-5">
          <%= f.label :query, "Buscar", class: "form-label" %>
          <%= f.text_field :query, value: params[:query], placeholder: "Nombre o RUT de la empresa", class: "form-control" %>
        </div>
        <div class="col-md-auto d-flex gap-2">
          <%= button_tag type: "submit", name: nil, class: "btn btn-outline-primary text-nowrap flex-fill" do %>
            <i class="bi bi-search me-1"></i>Buscar
          <% end %>
          <% if params[:query].present? %>
            <%= link_to companies_path, class: "btn btn-outline-secondary text-nowrap flex-fill" do %>
              <i class="bi bi-x-lg me-1"></i>Limpiar
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <% if companies.any? %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
      <% companies.each do |company| %>
        <div class="col">
          <div class="card h-100">
            <div class="card-body d-flex flex-column gap-3">
              <div class="d-flex align-items-center gap-3">
                <span class="gf-action-icon is-primary"><i class="bi bi-building"></i></span>
                <div class="min-w-0">
                  <h2 class="h6 fw-bold mb-0 text-truncate" title="<%= company.name %>"><%= company.name %></h2>
                  <div class="small text-muted">RUT <%= company.rut %></div>
                </div>
              </div>

              <div class="d-flex flex-wrap column-gap-3 row-gap-1 small text-muted">
                <span class="text-nowrap"><i class="bi bi-people me-1"></i><%= pluralize(counts[:users].fetch(company.id, 0), "usuario", plural: "usuarios") %></span>
                <span class="text-nowrap"><i class="bi bi-truck me-1"></i><%= pluralize(counts[:vehicles].fetch(company.id, 0), "vehículo", plural: "vehículos") %></span>
                <span class="text-nowrap"><i class="bi bi-fuel-pump me-1"></i>Alerta de consumo: <%= company.anomaly_threshold %> %</span>
              </div>

              <div>
                <div class="small text-muted mb-1">Módulos</div>
                <div class="d-flex flex-wrap gap-1">
                  <% CompaniesHelper::COMPANY_MODULES.each do |mod| %>
                    <%= company_module_pill(company, mod) %>
                  <% end %>
                </div>
              </div>
            </div>
            <div class="card-footer bg-white d-flex gap-2">
              <%= link_to edit_company_path(company), class: "btn btn-sm btn-outline-primary flex-fill text-nowrap" do %>
                <i class="bi bi-gear me-1"></i>Configurar
              <% end %>
              <button type="button"
                      class="btn btn-sm btn-outline-danger text-nowrap"
                      data-bs-toggle="modal"
                      data-bs-target="#deleteConfirmationModal"
                      data-action="click->delete-confirmation#setDeleteTarget"
                      data-delete-confirmation-company-id-param="<%= company.id %>"
                      data-delete-confirmation-company-name-param="<%= company.name %>">
                <i class="bi bi-trash me-1"></i>Eliminar
              </button>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="card">
      <div class="card-body">
        <div class="text-center py-5 text-muted">
          <i class="bi bi-buildings d-block opacity-50"></i>
          <% if params[:query].present? %>
            <p class="mb-1 fw-bold text-body">No hay empresas que coincidan con «<%= params[:query] %>»</p>
            <p class="small mb-0">Revisa el nombre o el RUT, o <%= link_to "ve todas las empresas", companies_path %>.</p>
          <% else %>
            <p class="mb-1 fw-bold text-body">No hay empresas registradas</p>
            <p class="small mb-0">Registra la primera con el botón «Nueva empresa».</p>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Modal de confirmación para eliminar una empresa -->
  <div class="modal fade" id="deleteConfirmationModal" tabindex="-1" aria-labelledby="deleteConfirmationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title h5 d-flex align-items-center gap-2" id="deleteConfirmationModalLabel">
            <i class="bi bi-exclamation-octagon text-danger"></i>Eliminar empresa
          </h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
          <p>¿Seguro que quieres eliminar la empresa <strong data-delete-confirmation-target="companyNameDisplay"></strong>?</p>
          <div class="alert alert-warning d-flex gap-2 small">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1"></i>
            <div>Esta acción no se puede deshacer: se eliminarán todos sus <strong>usuarios, vehículos y datos asociados</strong>.</div>
          </div>
          <label class="form-label" for="delete_confirmation_input">Para confirmar, escribe <code>eliminar</code>:</label>
          <input type="text" class="form-control" id="delete_confirmation_input" autocomplete="off"
                 data-delete-confirmation-target="input"
                 data-action="input->delete-confirmation#checkInput keyup->delete-confirmation#checkInput keydown->delete-confirmation#handleEnter"
                 placeholder="eliminar">
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <%= form_with url: "", method: :delete, data: { delete_confirmation_target: "form" } do |f| %>
            <%= f.submit "Eliminar definitivamente", class: "btn btn-danger", disabled: true, data: { delete_confirmation_target: "button" } %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
