<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow">
        <div class="card-header bg-white">
          <h1 class="h4 mb-0">Configuración: <%= @company.name %></h1>
        </div>
        <div class="card-body">
          <%= form_with(model: @company, local: true) do |f| %>
            <% if @company.errors.any? %>
              <div class="alert alert-danger">
                <ul class="mb-0">
                  <% @company.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= f.label :name, "Nombre de la Empresa", class: "form-label" %>
              <%= f.text_field :name, class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :rut, "RUT", class: "form-label" %>
              <%= f.text_field :rut, class: "form-control" %>
            </div>

            <hr class="my-4">
            
            <h5 class="mb-3">Módulos Activos</h5>
            
            <div class="form-check mb-2">
              <%= f.check_box :has_mechanic, class: "form-check-input" %>
              <%= f.label :has_mechanic, "Habilitar Módulo de Mecánico", class: "form-check-label" %>
              <div class="form-text">Permite asignar roles de mecánico y gestionar mantenimientos.</div>
            </div>

            <div class="form-check mb-2">
              <%= f.check_box :has_analyst, class: "form-check-input" %>
              <%= f.label :has_analyst, "Habilitar Módulo de Analista", class: "form-check-label" %>
              <div class="form-text">Permite asignar roles de analista y ver reportes avanzados.</div>
            </div>

            <div class="form-check mb-4">
              <%= f.check_box :has_bodeguero, class: "form-check-input" %>
              <%= f.label :has_bodeguero, "Habilitar Módulo de Bodeguero", class: "form-check-label" %>
              <div class="form-text">Permite asignar roles de bodeguero para gestionar inventario y solicitudes de suministros.</div>
            </div>

            <h5 class="mb-3">Combustible y Eficiencia</h5>

            <div class="mb-4">
              <%= f.label :fuel_anomaly_threshold, "Umbral de Alerta de Consumo (%)", class: "form-label" %>
              <div class="input-group">
                <%= f.number_field :fuel_anomaly_threshold, value: @company.anomaly_threshold, class: "form-control", min: 1, max: 99 %>
                <span class="input-group-text">%</span>
              </div>
              <div class="form-text">Se generará una alerta si el rendimiento (km/l) de una carga es inferior a este porcentaje respecto al promedio histórico.</div>
            </div>

            <div class="d-flex justify-content-end gap-2">
              <%= link_to "Cancelar", companies_path, class: "btn btn-light" %>
              <%= f.submit "Guardar Cambios", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
