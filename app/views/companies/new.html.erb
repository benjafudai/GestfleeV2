<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-8">
      <div class="card shadow">
        <div class="card-header bg-white">
          <h1 class="h4 mb-0">Registrar Nueva Empresa</h1>
        </div>
        <div class="card-body">
          <%= form_with(model: @company, local: true) do |f| %>
            <% if @company.errors.any? %>
              <div class="alert alert-danger">
                <ul class="mb-0">
                  <% @company.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <h5 class="mb-3 text-primary">Datos de la Empresa</h5>
            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :name, "Nombre Empresa", class: "form-label" %>
                <%= f.text_field :name, class: "form-control", required: true, autofocus: true %>
              </div>
              <div class="col-md-6 mb-3">
                <%= f.label :rut, "RUT", class: "form-label" %>
                <%= f.text_field :rut, class: "form-control", required: true, placeholder: "77.777.777-7",
                    data: { controller: "mask", action: "input->mask#mask", mask_format: "99.999.999-#" } %>
              </div>
            </div>

            <hr class="my-4">
            
            <h5 class="mb-3 text-primary">Administrador Inicial</h5>
            <%= f.fields_for :users do |user_form| %>
              <%= user_form.hidden_field :role, value: 'admin' %>
              
              <div class="mb-3">
                <%= user_form.label :email, "Email del Administrador", class: "form-label" %>
                <%= user_form.email_field :email, class: "form-control", required: true %>
              </div>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <%= user_form.label :password, "Contraseña", class: "form-label" %>
                  <%= user_form.password_field :password, class: "form-control", required: true %>
                </div>
                <div class="col-md-6 mb-3">
                  <%= user_form.label :password_confirmation, "Confirmar Contraseña", class: "form-label" %>
                  <%= user_form.password_field :password_confirmation, class: "form-control", required: true %>
                </div>
              </div>
            <% end %>

            <hr class="my-4">

            <div class="d-flex justify-content-end gap-2">
              <%= link_to "Cancelar", companies_path, class: "btn btn-light" %>
              <%= f.submit "Crear Empresa", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
