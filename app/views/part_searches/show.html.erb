<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0"><i class="bi bi-search me-2"></i>Buscar repuesto</h1>
      <p class="text-muted mb-0">Revisa primero lo que hay en bodega y luego compara precios en tiendas.</p>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <%= form_with url: part_search_path, method: :get, local: true, class: "row g-3 align-items-end" do %>
        <div class="col-md-4">
          <%= label_tag :vehicle_id, "Vehículo (opcional)", class: "form-label" %>
          <%= select_tag :vehicle_id,
                options_for_select(@vehicles.map { |v| [[v.plate, v.brand, v.model, v.year].compact_blank.join(" · "), v.id] }, @vehicle&.id),
                include_blank: "Cualquier vehículo", class: "form-select" %>
        </div>
        <div class="col-md-6">
          <%= label_tag :q, "Repuesto", class: "form-label" %>
          <%= search_field_tag :q, @query, class: "form-control", placeholder: "Ej.: pastillas de freno, filtro de aceite", required: true %>
        </div>
        <div class="col-md-2 d-grid">
          <%= button_tag type: "submit", name: nil, class: "btn btn-primary" do %>
            <i class="bi bi-search me-1"></i>Buscar
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <% if @query.present? %>
    <% @parts.load %>
    <div class="row g-4">
      <div class="col-lg-7">
        <div class="card h-100">
          <div class="card-header bg-white d-flex justify-content-between align-items-center gap-2">
            <%= inventory_card_title("En tu bodega", icon: "bi-box-seam") %>
            <% if @parts.any? %>
              <span class="badge text-bg-secondary"><%= @parts.size == 1 ? "1 resultado" : "#{@parts.size} resultados" %></span>
            <% end %>
          </div>
          <% if @parts.any? %>
            <div class="list-group list-group-flush">
              <% @parts.each do |part| %>
                <% best = part.best_quote %>
                <%= link_to part_path(part), class: "list-group-item list-group-item-action py-3", style: "padding-inline: var(--bs-card-spacer-x);" do %>
                  <div class="d-flex justify-content-between align-items-start gap-3">
                    <div class="min-w-0">
                      <div class="fw-bold text-body"><%= part.name %></div>
                      <div class="small text-muted">SKU <%= part.sku %></div>
                      <% if @vehicle && part.part_fitments.any? { |f| f.vehicle_id == @vehicle.id } %>
                        <span class="badge text-bg-success mt-2"><i class="bi bi-check2 me-1"></i>Compatible con <%= @vehicle.plate %></span>
                      <% end %>
                    </div>
                    <div class="text-end flex-shrink-0">
                      <%= part_stock_badge(part.stock, prefix: "Stock", unit: part.unit_of_measure) %>
                      <% if best %>
                        <div class="small mt-2 text-body">Mejor precio: <strong><%= format_money(best.price, best.currency) %></strong></div>
                        <div class="small text-muted"><%= best.supplier %></div>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <div class="card-body">
              <div class="text-center py-4 px-3 text-muted">
                <i class="bi bi-box-seam d-block opacity-50"></i>
                <p class="mb-1 fw-bold text-body">No hay repuestos en el catálogo que coincidan con «<%= @query %>»</p>
                <p class="small mb-0">Prueba con otra palabra o el SKU, o búscalo en las tiendas.</p>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="col-lg-5">
        <div class="card h-100">
          <div class="card-header bg-white">
            <%= inventory_card_title("Comparar en tiendas", icon: "bi-shop") %>
          </div>
          <div class="card-body">
            <p class="small text-muted mb-3">Se busca: <strong class="text-body"><%= @external_query %></strong></p>
            <div class="d-grid gap-2">
              <% @stores.each do |store| %>
                <%= link_to store.url_for(@external_query), target: "_blank", rel: "noopener noreferrer", class: "btn btn-outline-primary d-flex align-items-center justify-content-between gap-2 text-start" do %>
                  <span><i class="bi bi-shop-window me-2"></i>Ver en <%= store.name %></span>
                  <i class="bi bi-box-arrow-up-right"></i>
                <% end %>
              <% end %>
            </div>
            <p class="small text-muted d-flex gap-2 mt-3 mb-0">
              <i class="bi bi-info-circle flex-shrink-0"></i>
              <span>Cuando un proveedor te dé un precio, regístralo en la ficha del repuesto para compararlo después.</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="card">
      <div class="card-body">
        <div class="text-center py-5 px-3 text-muted">
          <i class="bi bi-search d-block opacity-50"></i>
          <p class="mb-1 fw-bold text-body">Escribe qué repuesto necesitas</p>
          <p class="small mb-0">Si eliges un vehículo, verás cuáles le sirven y la búsqueda en tiendas incluirá su marca, modelo y año.</p>
        </div>
      </div>
    </div>
  <% end %>
</div>
