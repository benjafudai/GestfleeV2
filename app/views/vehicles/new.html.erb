<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-lg-10 col-xl-8">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="h3 mb-0"><i class="bi bi-truck-front me-2"></i>Nuevo vehículo</h1>
          <p class="text-muted mb-0">Regístralo con su patente, kilometraje y estado.</p>
        </div>
      </div>
      <div class="card">
        <div class="card-body p-4">
          <% if current_user.company.nil? %>
            <%# Superadmin en el panel global: no hay empresa a la que asociar el vehículo y guardar siempre fallaría. %>
            <div class="alert alert-info d-flex gap-2 mb-0" role="alert">
              <i class="bi bi-info-circle flex-shrink-0 mt-1"></i>
              <div>
                <p class="fw-bold mb-1">Esta cuenta no pertenece a una empresa</p>
                <p class="mb-0">Los vehículos se crean desde la cuenta de administrador de cada empresa, para que queden en su flota.</p>
              </div>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-4">
              <%= link_to vehicles_path, class: "btn btn-outline-secondary text-nowrap" do %>
                <i class="bi bi-arrow-left me-1"></i>Volver a la flota
              <% end %>
            </div>
          <% else %>
            <%= render "form", vehicle: @vehicle %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
