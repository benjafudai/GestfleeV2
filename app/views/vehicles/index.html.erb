<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3">Flota de Vehículos</h1>
    <% if policy(Vehicle).new? %>
      <%= link_to new_vehicle_path, class: "btn btn-primary" do %>
        <i class="bi bi-plus-lg"></i> Nuevo Vehículo
      <% end %>
    <% end %>
  </div>

  <div class="card shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover table-striped mb-0 align-middle">
          <thead class="table-light">
            <tr>
              <th scope="col">Patente</th>
              <th scope="col">Marca / Modelo</th>
              <th scope="col">Año</th>
              <th scope="col">Odómetro</th>
              <th scope="col">Estado</th>
              <th scope="col" class="text-end">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% @vehicles.each do |vehicle| %>
              <tr>
                <td class="fw-bold">
                  <%= link_to vehicle.plate, vehicle_path(vehicle), class: "text-decoration-none" %>
                </td>
                <td><%= vehicle.brand %> <%= vehicle.model %></td>
                <td><%= vehicle.year %></td>
                <td><%= number_with_delimiter(vehicle.odometer) %> km</td>
                <td>
                  <% badge_class = case vehicle.status
                     when 'active' then 'text-bg-success'
                     when 'maintenance' then 'text-bg-warning'
                     when 'inactive' then 'text-bg-secondary'
                     else 'text-bg-light'
                     end %>
                  <span class="badge <%= badge_class %> rounded-pill">
                    <%= vehicle.status.humanize %>
                  </span>
                </td>
                <td class="text-end">
                  <div class="btn-group btn-group-sm">
                    <%= link_to "Ver", vehicle_path(vehicle), class: "btn btn-outline-secondary" %>
                    
                    <% if policy(vehicle).edit? %>
                      <%= link_to "Editar", edit_vehicle_path(vehicle), class: "btn btn-outline-primary" %>
                    <% end %>

                    <% if policy(vehicle).destroy? %>
                      <%= button_to "Eliminar", vehicle_path(vehicle), method: :delete, form: { data: { turbo_confirm: "¿Estás seguro de eliminar este vehículo?" } }, class: "btn btn-outline-danger" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
            <% if @vehicles.empty? %>
              <tr>
                <td colspan="6" class="text-center py-5 text-muted">
                  No hay vehículos registrados aún.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
