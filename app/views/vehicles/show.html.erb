<% name = vehicle_name(@vehicle) %>
<% documents = @documents.with_attached_file.to_a %>
<% can_manage_docs = policy(VehicleDocument.new(vehicle: @vehicle)).create? %>
<% can_assign = policy(VehicleAssignment.new(vehicle: @vehicle)).create? %>
<% active = @vehicle.active_assignment %>
<% past = @vehicle.vehicle_assignments.historical.chronological.includes(:user) %>
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div class="min-w-0">
      <h1 class="h3 mb-0"><i class="bi bi-truck-front me-2"></i><%= @vehicle.plate %></h1>
      <p class="text-muted mb-0">
        <%= [name, @vehicle.year].compact_blank.join(" · ").presence || "Sin marca ni modelo registrados" %>
      </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <% if policy(@vehicle).edit? %>
        <%= link_to edit_vehicle_path(@vehicle), class: "btn btn-primary text-nowrap" do %>
          <i class="bi bi-pencil me-1"></i>Editar
        <% end %>
      <% end %>
      <%= link_to vehicles_path, class: "btn btn-outline-secondary text-nowrap" do %>
        <i class="bi bi-arrow-left me-1"></i>Volver
      <% end %>
    </div>
  </div>

  <div class="row g-4">
    <%# ─── Ficha del vehículo ─── %>
    <div class="col-xl-4">
      <div class="card">
        <div class="card-header bg-white d-flex justify-content-between align-items-center gap-2">
          <%= vehicle_card_title("Ficha del vehículo", icon: "bi-truck-front") %>
          <%= vehicle_status_badge(@vehicle) %>
        </div>
        <ul class="list-group list-group-flush">
          <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
            <span class="text-muted text-nowrap"><i class="bi bi-tag me-2"></i>Marca</span>
            <span class="fw-medium text-end"><%= vehicle_value_or_dash(@vehicle.brand) %></span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
            <span class="text-muted text-nowrap"><i class="bi bi-car-front me-2"></i>Modelo</span>
            <span class="fw-medium text-end"><%= vehicle_value_or_dash(@vehicle.model) %></span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
            <span class="text-muted text-nowrap"><i class="bi bi-calendar3 me-2"></i>Año</span>
            <span class="fw-medium text-end"><%= vehicle_value_or_dash(@vehicle.year) %></span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
            <span class="text-muted text-nowrap"><i class="bi bi-speedometer2 me-2"></i>Odómetro</span>
            <span class="fw-medium text-end"><%= vehicle_value_or_dash(vehicle_odometer(@vehicle)) %></span>
          </li>
          <% if @vehicle.hour_meter.present? %>
            <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
              <span class="text-muted text-nowrap"><i class="bi bi-clock-history me-2"></i>Horómetro</span>
              <span class="fw-medium text-end"><%= vehicle_hour_meter(@vehicle) %></span>
            </li>
          <% end %>
          <% if @vehicle.vehicle_model %>
            <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
              <span class="text-muted text-nowrap"><i class="bi bi-book me-2"></i>Modelo de la biblioteca</span>
              <span class="fw-medium text-end"><%= @vehicle.vehicle_model.label %></span>
            </li>
          <% end %>
          <% if current_user.superadmin? && @vehicle.company %>
            <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
              <span class="text-muted text-nowrap"><i class="bi bi-building me-2"></i>Empresa</span>
              <span class="fw-medium text-end"><%= @vehicle.company.name %></span>
            </li>
          <% end %>
        </ul>
        <%# En columna angosta (xl) los botones quedan uno bajo otro; a todo el ancho, lado a lado. %>
        <div class="card-body d-flex flex-wrap gap-2 border-top">
          <%= link_to vehicle_fuel_fills_path(@vehicle), class: "btn btn-outline-primary flex-fill text-nowrap" do %>
            <i class="bi bi-fuel-pump me-1"></i>Cargas de combustible
          <% end %>
          <% if @vehicle.vehicle_model && policy(@vehicle).generate_plan? %>
            <%= button_to generate_plan_vehicle_path(@vehicle), class: "btn btn-outline-primary w-100 text-nowrap", form_class: "button_to flex-fill",
                  form: { data: { turbo_confirm: "Se crearán los planes de mantención y los repuestos de #{@vehicle.vehicle_model.name}. Lo que ya exista no se toca. ¿Continuar?" } } do %>
              <i class="bi bi-magic me-1"></i>Crear plan desde la biblioteca
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-xl-8 d-flex flex-column gap-4">
      <%# ─── Documentación ─── %>
      <div class="card">
        <div class="card-header bg-white d-flex justify-content-between align-items-center gap-2">
          <%= vehicle_card_title("Documentación", icon: "bi-folder2-open", count: (documents.size if documents.any?)) %>
          <% if can_manage_docs %>
            <%= link_to new_vehicle_vehicle_document_path(@vehicle), class: "btn btn-sm btn-primary text-nowrap" do %>
              <i class="bi bi-plus-lg me-1"></i>Nuevo<span class="d-none d-sm-inline"> documento</span>
            <% end %>
          <% end %>
        </div>

        <% if documents.any? %>
          <ul class="list-group list-group-flush">
            <% documents.each do |doc| %>
              <li class="list-group-item d-flex align-items-center gap-3 py-3">
                <%= vehicle_document_icon_circle(doc, extra_class: "d-none d-sm-grid") %>
                <div class="flex-grow-1 min-w-0">
                  <div class="d-flex align-items-center flex-wrap gap-2">
                    <span class="fw-bold text-body"><%= vehicle_doc_type_label(doc.doc_type) %></span>
                    <%= vehicle_document_status_badge(doc) %>
                  </div>
                  <div class="small text-muted mt-1"><%= vehicle_document_due_text(doc) %></div>
                  <% if doc.notes.present? %>
                    <div class="small text-muted text-truncate" title="<%= doc.notes %>"><i class="bi bi-chat-left-text me-1"></i><%= doc.notes %></div>
                  <% end %>
                </div>
                <div class="gf-row-actions flex-shrink-0">
                  <% if doc.file.attached? %>
                    <%= link_to rails_blob_path(doc.file, disposition: "inline"), target: "_blank", rel: "noopener",
                                class: "btn btn-sm btn-outline-primary", title: "Ver PDF (#{doc.file.filename})", "aria-label": "Ver PDF" do %>
                      <i class="bi bi-file-earmark-pdf"></i>
                    <% end %>
                  <% end %>
                  <% if policy(doc).update? %>
                    <%= link_to edit_vehicle_vehicle_document_path(@vehicle, doc), class: "btn btn-sm btn-outline-secondary", title: "Editar", "aria-label": "Editar" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                  <% end %>
                  <% if policy(doc).destroy? %>
                    <%= button_to vehicle_vehicle_document_path(@vehicle, doc), method: :delete, class: "btn btn-sm btn-outline-danger", title: "Eliminar", "aria-label": "Eliminar",
                                  form: { data: { turbo_confirm: "¿Eliminar el documento «#{vehicle_doc_type_label(doc.doc_type)}»? Esta acción no se puede deshacer." } } do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  <% end %>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <div class="card-body">
            <div class="text-center py-5 text-muted">
              <i class="bi bi-file-earmark-x d-block opacity-50"></i>
              <p class="mb-1 fw-bold text-body">No hay documentos registrados</p>
              <p class="small mb-0">Agrega el permiso de circulación, la revisión técnica o el seguro para controlar sus vencimientos.</p>
              <% if can_manage_docs %>
                <%= link_to new_vehicle_vehicle_document_path(@vehicle), class: "btn btn-sm btn-outline-primary mt-3" do %>
                  <i class="bi bi-plus-lg me-1"></i>Agregar primer documento
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <%# ─── Chofer asignado ─── %>
      <div class="card">
        <div class="card-header bg-white d-flex justify-content-between align-items-center gap-2">
          <%= vehicle_card_title("Chofer asignado", icon: "bi-person-badge", tone: active ? "success" : "primary") %>
          <% if can_assign && active.nil? %>
            <%= link_to new_vehicle_vehicle_assignment_path(@vehicle), class: "btn btn-sm btn-primary text-nowrap" do %>
              <i class="bi bi-person-plus me-1"></i>Asignar chofer
            <% end %>
          <% end %>
        </div>
        <div class="card-body">
          <% if active %>
            <div class="d-flex flex-wrap align-items-center gap-3 p-3 rounded-3 border border-success-subtle bg-success-subtle">
              <div class="d-flex align-items-center gap-3 flex-grow-1 min-w-0">
                <span class="gf-avatar gf-avatar-lg" aria-hidden="true"><%= active.user.email.to_s.first.to_s.upcase %></span>
                <div class="min-w-0">
                  <div class="fw-bold text-body text-break"><%= active.user.email %></div>
                  <div class="small text-muted"><%= vehicle_assignment_since(active.started_on) %></div>
                  <% if active.notes.present? %>
                    <div class="small text-muted fst-italic text-break"><i class="bi bi-chat-left-text me-1"></i><%= active.notes %></div>
                  <% end %>
                </div>
              </div>
              <% if policy(active).destroy? %>
                <%= button_to vehicle_vehicle_assignment_path(@vehicle, active), method: :delete,
                      class: "btn btn-sm btn-outline-danger text-nowrap", form_class: "button_to ms-auto",
                      form: { data: { turbo_confirm: "¿Terminar la asignación de #{active.user.email}?" } } do %>
                  <i class="bi bi-person-dash me-1"></i>Terminar asignación
                <% end %>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-4 text-muted">
              <i class="bi bi-person-x d-block opacity-50"></i>
              <p class="mb-1 fw-bold text-body">Sin chofer asignado</p>
              <p class="small mb-0">
                <% if can_assign %>
                  Usa «Asignar chofer» para entregarle este vehículo a un chofer.
                <% else %>
                  Este vehículo no tiene un chofer a cargo en este momento.
                <% end %>
              </p>
            </div>
          <% end %>

          <%# ─── Historial ─── %>
          <% if past.any? %>
            <h3 class="small text-muted text-uppercase fw-semibold mt-4 mb-2">Historial de asignaciones</h3>
            <div class="table-responsive border rounded-3">
              <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Chofer</th>
                    <th>Desde</th>
                    <th>Hasta</th>
                    <th>Notas</th>
                  </tr>
                </thead>
                <tbody>
                  <% past.each do |a| %>
                    <tr>
                      <td><%= a.user.email %></td>
                      <td class="text-nowrap"><%= l(a.started_on) %></td>
                      <td class="text-nowrap"><%= a.ended_on ? l(a.ended_on) : "—" %></td>
                      <td class="text-muted"><%= vehicle_value_or_dash(a.notes) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
