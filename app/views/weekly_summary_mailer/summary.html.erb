<% docs = @data[:documents] %>
<div style="font-family: 'Segoe UI', Helvetica, Arial, sans-serif; color: #1d2a3b; max-width: 560px; margin: 0 auto;">
  <div style="background: #0e2240; color: #ffffff; padding: 20px 24px; border-radius: 12px 12px 0 0;">
    <div style="font-size: 18px; font-weight: bold;">GestFlee</div>
    <div style="font-size: 13px; color: #a9bfdc;">Resumen semanal de <%= @summary.company.name %></div>
  </div>
  <div style="border: 1px solid #e2e7ee; border-top: 0; padding: 20px 24px; border-radius: 0 0 12px 12px;">
    <p style="margin: 0 0 14px;"><%= @summary.period_label %>. El detalle va en el PDF adjunto.</p>
    <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
      <tr>
        <td style="padding: 6px 0; color: #5f6e83;">Gasto de la semana</td>
        <td style="padding: 6px 0; text-align: right; font-weight: bold;"><%= format_money(@data[:expenses][:total_clp], "CLP") %></td>
      </tr>
      <tr>
        <td style="padding: 6px 0; color: #5f6e83;">Combustible</td>
        <td style="padding: 6px 0; text-align: right; font-weight: bold;"><%= number_with_precision(@data[:fuel][:liters], precision: 1, strip_insignificant_zeros: true, delimiter: ".", separator: ",") %> L</td>
      </tr>
      <tr>
        <td style="padding: 6px 0; color: #5f6e83;">Órdenes de trabajo abiertas</td>
        <td style="padding: 6px 0; text-align: right; font-weight: bold;"><%= @data[:work_orders][:open_count] %></td>
      </tr>
      <tr>
        <td style="padding: 6px 0; color: #5f6e83;">Documentos vencidos</td>
        <td style="padding: 6px 0; text-align: right; font-weight: bold; color: <%= docs[:expired].positive? ? '#d64545' : '#1d2a3b' %>;"><%= docs[:expired] %></td>
      </tr>
      <tr>
        <td style="padding: 6px 0; color: #5f6e83;">Documentos por vencer (30 días)</td>
        <td style="padding: 6px 0; text-align: right; font-weight: bold;"><%= docs[:expiring] %></td>
      </tr>
    </table>
    <p style="margin: 18px 0 0;">
      <a href="<%= root_url %>" style="display: inline-block; background: #1f6fd1; color: #ffffff; padding: 10px 18px; border-radius: 8px; text-decoration: none; font-weight: bold;">Abrir GestFlee</a>
    </p>
    <p style="margin: 18px 0 0; font-size: 12px; color: #5f6e83;">
      Recibes este correo porque eres administrador de <%= @summary.company.name %> en GestFlee o te agregaron a la lista del resumen.
      Un administrador puede apagarlo en «Resumen semanal».
    </p>
  </div>
</div>
