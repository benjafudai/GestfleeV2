<%# Comprobante de entrega, como el de Mercado Libre: quién recibió, cuándo y la foto. %>
<% if delivery.recipient_name %>
  <div class="card mb-4 <%= delivery.cancelled? ? 'border-secondary-subtle' : 'border-success' %>">
    <div class="card-body">
      <div class="row g-3 align-items-center">
        <div class="<%= delivery.photo.attached? ? 'col-md-7' : 'col-12' %>">
          <div class="d-flex align-items-start gap-3">
            <span class="d-inline-flex align-items-center justify-content-center flex-shrink-0 rounded-circle fs-4 lh-1 p-3
                         <%= delivery.cancelled? ? 'bg-secondary-subtle text-secondary-emphasis' : 'bg-success-subtle text-success-emphasis' %>" aria-hidden="true">
              <i class="bi bi-check2-circle"></i>
            </span>
            <div class="min-w-0">
              <div class="small text-uppercase fw-semibold <%= delivery.cancelled? ? 'text-muted' : 'text-success' %>">
                <%= delivery.cancelled? ? "Entrega anulada" : "Entregado" %>
              </div>
              <div class="h5 mb-1 text-break">Recibió <%= delivery.recipient_name %></div>
              <div class="text-muted small">
                <%= safe_join([ delivery.recipient_relation, ("RUT #{delivery.recipient_rut}" if delivery.recipient_rut) ].compact, " · ") %>
              </div>
              <div class="text-muted small mt-2">
                <i class="bi bi-clock me-1"></i><%= l(delivery.delivered_at, format: "%d/%m/%Y a las %H:%M") %>
                <% if delivery.driver %>
                  <span class="text-break"><i class="bi bi-person ms-2 me-1"></i><%= delivery.driver.email %></span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
        <% if delivery.photo.attached? %>
          <div class="col-md-5 text-md-end">
            <%= link_to rails_blob_path(delivery.photo, disposition: "inline"), target: "_blank", rel: "noopener", title: "Ver foto completa" do %>
              <%= image_tag rails_blob_path(delivery.photo, disposition: "inline"), class: "img-fluid rounded", style: "max-height: 280px",
                            alt: "Foto de la entrega a #{delivery.recipient_name}" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% else %>
  <div class="alert alert-light border small">
    <i class="bi bi-info-circle me-1"></i>Esta entrega se registró antes de que se pidiera quién recibe y la foto, así que no tiene comprobante.
  </div>
<% end %>
