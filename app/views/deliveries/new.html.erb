<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0"><i class="bi bi-truck me-2"></i>Nueva entrega</h1>
      <p class="text-muted mb-0">Anota a quién entregaste y qué productos. Al guardar, se descuentan del stock.</p>
    </div>
  </div>

  <%= form_with model: @delivery, url: deliveries_path, local: true, multipart: true do |f| %>
    <%= render "shared/form_errors", object: @delivery, subject: "la entrega" %>

    <div class="card mb-4">
      <div class="card-header bg-white"><%= inventory_card_title("Cliente", icon: "bi-person") %></div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-6">
            <%= f.label :customer, class: "form-label" do %>Cliente <span class="text-danger">*</span><% end %>
            <%= f.text_field :customer, class: "form-control", required: true, maxlength: 120 %>
          </div>
          <div class="col-md-6">
            <%= f.label :address, class: "form-label" do %>Dirección <span class="text-muted fw-normal">(opcional)</span><% end %>
            <%= f.text_field :address, class: "form-control", maxlength: 200 %>
          </div>
          <% if @drivers %>
            <div class="col-md-6">
              <%= f.label :driver_id, "Chofer que entregó", class: "form-label" %>
              <%= f.collection_select :driver_id, @drivers, :id, :email, { include_blank: "Sin chofer" }, { class: "form-select" } %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="card mb-4">
      <div class="card-header bg-white d-flex justify-content-between align-items-center gap-2">
        <%= inventory_card_title("Productos entregados", icon: "bi-box-seam") %>
        <button type="button" id="add-line" class="btn btn-sm btn-outline-primary text-nowrap"><i class="bi bi-plus-lg me-1"></i>Agregar</button>
      </div>
      <div class="card-body">
        <% if @products.empty? %>
          <div class="alert alert-warning mb-0">No hay productos con stock. Pide a bodega o al administrador que registre el stock en Productos.</div>
        <% else %>
          <div id="lines-container">
            <% @delivery.lines.each_with_index do |line, index| %>
              <%= render "line_fields", line: line, index: index, products: @products %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="card mb-4">
      <div class="card-header bg-white d-flex justify-content-between align-items-center gap-2">
        <%= inventory_card_title("Quién recibe", icon: "bi-person-check", tone: "success") %>
        <button type="button" id="same-customer" class="btn btn-sm btn-outline-success text-nowrap">Es el cliente</button>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-5">
            <%= f.label :recipient_name, class: "form-label" do %>Nombre de quien recibe <span class="text-danger">*</span><% end %>
            <%= f.text_field :recipient_name, class: "form-control", required: true, maxlength: 120, autocomplete: "off" %>
          </div>
          <div class="col-6 col-md-3">
            <%= f.label :recipient_rut, class: "form-label" do %>RUT <span class="text-muted fw-normal">(opcional)</span><% end %>
            <%= f.text_field :recipient_rut, class: "form-control", maxlength: 12, inputmode: "text", autocomplete: "off" %>
          </div>
          <div class="col-6 col-md-4">
            <%= f.label :recipient_relation, "Relación con el cliente", class: "form-label" %>
            <%= f.select :recipient_relation, Delivery::RECIPIENT_RELATIONS, { include_blank: "Elegir" }, { class: "form-select" } %>
          </div>
          <div class="col-12">
            <%= f.label :photo, class: "form-label" do %>Foto de la entrega <span class="text-danger">*</span><% end %>
            <%= f.file_field :photo, class: "form-control", accept: "image/*", capture: "environment", required: true %>
            <div class="form-text">
              Saca una foto de los productos entregados o de quien los recibe. Hasta 10 MB.
              <% if @delivery.errors.any? %><span class="text-danger">Si ya la sacaste, vuelve a sacarla.</span><% end %>
            </div>
            <img id="photo-preview" class="img-fluid rounded mt-2" style="max-height: 240px" alt="Vista previa de la foto" hidden>
          </div>
        </div>
      </div>
    </div>

    <div class="card mb-4">
      <div class="card-header bg-white"><%= inventory_card_title("Guía y notas", icon: "bi-receipt") %></div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-6">
            <%= f.label :receipt, class: "form-label" do %>Guía o factura <span class="text-muted fw-normal">(opcional)</span><% end %>
            <%= f.file_field :receipt, class: "form-control", accept: "image/*,application/pdf" %>
            <div class="form-text">Foto o PDF, hasta 10 MB.</div>
          </div>
          <div class="col-md-6">
            <%= f.label :notes, class: "form-label" do %>Notas <span class="text-muted fw-normal">(opcional)</span><% end %>
            <%= f.text_area :notes, rows: 2, class: "form-control", maxlength: 1000 %>
          </div>
        </div>
      </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
      <%= link_to "Cancelar", deliveries_path, class: "btn btn-outline-secondary" %>
      <%= f.submit "Registrar entrega", class: "btn btn-primary", disabled: @products.empty? %>
    </div>
  <% end %>
</div>

<template id="line-template">
  <%= render "line_fields", line: DeliveryLine.new, index: "NEW_INDEX", products: @products %>
</template>

<script>
  (function() {
    const sameCustomer = document.getElementById('same-customer');
    sameCustomer.addEventListener('click', function() {
      document.getElementById('delivery_recipient_name').value = document.getElementById('delivery_customer').value;
      document.getElementById('delivery_recipient_relation').value = 'Cliente';
    });

    const photo = document.getElementById('delivery_photo');
    const preview = document.getElementById('photo-preview');
    // Vista previa con data: URL, que la política de seguridad permite (blob: no).
    photo.addEventListener('change', function() {
      const file = photo.files[0];
      preview.hidden = true;
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function() { preview.src = reader.result; preview.hidden = false; };
      reader.readAsDataURL(file);
    });
  })();

  (function() {
    const container = document.getElementById('lines-container');
    const addBtn = document.getElementById('add-line');
    const tmpl = document.getElementById('line-template');
    if (!container) { if (addBtn) addBtn.hidden = true; return; }
    let index = <%= @delivery.lines.size %>;

    addBtn.addEventListener('click', function() {
      const wrapper = document.createElement('div');
      wrapper.innerHTML = tmpl.innerHTML.replace(/NEW_INDEX/g, index++);
      const line = wrapper.firstElementChild;
      container.appendChild(line);
      line.querySelector('select').focus();
    });

    container.addEventListener('change', function(e) {
      const select = e.target.closest('[data-line-product]');
      if (!select) return;
      const option = select.options[select.selectedIndex];
      select.closest('[data-line]').querySelector('[data-line-unit]').textContent = option.dataset.unit || '—';
    });

    container.addEventListener('click', function(e) {
      const btn = e.target.closest('[data-remove-line]');
      if (!btn) return;
      const lines = container.querySelectorAll('[data-line]');
      if (lines.length > 1) {
        btn.closest('[data-line]').remove();
      } else {
        btn.closest('[data-line]').querySelectorAll('select, input').forEach((field) => { field.value = ''; });
        btn.closest('[data-line]').querySelector('[data-line-unit]').textContent = '—';
      }
    });
  })();
</script>
