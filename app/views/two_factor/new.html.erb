<% content_for :title, "Verificación | GestFlee" %>
<style>
  html, body { height: 100%; margin: 0; padding: 0; }
  body { background: #f0f4fa; }

  .tf-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 20px;
  }

  .tf-card {
    width: 100%;
    max-width: 420px;
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 10px 40px rgba(12,27,58,0.10);
    padding: 40px 36px;
  }

  .tf-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 28px;
  }

  .tf-brand-icon {
    width: 38px;
    height: 38px;
    background: #0c1b3a;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #f97316;
    font-size: 1.05rem;
    flex-shrink: 0;
  }

  .tf-brand-name { font-size: 0.95rem; font-weight: 700; color: #0c1b3a; }

  .tf-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #0c1b3a;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }

  .tf-subtitle {
    font-size: 0.9rem;
    color: #64748b;
    line-height: 1.5;
    margin-bottom: 24px;
  }

  .tf-subtitle strong { color: #0c1b3a; }

  .tf-code-input {
    width: 100%;
    height: 58px;
    text-align: center;
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: 0.5em;
    color: #0c1b3a;
    background: #fff;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    outline: none;
    margin-bottom: 18px;
    transition: border-color 0.22s, box-shadow 0.22s;
  }

  .tf-code-input:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37,99,235,0.12);
  }

  .tf-remember {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 22px;
  }

  .tf-remember label { font-size: 0.85rem; color: #64748b; font-weight: 500; margin: 0; }

  .tf-btn {
    width: 100%;
    height: 50px;
    background: #0c1b3a;
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.22s;
  }

  .tf-btn:hover { background: #1a3260; }

  .tf-errors, .tf-notice {
    border-radius: 8px;
    padding: 11px 14px;
    font-size: 0.86rem;
    font-weight: 500;
    margin-bottom: 18px;
  }

  .tf-errors { background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; }
  .tf-notice { background: #eff6ff; border: 1px solid #bfdbfe; color: #1d4ed8; }

  .tf-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 20px;
    font-size: 0.82rem;
  }

  .tf-footer form { margin: 0; }

  .tf-footer a, .tf-resend-btn {
    color: #2563eb;
    font-weight: 600;
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    font-size: 0.82rem;
    cursor: pointer;
  }

  .tf-footer a:hover, .tf-resend-btn:hover { text-decoration: underline; }
</style>

<div class="tf-page">
  <div class="tf-card">
    <div class="tf-brand">
      <div class="tf-brand-icon"><i class="fa-solid fa-truck-fast"></i></div>
      <div class="tf-brand-name">GestFlee</div>
    </div>

    <h1 class="tf-title">Verifica tu identidad</h1>
    <p class="tf-subtitle">
      Enviamos un código de <%= User::OTP_LENGTH %> dígitos a <strong><%= @pending_user.masked_email %></strong>.
      Vence en <%= (User::OTP_VALID_FOR / 60).to_i %> minutos.
    </p>

    <% if flash[:alert] %>
      <div class="tf-errors">
        <i class="fa-solid fa-circle-exclamation" style="margin-right:6px;"></i><%= flash[:alert] %>
      </div>
    <% end %>
    <% if flash[:notice] %>
      <div class="tf-notice">
        <i class="fa-solid fa-circle-check" style="margin-right:6px;"></i><%= flash[:notice] %>
      </div>
    <% end %>

    <%= form_tag two_factor_path, method: :post do %>
      <input
        type="text"
        name="code"
        inputmode="numeric"
        pattern="[0-9]*"
        autocomplete="one-time-code"
        maxlength="<%= User::OTP_LENGTH %>"
        placeholder="<%= '·' * User::OTP_LENGTH %>"
        class="tf-code-input"
        autofocus
        required
      >

      <div class="tf-remember">
        <input type="checkbox" name="remember_device" value="1" id="remember_device" style="width:auto; accent-color:#2563eb;">
        <label for="remember_device">Confiar en este dispositivo por 30 días</label>
      </div>

      <button type="submit" class="tf-btn">
        <i class="fa-solid fa-shield-halved"></i> Verificar
      </button>
    <% end %>

    <div class="tf-footer">
      <%= button_to "Reenviar código", resend_two_factor_path, method: :post, class: "tf-resend-btn" %>
      <%= link_to "Volver a iniciar sesión", new_user_session_path %>
    </div>
  </div>
</div>
