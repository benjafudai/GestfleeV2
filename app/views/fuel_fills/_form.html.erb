<%= form_with(model: [@vehicle, @fuel_fill]) do |form| %>
  <% if @fuel_fill.errors.any? %>
    <div class="alert alert-danger">
      <h6 class="alert-heading fw-semibold mb-2"><%= pluralize(@fuel_fill.errors.count, "error", "errores") %> impidieron guardar el registro:</h6>
      <ul class="mb-0 small">
        <% @fuel_fill.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="alert alert-info d-flex align-items-center gap-2">
    <i class="bi bi-info-circle-fill"></i>
    <div><strong>Requerido:</strong> debes subir una fotografía de la boleta para registrar la carga.</div>
  </div>
  <div class="row g-3">
    <div class="col-md-6">
      <%= form.label :date, "Fecha de Carga", class: "form-label" %>
      <%= form.date_field :date, class: "form-control" %>
    </div>

    <div class="col-md-6">
      <%= form.label :odometer, "Odómetro (km)", class: "form-label" %>
      <%= form.number_field :odometer, class: "form-control", min: (@vehicle ? @vehicle.odometer : 0) %>
      <div class="form-text">Lectura actual del tablero.</div>
    </div>

    <div class="col-md-6">
      <%= form.label :liters, "Litros Cargados", class: "form-label" %>
      <div class="input-group">
        <%= form.number_field :liters, step: "0.01", class: "form-control" %>
        <span class="input-group-text">L</span>
      </div>
    </div>

    <div class="col-md-6">
      <%= form.label :cost, "Costo Total", class: "form-label" %>
      <div class="input-group">
        <span class="input-group-text">$</span>
        <%= form.number_field :cost, step: "0.01", class: "form-control" %>
      </div>
    </div>

    <div class="col-12">
      <%= form.label :ticket, "Subir Boleta/Factura (Foto)", class: "form-label" %>
      <%= form.file_field :ticket, accept: "image/*", capture: "environment", class: "form-control" %>
    </div>

    <div class="col-12">
      <%= form.label :notes, "Notas u Observaciones", class: "form-label" %>
      <%= form.text_area :notes, rows: 2, class: "form-control" %>
    </div>
  </div>

  <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
    <%= link_to "Cancelar", @vehicle ? vehicle_path(@vehicle) : root_path, class: "btn btn-outline-secondary" %>
    <%= form.submit "Guardar Carga", class: "btn btn-primary" %>
  </div>
<% end %>
