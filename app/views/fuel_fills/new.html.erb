<div class="container mt-4" style="max-width: 680px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div class="min-w-0">
      <h1 class="h3 mb-0"><i class="bi bi-fuel-pump me-2"></i>Registrar carga de combustible</h1>
      <% if @vehicle %>
        <p class="text-muted mb-0"><%= vehicle_identity(@vehicle) %></p>
      <% end %>
    </div>
  </div>

  <div class="card">
    <div class="card-body p-3 p-sm-4">
      <%= render "form", fuel_fill: @fuel_fill %>
    </div>
  </div>
</div>
