<div class="container mt-4" style="max-width: 640px;">
  <div class="mb-4">
    <h1 class="h3 fw-bold mb-1"><i class="bi bi-fuel-pump-fill me-2 text-primary"></i>Registrar Carga de Combustible</h1>
    <% if @vehicle %>
      <p class="text-muted mb-0">Patente: <strong><%= @vehicle.plate %></strong> — <%= @vehicle.brand %> <%= @vehicle.model %></p>
    <% end %>
  </div>

  <div class="card shadow-sm">
    <div class="card-body p-4">
      <%= render "form", fuel_fill: @fuel_fill %>
    </div>
  </div>
</div>
