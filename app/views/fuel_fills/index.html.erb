<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 fw-bold mb-1">
        <i class="bi bi-fuel-pump-fill me-2 text-primary"></i>
        <%= @vehicle ? "Registro de Combustible: #{@vehicle.plate}" : "Dashboard de Combustible" %>
      </h1>
      <p class="text-muted mb-0">Historial de cargas y eficiencia.</p>
    </div>
    <% fill_vehicle = @vehicle || (current_user.chofer? ? current_user.active_assignment&.vehicle : nil) %>
    <% if fill_vehicle && policy(FuelFill).new? %>
      <%= link_to new_vehicle_fuel_fill_path(fill_vehicle), class: "btn btn-primary" do %>
        <i class="bi bi-plus-lg me-1"></i> Nueva Carga
      <% end %>
    <% elsif current_user.chofer? %>
      <span class="text-muted small">No tienes un vehículo asignado para registrar carga de combustible.</span>
    <% end %>
  </div>

  <% if @vehicles %>
    <div class="card shadow-sm mb-4">
      <div class="card-body d-flex align-items-center gap-3 flex-wrap">
        <label for="vehicle_selector" class="form-label fw-semibold mb-0 text-nowrap">
          <i class="bi bi-truck-front me-1"></i> Ver gasto de combustible por vehículo
        </label>
        <select id="vehicle_selector" class="form-select" style="max-width: 320px;"
                onchange="if (this.value) { window.location.href = this.value }">
          <option value="<%= fuel_fills_path %>" <%= "selected" if @vehicle.nil? %>>Todos los vehículos</option>
          <% @vehicles.each do |v| %>
            <option value="<%= vehicle_fuel_fills_path(v) %>" <%= "selected" if @vehicle == v %>>
              <%= v.plate %> — <%= v.brand %> <%= v.model %>
            </option>
          <% end %>
        </select>
      </div>
    </div>
  <% end %>

  <% if @fuel_fills.any? %>
    <div class="row g-3 mb-4">
      <div class="col-6 col-lg-3">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <div class="text-muted small text-uppercase fw-semibold mb-1">Litros Totales</div>
            <div class="h4 fw-bold mb-0"><%= number_with_delimiter @total_liters.round(1) %> L</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <div class="text-muted small text-uppercase fw-semibold mb-1">Gasto Total</div>
            <div class="h4 fw-bold mb-0"><%= number_to_currency(@total_cost, unit: "$", precision: 0) %></div>
          </div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <div class="text-muted small text-uppercase fw-semibold mb-1">Precio Promedio / Litro</div>
            <div class="h4 fw-bold mb-0"><%= number_to_currency(@avg_price_per_liter, unit: "$", precision: 0) %></div>
          </div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <div class="text-muted small text-uppercase fw-semibold mb-1">
              <%= @vehicle ? "Rendimiento Promedio" : "Vehículo con Mayor Gasto" %>
            </div>
            <div class="h4 fw-bold mb-0">
              <% if @vehicle %>
                <%= @avg_km_per_liter ? "#{@avg_km_per_liter} km/l" : "--" %>
              <% else %>
                <%= @top_vehicle ? @top_vehicle.first : "--" %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="card shadow-sm mb-4">
      <div class="card-header bg-white">
        <h6 class="mb-0">Litros y Costo por Mes (últimos 6 meses)</h6>
      </div>
      <div class="card-body">
        <div style="height: 300px;">
          <canvas data-controller="fuel-chart"
                  data-fuel-chart-labels-value="<%= @chart_labels.to_json %>"
                  data-fuel-chart-liters-value="<%= @chart_liters.to_json %>"
                  data-fuel-chart-costs-value="<%= @chart_costs.to_json %>"></canvas>
        </div>
      </div>
    </div>
  <% end %>

  <div class="card shadow-sm">
    <div class="card-header bg-white">
      <h6 class="mb-0">Historial de Cargas</h6>
    </div>
    <div class="card-body p-0">
      <% if @fuel_fills.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Fecha</th>
                <% unless @vehicle %>
                  <th>Vehículo</th>
                <% end %>
                <th>Chofer</th>
                <th>Odómetro</th>
                <th>Litros / Costo</th>
                <th>Rendimiento (km/l)</th>
                <th class="text-end">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% @fuel_fills.each do |fill| %>
                <tr>
                  <td class="small"><%= l fill.date, format: :short %></td>
                  <% unless @vehicle %>
                    <td class="small">
                      <%= link_to fill.vehicle.plate, vehicle_fuel_fills_path(fill.vehicle) %>
                    </td>
                  <% end %>
                  <td class="small text-muted"><%= fill.user.email %></td>
                  <td class="small"><%= number_with_delimiter fill.odometer %> km</td>
                  <td class="small">
                    <%= fill.liters %>L
                    <span class="text-muted d-block"><%= fill.currency %> <%= number_to_currency(fill.cost, unit: "$", precision: fill.currency == 'CLP' ? 0 : 2) %></span>
                  </td>
                  <td>
                    <% if fill.km_per_liter.present? %>
                      <%
                        avg = FuelFill.where(vehicle: fill.vehicle).where.not(km_per_liter: nil).average(:km_per_liter).to_f
                        avg = fill.km_per_liter if avg == 0
                        threshold = (fill.company.anomaly_threshold.to_f / 100.0) rescue 0.2
                        lower_limit = avg * (1.0 - threshold)
                        upper_limit = avg * (1.0 + threshold)

                        badge_class = if fill.km_per_liter < lower_limit
                          "text-bg-danger"
                        elsif fill.km_per_liter > upper_limit
                          "text-bg-primary"
                        else
                          "text-bg-success"
                        end
                      %>
                      <span class="badge <%= badge_class %> rounded-pill"><%= fill.km_per_liter.round(2) %> km/l</span>
                    <% else %>
                      <span class="text-muted">--</span>
                    <% end %>
                  </td>
                  <td class="text-end">
                    <% if fill.ticket.attached? %>
                      <%= link_to "Boleta", rails_blob_path(fill.ticket, disposition: "inline"), target: "_blank", class: "btn btn-sm btn-outline-secondary" %>
                    <% end %>
                    <% if policy(fill).edit? %>
                      <%= link_to "Editar", edit_fuel_fill_path(fill), class: "btn btn-sm btn-outline-primary" %>
                    <% end %>
                    <% if policy(fill).destroy? %>
                      <%= button_to "Eliminar", fuel_fill_path(fill), method: :delete, data: { turbo_confirm: "¿Estás seguro?" }, class: "btn btn-sm btn-outline-danger", form_class: "d-inline" %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <%= render "shared/pagination", pagy: @pagy %>
      <% else %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-fuel-pump d-block mb-2 fs-3 opacity-50"></i>
          No hay registros de combustible aún.
        </div>
      <% end %>
    </div>
  </div>
</div>
