<%
  fill = @fuel_fill
  vehicle = fill.vehicle
  vehicle_average = FuelFill.where(vehicle: vehicle).where.not(km_per_liter: nil).average(:km_per_liter)
  threshold = (fill.company.anomaly_threshold.to_f / 100.0) rescue 0.2
  price_per_liter = fill.liters.to_f.positive? ? fill.cost / fill.liters : nil
  ticket_ready = fill.ticket.attached?
  vehicle_label = vehicle_name(vehicle)
%>
<div class="container mt-4" style="max-width: 1080px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div class="min-w-0">
      <h1 class="h3 mb-0"><i class="bi bi-fuel-pump me-2"></i>Carga de combustible #<%= fill.id %></h1>
      <p class="text-muted mb-0"><%= vehicle_identity(vehicle, extra: l(fill.date, format: :long)) %></p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <% if policy(fill).edit? %>
        <%= link_to edit_fuel_fill_path(fill), class: "btn btn-primary text-nowrap" do %>
          <i class="bi bi-pencil me-1"></i>Editar
        <% end %>
      <% end %>
      <%= link_to vehicle_fuel_fills_path(vehicle), class: "btn btn-outline-secondary text-nowrap" do %>
        <i class="bi bi-arrow-left me-1"></i>Volver al historial
      <% end %>
    </div>
  </div>

  <%# Mismo diseño de tarjeta que el panel de combustible y la flota: ícono al lado, compacto en el celular. %>
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-4">
      <div class="card h-100">
        <div class="card-body d-flex align-items-center gap-2 gap-sm-3">
          <%= vehicle_kpi_icon("bi-droplet-half", "primary") %>
          <div class="min-w-0">
            <div class="small text-muted">Litros<span class="d-none d-sm-inline"> cargados</span></div>
            <div class="h4 mb-0 text-nowrap"><%= number_with_precision(fill.liters, precision: 2, strip_insignificant_zeros: true, delimiter: ".") %> L</div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-4">
      <div class="card h-100">
        <div class="card-body d-flex align-items-center gap-2 gap-sm-3">
          <%= vehicle_kpi_icon("bi-cash-stack", "success") %>
          <div class="min-w-0">
            <div class="small text-muted">Costo total</div>
            <div class="h4 mb-0 text-nowrap"><%= format_money(fill.cost, fill.currency) %></div>
            <% if price_per_liter %>
              <div class="small text-muted"><%= format_money(price_per_liter, fill.currency) %> por litro</div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <div class="col-12 col-md-4">
      <div class="card h-100">
        <div class="card-body d-flex align-items-center gap-2 gap-sm-3">
          <%= vehicle_kpi_icon("bi-speedometer2", "info") %>
          <div class="min-w-0">
            <div class="small text-muted">Rendimiento estimado</div>
            <div class="h4 mb-1 text-nowrap">
              <%= fill.km_per_liter.present? ? "#{number_with_precision(fill.km_per_liter, precision: 2)} km/l" : "—" %>
            </div>
            <%= render "fuel_fills/efficiency", fill: fill, average: vehicle_average, threshold: threshold, variant: :hint %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4 align-items-start">
    <div class="col-lg-6">
      <div class="card">
        <div class="card-header bg-white">
          <h2 class="h6 mb-0">Datos de la carga</h2>
        </div>
        <ul class="list-group list-group-flush">
          <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
            <span class="text-muted text-nowrap">Vehículo</span>
            <span class="text-end">
              <%= link_to vehicle.plate, vehicle_fuel_fills_path(vehicle), class: "fw-bold" %>
              <% if vehicle_label %>
                <span class="text-muted">· <%= vehicle_label %></span>
              <% end %>
            </span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
            <span class="text-muted text-nowrap">Chofer</span>
            <span class="text-end text-break"><%= fill.user.email %></span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
            <span class="text-muted text-nowrap">Fecha de carga</span>
            <span class="text-end"><%= l fill.date, format: :long %></span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
            <span class="text-muted text-nowrap">Odómetro</span>
            <span class="text-end"><%= number_with_delimiter fill.odometer %> km</span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
            <span class="text-muted text-nowrap">Registrada el</span>
            <span class="text-end"><%= l fill.created_at, format: "%-d de %B de %Y, %H:%M" %></span>
          </li>
          <li class="list-group-item">
            <div class="text-muted mb-1">Notas</div>
            <% if fill.notes.present? %>
              <div class="text-break"><%= simple_format(fill.notes, class: "mb-0") %></div>
            <% else %>
              <div class="text-muted small">Sin notas.</div>
            <% end %>
          </li>
        </ul>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="card">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
          <h2 class="h6 mb-0">Boleta</h2>
          <% if ticket_ready %>
            <%= link_to rails_blob_path(fill.ticket, disposition: "inline"), target: "_blank", rel: "noopener",
                  class: "btn btn-sm btn-outline-primary text-nowrap" do %>
              <i class="bi bi-box-arrow-up-right me-1"></i>Ver archivo adjunto
            <% end %>
          <% end %>
        </div>
        <div class="card-body">
          <% if ticket_ready && fill.ticket.image? %>
            <%= link_to rails_blob_path(fill.ticket, disposition: "inline"), target: "_blank", rel: "noopener", title: "Abrir la boleta en tamaño completo" do %>
              <%= image_tag fill.ticket, alt: "Boleta de la carga ##{fill.id}", class: "d-block mx-auto img-fluid rounded border", style: "max-height: 520px;" %>
            <% end %>
          <% elsif ticket_ready %>
            <div class="text-center py-4 text-muted">
              <i class="bi bi-file-earmark-text d-block opacity-50"></i>
              <p class="mb-1 fw-bold text-body">Archivo adjunto</p>
              <p class="small mb-0">Ábrelo con el botón «Ver archivo adjunto».</p>
            </div>
          <% else %>
            <div class="text-center py-4 text-muted">
              <i class="bi bi-receipt d-block opacity-50"></i>
              <p class="mb-1 fw-bold text-body">Sin boleta adjunta</p>
              <p class="small mb-0">Esta carga no tiene una foto de respaldo.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
