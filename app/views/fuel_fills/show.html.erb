<div class="container mt-4" style="max-width: 720px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold mb-0"><i class="bi bi-fuel-pump-fill me-2 text-primary"></i>Detalle de Carga de Combustible</h1>
    <%= link_to vehicle_fuel_fills_path(@fuel_fill.vehicle), class: "btn btn-outline-secondary btn-sm" do %>
      <i class="bi bi-arrow-left me-1"></i> Volver al Historial
    <% end %>
  </div>

  <div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <h6 class="mb-0">Información de Carga</h6>
      <% if policy(@fuel_fill).edit? %>
        <%= link_to "Editar", edit_fuel_fill_path(@fuel_fill), class: "btn btn-sm btn-outline-primary" %>
      <% end %>
    </div>
    <ul class="list-group list-group-flush">
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <span class="text-muted">Vehículo</span>
        <span class="fw-medium"><%= @fuel_fill.vehicle.plate %> (<%= @fuel_fill.vehicle.model %>)</span>
      </li>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <span class="text-muted">Chofer</span>
        <span class="fw-medium"><%= @fuel_fill.user.email %></span>
      </li>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <span class="text-muted">Fecha de Carga</span>
        <span class="fw-medium"><%= l @fuel_fill.date, format: :long %></span>
      </li>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <span class="text-muted">Odómetro</span>
        <span class="fw-medium"><%= number_with_delimiter @fuel_fill.odometer %> km</span>
      </li>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <span class="text-muted">Cantidad y Costo</span>
        <span class="fw-medium">
          <%= @fuel_fill.liters %>L | <%= @fuel_fill.currency %> <%= number_to_currency(@fuel_fill.cost, unit: "$", precision: @fuel_fill.currency == 'CLP' ? 0 : 2) %>
        </span>
      </li>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <span class="text-muted">Rendimiento Estimado</span>
        <span class="fw-medium">
          <%= @fuel_fill.km_per_liter.present? ? "#{@fuel_fill.km_per_liter.round(2)} km/l" : "Dato insuficiente (primera carga)" %>
        </span>
      </li>
      <% if @fuel_fill.notes.present? %>
        <li class="list-group-item">
          <div class="text-muted small mb-1">Notas Adicionales</div>
          <div><%= @fuel_fill.notes %></div>
        </li>
      <% end %>
      <% if @fuel_fill.ticket.attached? %>
        <li class="list-group-item">
          <div class="text-muted small mb-2">Boleta / Respaldo</div>
          <%= link_to "Ver Archivo Adjunto", rails_blob_path(@fuel_fill.ticket, disposition: "inline"), target: "_blank", class: "btn btn-sm btn-outline-primary mb-2" %>
          <% if @fuel_fill.ticket.image? %>
            <div>
              <%= image_tag @fuel_fill.ticket, class: "img-fluid rounded border" %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</div>
