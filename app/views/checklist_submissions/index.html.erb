<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3">Checklists Pre-operativos</h1>
    <% if policy(ChecklistSubmission).create? %>
      <% if current_user.checklist_submissions.where(submitted_at: Time.current.all_day).exists? %>
        <button class="btn btn-secondary disabled" title="Ya completaste el checklist de hoy">
          <i class="bi bi-clipboard-check me-1"></i> Completado hoy
        </button>
      <% else %>
        <%= link_to new_checklist_submission_path, class: "btn btn-primary" do %>
          <i class="bi bi-clipboard-check me-1"></i> Completar Checklist
        <% end %>
      <% end %>
    <% end %>
  </div>

  <% if @submissions.any? %>
    <div class="card shadow-sm">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Plantilla</th>
                <th>Vehículo</th>
                <th>Chofer</th>
                <th>Fecha</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% @submissions.each do |sub| %>
                <tr>
                  <td class="fw-medium"><%= sub.checklist_template.name %></td>
                  <td><%= sub.vehicle.plate %></td>
                  <td class="small text-muted"><%= sub.user.email %></td>
                  <td class="small"><%= l(sub.submitted_at, format: :short) %></td>
                  <td>
                    <% badge_class = case sub.status
                        when 'pending'  then 'text-bg-warning'
                        when 'approved' then 'text-bg-success'
                        when 'rejected' then 'text-bg-danger'
                        end %>
                    <span class="badge <%= badge_class %>">
                      <%= sub.status == 'pending' ? 'Pendiente' : sub.status == 'approved' ? 'Aprobado' : 'Rechazado' %>
                    </span>
                  </td>
                  <td class="text-end">
                    <% if policy(sub).show? %>
                      <%= link_to "Ver", sub, class: "btn btn-sm btn-outline-primary" %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <%= render "shared/pagination", pagy: @pagy %>
  <% else %>
    <div class="text-center py-5">
      <i class="bi bi-clipboard-x display-4 text-muted opacity-50 d-block mb-3"></i>
      <p class="text-muted">No hay checklists registrados aún.</p>
      <% if policy(ChecklistSubmission).create? %>
        <% if current_user.checklist_submissions.where(submitted_at: Time.current.all_day).exists? %>
          <button class="btn btn-secondary disabled mt-2" title="Ya completaste el checklist de hoy">
            <i class="bi bi-clipboard-check me-1"></i> Completado hoy
          </button>
        <% else %>
          <%= link_to "Completar mi primer checklist", new_checklist_submission_path, class: "btn btn-primary mt-2" %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
