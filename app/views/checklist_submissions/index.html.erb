<% sees_team = !current_user.chofer? %>
<% can_create = policy(ChecklistSubmission).create? %>
<% done_today = can_create && current_user.checklist_submissions.where(submitted_at: Time.current.all_day).exists? %>
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0"><i class="bi bi-clipboard-check me-2"></i>Checklists preoperativos</h1>
      <p class="text-muted mb-0">
        <%= sees_team ? "Inspecciones que envían los choferes antes de operar el vehículo." : "Tu historial de checklists diarios." %>
      </p>
    </div>
    <% if can_create %>
      <% if done_today %>
        <button type="button" class="btn btn-outline-success text-nowrap" disabled title="Ya completaste el checklist de hoy">
          <i class="bi bi-check2-circle me-1"></i>Completado hoy
        </button>
      <% else %>
        <%= link_to new_checklist_submission_path, class: "btn btn-primary text-nowrap" do %>
          <i class="bi bi-clipboard-check me-1"></i>Completar checklist
        <% end %>
      <% end %>
    <% end %>
  </div>

  <% status_counts = policy_scope(ChecklistSubmission).group(:status).count %>
  <% if status_counts.values.sum.positive? %>
    <% tiles = [
         ["pending",  "bi-hourglass-split", "warning"],
         ["approved", "bi-check-circle",    "success"],
         ["rejected", "bi-x-circle",        "danger"]
       ] %>
    <div class="row g-2 g-md-3 mb-4">
      <% tiles.each do |status, icon, tone| %>
        <% count = status_counts[status].to_i %>
        <% label = checklist_status_count_label(status, count) %>
        <% tone = "secondary" unless count.positive? %>
        <div class="col-4">
          <div class="card h-100">
            <div class="card-body d-flex flex-column flex-md-row align-items-center gap-2 gap-md-3 p-3 text-center text-md-start">
              <span class="gf-action-icon bg-<%= tone %>-subtle text-<%= tone %>-emphasis" aria-hidden="true">
                <i class="bi <%= icon %>"></i>
              </span>
              <div class="min-w-0">
                <div class="fs-4 fw-bold lh-1"><%= number_with_delimiter(count) %></div>
                <div class="small text-muted mt-1"><%= label %></div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="card">
    <% if @submissions.any? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col">Fecha</th>
              <%# En celular la patente y el chofer pasan bajo la fecha, para que Estado y «Ver» quepan en pantalla. %>
              <th scope="col" class="d-none d-md-table-cell">Vehículo</th>
              <th scope="col">Estado</th>
              <% if sees_team %>
                <th scope="col" class="d-none d-md-table-cell">Chofer</th>
              <% end %>
              <th scope="col" class="d-none d-lg-table-cell">Plantilla</th>
              <th scope="col" class="text-end">
                <%# En celular basta con el ícono: el encabezado largo empujaba la columna fuera de la pantalla. %>
                <span class="d-none d-md-inline">Acciones</span><span class="visually-hidden d-md-none">Acciones</span>
              </th>
            </tr>
          </thead>
          <tbody>
            <% @submissions.each do |sub| %>
              <tr>
                <td class="text-nowrap">
                  <%= link_to l(sub.submitted_at.to_date), sub, class: "fw-bold" %>
                  <span class="small text-muted ms-1"><%= sub.submitted_at.strftime("%H:%M") %></span>
                  <div class="small text-muted d-md-none"><i class="bi bi-truck-front me-1"></i><%= sub.vehicle.plate %></div>
                  <% if sees_team %>
                    <div class="small text-muted d-md-none"><i class="bi bi-person me-1"></i><%= sub.user.email %></div>
                  <% end %>
                </td>
                <td class="fw-bold text-nowrap d-none d-md-table-cell"><%= sub.vehicle.plate %></td>
                <td><%= render "checklist_submissions/status_badge", status: sub.status %></td>
                <% if sees_team %>
                  <td class="text-muted text-nowrap d-none d-md-table-cell"><i class="bi bi-person me-1"></i><%= sub.user.email %></td>
                <% end %>
                <td class="d-none d-lg-table-cell"><%= sub.checklist_template.name %></td>
                <td class="text-end">
                  <% if policy(sub).show? %>
                    <div class="gf-row-actions">
                      <%= link_to sub, class: "btn btn-sm btn-outline-primary", title: "Ver", "aria-label": "Ver" do %>
                        <i class="bi bi-eye"></i>
                      <% end %>
                    </div>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="card-body">
        <div class="text-center py-5 text-muted">
          <i class="bi bi-clipboard-x d-block opacity-50"></i>
          <p class="mb-1 fw-bold text-body">No hay checklists registrados</p>
          <% if can_create %>
            <% if done_today %>
              <p class="small mb-0">Ya completaste el checklist de hoy.</p>
            <% else %>
              <p class="small mb-3">Completa tu primer checklist antes de salir con el vehículo.</p>
              <%= link_to new_checklist_submission_path, class: "btn btn-primary text-nowrap" do %>
                <i class="bi bi-clipboard-check me-1"></i>Completar mi primer checklist
              <% end %>
            <% end %>
          <% else %>
            <p class="small mb-0">Aquí aparecerán los checklists que envíen los choferes.</p>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
  <%= render "shared/pagination", pagy: @pagy %>
</div>
