<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-lg-9 col-xl-7">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div class="min-w-0">
          <h1 class="h3 mb-0"><i class="bi bi-file-earmark-plus me-2"></i>Nuevo documento</h1>
          <p class="text-muted mb-0 text-break">Documento personal de <%= @user.email %></p>
        </div>
      </div>
      <div class="card">
        <div class="card-body p-4">
          <%= render "form", user_document: @user_document %>
        </div>
      </div>
    </div>
  </div>
</div>
