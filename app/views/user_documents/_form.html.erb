<%= form_with(model: [@user, user_document], class: "space-y-6") do |form| %>
  <% if user_document.errors.any? %>
    <div class="bg-red-50 p-4 rounded-md">
      <div class="flex">
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            <%= pluralize(user_document.errors.count, "error") %> impidieron guardar este documento:
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% user_document.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div>
    <%= form.label :doc_type, "Tipo de Documento", class: "block text-sm font-medium text-gray-700" %>
    <div class="mt-1">
      <%= form.select :doc_type, UserDocument.doc_types.keys.map { |k| [k.titleize, k] }, { prompt: "Seleccione un tipo" }, class: "shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
    </div>
  </div>

  <div>
    <%= form.label :due_on, "Fecha de Vencimiento", class: "block text-sm font-medium text-gray-700" %>
    <div class="mt-1">
      <%= form.date_field :due_on, class: "shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
    </div>
  </div>

  <div>
    <%= form.label :file, "Archivo (PDF/Imagen)", class: "block text-sm font-medium text-gray-700" %>
    <div class="mt-1 flex items-center">
      <%= form.file_field :file, accept: "application/pdf,image/*", class: "shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
    </div>
  </div>

  <div>
    <%= form.label :notes, "Notas Adicionales", class: "block text-sm font-medium text-gray-700" %>
    <div class="mt-1">
      <%= form.text_area :notes, rows: 3, class: "shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
    </div>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to "Cancelar", user_path(@user), class: "bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
    <%= form.submit "Guardar Documento", class: "inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
  </div>
<% end %>
