<%= form_with(model: [@user, user_document]) do |form| %>
  <% if user_document.errors.any? %>
    <div class="alert alert-danger">
      <h6 class="alert-heading fw-semibold mb-2"><%= pluralize(user_document.errors.count, "error", "errores") %> impidieron guardar este documento:</h6>
      <ul class="mb-0 small">
        <% user_document.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :doc_type, "Tipo de Documento", class: "form-label" %>
    <%= form.select :doc_type, UserDocument.doc_types.keys.map { |k| [user_doc_type_label(k), k] }, { prompt: "Seleccione un tipo" }, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= form.label :due_on, "Fecha de Vencimiento", class: "form-label" %>
    <%= form.date_field :due_on, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :file, "Archivo (PDF/Imagen)", class: "form-label" %>
    <%= form.file_field :file, accept: "application/pdf,image/*", class: "form-control" %>
  </div>

  <div class="mb-4">
    <%= form.label :notes, "Notas Adicionales", class: "form-label" %>
    <%= form.text_area :notes, rows: 3, class: "form-control" %>
  </div>

  <div class="d-flex justify-content-end gap-2">
    <%= link_to "Cancelar", user_path(@user), class: "btn btn-outline-secondary" %>
    <%= form.submit "Guardar Documento", class: "btn btn-primary" %>
  </div>
<% end %>
