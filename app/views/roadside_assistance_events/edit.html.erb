<div class="container mt-4" style="max-width: 640px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold mb-0"><i class="bi bi-truck-front-fill me-2 text-primary"></i>Actualizar Estado de Emergencia</h1>
    <%= link_to "Volver", @event, class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <div class="card shadow-sm border-start border-4 border-primary">
    <div class="card-body p-4">
      <p class="text-muted small mb-4">
        Actualice el estado del reporte para mantener informados a los involucrados.
      </p>
      <%= render "form", event: @event %>
    </div>
  </div>
</div>
