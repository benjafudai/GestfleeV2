<div class="max-w-3xl mx-auto mt-6">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-bold dark:text-white">Actualizar Estado de Emergencia</h1>
    <%= link_to "Volver", @event, class: "text-blue-500 hover:text-blue-700" %>
  </div>

  <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6 border-l-4 border-blue-500">
    <p class="mb-4 text-sm text-gray-600 dark:text-gray-300">
      Actualice el estado del reporte para mantener informados a los involucrados.
    </p>
    <%= render "form", event: @event %>
  </div>
</div>
