<%= form_with(model: event, local: true, data: { controller: "geolocation pwa-sync", pwa_sync_target: "form" }) do |form| %>
  <% if event.errors.any? %>
    <div class="alert alert-danger">
      <h6 class="alert-heading fw-semibold mb-2"><%= pluralize(event.errors.count, "error", "errores") %> impidieron guardar:</h6>
      <ul class="mb-0 small">
        <% event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :vehicle_id, "Vehículo", class: "form-label" %>
    <%= form.collection_select :vehicle_id, Current.company.vehicles, :id, :plate, { prompt: "Selecciona el vehículo" }, class: "form-select" %>
  </div>

  <% if current_user.admin? || current_user.superadmin? || current_user.mecanico? %>
    <div class="mb-3">
      <%= form.label :status, "Estado", class: "form-label" %>
      <%= form.select :status, RoadsideAssistanceEvent.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "form-select" %>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :description, "Descripción de la Emergencia", class: "form-label" %>
    <%= form.text_area :description, rows: 4, class: "form-control", placeholder: "Ej. Se reventó un neumático, motor humeando..." %>
  </div>

  <div class="mb-3">
    <%= form.label :photos, "Evidencia (Fotos)", class: "form-label" %>
    <%= form.file_field :photos, multiple: true, accept: "image/*", class: "form-control" %>
  </div>

  <%= form.hidden_field :latitude, data: { geolocation_target: "latitude" } %>
  <%= form.hidden_field :longitude, data: { geolocation_target: "longitude" } %>

  <div class="d-flex align-items-center gap-2 mb-4">
    <button type="button" data-action="click->geolocation#locate" class="btn btn-sm btn-outline-secondary">
      <i class="bi bi-geo-alt me-1"></i>Capturar Mi Ubicación Actual
    </button>
    <span class="text-muted small" data-geolocation-target="statusMsg">Ubicación no capturada.</span>
  </div>

  <div class="pt-3 border-top">
    <%= form.submit(event.new_record? ? "Reportar Emergencia" : "Actualizar Estado", class: "btn btn-danger w-100 btn-lg") %>
  </div>
<% end %>
