<div class="max-w-4xl mx-auto mt-6">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-bold dark:text-white">Detalle de Emergencia: <%= @event.vehicle.plate %></h1>
    <div>
      <%= link_to "Volver", roadside_assistance_events_path, class: "text-gray-600 dark:text-gray-400 hover:underline mr-4" %>
      <% if policy(@event).update? %>
        <%= link_to "Actualizar Estado", edit_roadside_assistance_event_path(@event), class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
      <% end %>
    </div>
  </div>

  <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <h2 class="text-lg font-semibold mb-2 dark:text-white">Información del Evento</h2>
      <p class="text-gray-700 dark:text-gray-300 mb-1"><strong>Chofer:</strong> <%= @event.user.name || @event.user.email %></p>
      <p class="text-gray-700 dark:text-gray-300 mb-1"><strong>Fecha:</strong> <%= @event.created_at.strftime("%d/%m/%Y %H:%M") %></p>
      <p class="text-gray-700 dark:text-gray-300 mb-1"><strong>Estado actual:</strong> <%= @event.status.humanize %></p>
      
      <div class="mt-4">
        <strong>Descripción:</strong>
        <p class="mt-1 text-gray-800 dark:text-gray-200 p-3 bg-gray-50 dark:bg-gray-700 rounded border dark:border-gray-600">
          <%= @event.description %>
        </p>
      </div>
    </div>

    <div>
      <h2 class="text-lg font-semibold mb-2 dark:text-white">Ubicación</h2>
      <% if @event.latitude.present? && @event.longitude.present? %>
        <p class="text-gray-700 dark:text-gray-300 mb-2">
          Lat: <%= @event.latitude %>, Lon: <%= @event.longitude %>
        </p>
        <a href="https://www.google.com/maps/search/?api=1&query=<%= @event.latitude %>,<%= @event.longitude %>" target="_blank" rel="noopener noreferrer" class="inline-block bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded">
          Ver en Google Maps
        </a>
      <% else %>
        <p class="text-gray-500 italic">No se proporcionó ubicación exacta.</p>
      <% end %>
    </div>
  </div>

  <% if @event.photos.attached? %>
    <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6 mt-6">
      <h2 class="text-lg font-semibold mb-4 dark:text-white">Evidencia Fotográfica</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
        <% @event.photos.each do |photo| %>
          <div class="aspect-w-1 aspect-h-1 overflow-hidden rounded-lg border border-gray-200 dark:border-gray-700">
            <%= image_tag photo, class: "object-cover w-full h-full" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
