<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold mb-0"><i class="bi bi-truck-front-fill me-2 text-danger"></i>Auxilio en Ruta</h1>
    <% if policy(RoadsideAssistanceEvent).create? %>
      <%= link_to new_roadside_assistance_event_path, class: "btn btn-danger fw-semibold" do %>
        <i class="bi bi-exclamation-triangle-fill me-1"></i> Reportar Emergencia
      <% end %>
    <% end %>
  </div>

  <div class="card shadow-sm">
    <div class="card-body p-0">
      <% if @events.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Fecha</th>
                <th>Vehículo</th>
                <th>Chofer</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% @events.each do |event| %>
                <tr>
                  <td class="small"><%= event.created_at.strftime("%d/%m/%Y %H:%M") %></td>
                  <td class="small fw-medium"><%= event.vehicle.plate %></td>
                  <td class="small text-muted"><%= event.user.email %></td>
                  <td>
                    <% badge_class = case event.status
                         when 'solicitado' then 'text-bg-danger'
                         when 'en_camino'  then 'text-bg-warning'
                         when 'resuelto'   then 'text-bg-success'
                         else 'text-bg-secondary'
                         end %>
                    <span class="badge <%= badge_class %> rounded-pill"><%= event.status.humanize %></span>
                  </td>
                  <td class="text-end">
                    <%= link_to "Ver detalle", event, class: "btn btn-sm btn-outline-primary" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <%= render "shared/pagination", pagy: @pagy %>
      <% else %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-truck-front d-block mb-2 fs-3 opacity-50"></i>
          No hay eventos reportados.
        </div>
      <% end %>
    </div>
  </div>
</div>
