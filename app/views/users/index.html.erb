<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3">Gestión de Usuarios</h1>
    <%= link_to "Nuevo Usuario", new_user_path, class: "btn btn-primary" %>
  </div>

  <div class="card mb-4 shadow-sm">
    <div class="card-body">
      <%= form_with url: users_path, method: :get, class: "row g-3 align-items-end" do |f| %>
        <% if current_user.superadmin? %>
          <div class="col-md-4">
            <%= f.label :company_name, "Buscar por Empresa", class: "form-label" %>
            <%= f.text_field :company_name, value: params[:company_name], class: "form-control", placeholder: "Nombre de la empresa..." %>
          </div>
        <% end %>
        <div class="col-md-3">
          <%= f.label :role, "Filtrar por Rol", class: "form-label" %>
          <%= f.select :role, User.roles.keys.map { |r| [role_label(r), r] }, { include_blank: "Todos los roles", selected: params[:role] }, class: "form-select" %>
        </div>
        <div class="col-md-2">
           <%= f.submit "Filtrar", class: "btn btn-outline-dark w-100" %>
        </div>
        <div class="col-md-2">
           <%= link_to "Limpiar", users_path, class: "btn btn-link text-decoration-none" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>ID</th>
              <% if current_user.superadmin? %>
                <th>Empresa</th>
              <% end %>
              <th>Email</th>
              <th>Rol</th>
              <th>Fecha Registro</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% @users.each do |user| %>
              <tr>
                <td><%= user.id %></td>
                <% if current_user.superadmin? %>
                  <td>
                    <% if user.company %>
                      <%= user.company.name %>
                      <br>
                      <small class="text-muted"><%= user.company.rut %></small>
                    <% else %>
                      <span class="badge bg-secondary">Global (Sin Empresa)</span>
                    <% end %>
                  </td>
                <% end %>
                <td><%= user.email %></td>
                <td>
                  <span class="badge bg-<%= 
                    case user.role 
                    when 'superadmin' then 'danger'
                    when 'admin' then 'dark'
                    when 'chofer' then 'warning'
                    when 'analista' then 'info'
                    else 'secondary'
                    end 
                  %>">
                    <%= role_label(user.role) %>
                  </span>
                </td>
                <td><%= user.created_at.strftime("%d/%m/%Y") %></td>
                <td class="text-end">
                  <div class="btn-group" role="group">
                    <%= link_to "Ver Perfil / Documentos", user_path(user), class: "btn btn-sm btn-outline-primary" %>
                    <%= link_to "Editar", edit_user_path(user), class: "btn btn-sm btn-outline-secondary" %>
                    <% unless user == current_user %>
                      <%= button_to "Eliminar", user_path(user), method: :delete, data: { turbo_confirm: "¿Estás seguro?" }, class: "btn btn-sm btn-outline-danger" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
