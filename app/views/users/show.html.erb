<div class="container mt-4" style="max-width: 900px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold mb-0">Perfil de <%= @user.email %></h1>
    <%= link_to "Volver", users_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
      <h6 class="mb-0">Información del Usuario</h6>
    </div>
    <ul class="list-group list-group-flush">
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <span class="text-muted">Rol</span>
        <span class="fw-medium"><%= role_label(@user.role) %></span>
      </li>
      <% if @user.company %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <span class="text-muted">Empresa</span>
          <span class="fw-medium"><%= @user.company.name %></span>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <h6 class="mb-0">Documentos de Personal</h6>
      <% if policy(UserDocument).new? %>
        <%= link_to new_user_user_document_path(@user), class: "btn btn-sm btn-primary" do %>
          <i class="bi bi-plus-lg me-1"></i> Añadir Documento
        <% end %>
      <% end %>
    </div>

    <% if @user.user_documents.any? %>
      <ul class="list-group list-group-flush">
        <% @user.user_documents.each do |doc| %>
          <li class="list-group-item d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
              <p class="fw-medium mb-0"><%= user_doc_type_label(doc.doc_type) %></p>
              <p class="text-muted small mb-0">Vence: <%= l doc.due_on, format: :long %></p>
            </div>
            <div class="d-flex align-items-center gap-2">
              <% badge_class = case doc.status
                   when 'ok'       then 'text-bg-success'
                   when 'expiring' then 'text-bg-warning'
                   else 'text-bg-danger'
                   end %>
              <span class="badge <%= badge_class %> rounded-pill"><%= document_status_label(doc.status) %></span>

              <% if doc.file.attached? %>
                <%= link_to "Ver PDF", rails_blob_path(doc.file, disposition: "inline"), target: "_blank", class: "btn btn-sm btn-outline-secondary" %>
              <% end %>
              <% if policy(doc).edit? %>
                <%= link_to "Editar", edit_user_user_document_path(@user, doc), class: "btn btn-sm btn-outline-primary" %>
              <% end %>
              <% if policy(doc).destroy? %>
                <%= button_to "Eliminar", user_user_document_path(@user, doc), method: :delete, data: { turbo_confirm: "¿Estás seguro?" }, class: "btn btn-sm btn-outline-danger" %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="text-center py-5 text-muted">
        <i class="bi bi-file-earmark-x d-block mb-2 fs-3 opacity-50"></i>
        No hay documentos registrados para este usuario.
      </div>
    <% end %>
  </div>
</div>
