<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-lg-9 col-xl-7">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div class="min-w-0">
          <h1 class="h3 mb-0"><i class="bi bi-person-plus me-2"></i>Nuevo usuario</h1>
          <p class="text-muted mb-0">
            <% if current_user.superadmin? %>
              Crea una cuenta de acceso, asígnale un rol y su empresa.
            <% else %>
              Crea una cuenta de acceso para alguien de tu equipo y asígnale un rol.
            <% end %>
          </p>
        </div>
      </div>
      <div class="card">
        <div class="card-body p-4">
          <%= render "form", user: @user, available_roles: @available_roles %>
        </div>
      </div>
    </div>
  </div>
</div>
