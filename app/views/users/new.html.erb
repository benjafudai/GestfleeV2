<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow">
        <div class="card-header bg-white d-flex align-items-center gap-2">
          <%= link_to users_path, class: "text-muted text-decoration-none" do %>
            <i class="bi bi-arrow-left"></i>
          <% end %>
          <h1 class="h4 mb-0">Crear Nuevo Usuario</h1>
        </div>
        <div class="card-body">
          <%= form_with(model: @user, local: true, data: { turbo: false }) do |f| %>
            <% if @user.errors.any? %>
              <div class="alert alert-danger">
                <ul class="mb-0">
                  <% @user.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= f.label :email, "Correo Electrónico", class: "form-label fw-semibold" %>
              <%= f.email_field :email, class: "form-control", autofocus: true, required: true, placeholder: "usuario@empresa.cl" %>
            </div>

            <div class="mb-3">
              <%= f.label :role, "Rol", class: "form-label fw-semibold" %>
              <%= f.select :role, @available_roles.map { |r| [role_label(r), r] }, {}, class: "form-select", id: "user_role_select" %>
            </div>

            <% if current_user.superadmin? %>
              <div class="mb-3" id="company_field_wrapper">
                <%= f.label :company_id, "Empresa", class: "form-label fw-semibold" %>
                <%= f.collection_select :company_id, Company.order(:name), :id, :name, { prompt: "Sin empresa (Superadmin global)" }, class: "form-select" %>
                <div class="form-text text-muted">
                  Requerida para todos los roles excepto Super Administrador
                </div>
              </div>
            <% end %>

            <div class="mb-3">
              <%= f.label :password, "Contraseña Temporal", class: "form-label fw-semibold" %>
              <%= f.password_field :password, class: "form-control", required: true, minlength: 6 %>
              <div class="form-text text-muted">Mínimo 6 caracteres</div>
            </div>

            <div class="mb-4">
              <%= f.label :password_confirmation, "Confirmar Contraseña", class: "form-label fw-semibold" %>
              <%= f.password_field :password_confirmation, class: "form-control", required: true %>
            </div>

            <div class="d-flex justify-content-end gap-2">
              <%= link_to "Cancelar", users_path, class: "btn btn-light" %>
              <%= f.submit "Crear Usuario", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<% if current_user.superadmin? %>
  <script>
    function setupRoleCompanyToggle() {
      var roleSelect = document.getElementById('user_role_select');
      var companyWrapper = document.getElementById('company_field_wrapper');
      if (!roleSelect || !companyWrapper) return;

      function toggle() {
        var isSuperadmin = roleSelect.value === 'superadmin';
        companyWrapper.style.display = isSuperadmin ? 'none' : '';
      }

      roleSelect.addEventListener('change', toggle);
      toggle();
    }

    // Ejecutar tanto en carga normal como con Turbo
    document.addEventListener('DOMContentLoaded', setupRoleCompanyToggle);
    document.addEventListener('turbo:load', setupRoleCompanyToggle);
  </script>
<% end %>
