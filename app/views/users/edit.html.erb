<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-lg-9 col-xl-7">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div class="min-w-0">
          <h1 class="h3 mb-0"><i class="bi bi-pencil-square me-2"></i>Editar usuario</h1>
          <p class="text-muted mb-0 text-break"><%= @user.email_was.presence || @user.email %></p>
        </div>
      </div>
      <div class="card">
        <div class="card-body p-4">
          <% if can_edit_user?(@user) %>
            <%= render "form", user: @user, available_roles: @available_roles %>
          <% else %>
            <div class="text-center py-4 text-muted">
              <i class="bi bi-shield-lock d-block opacity-50"></i>
              <p class="mb-1 fw-bold text-body">Esta cuenta solo la puede modificar un superadministrador</p>
              <p class="small mb-0">Tiene rol <%= role_label(@user.role_was) %>. Si necesitas cambiar su correo o su rol, pídeselo al equipo de GestFlee.</p>
              <%= link_to user_path(@user), class: "btn btn-outline-secondary mt-3" do %>
                <i class="bi bi-arrow-left me-1"></i>Volver al usuario
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
