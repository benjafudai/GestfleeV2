<% override_for = ->(subject, key) { @overrides[[subject.class.name, subject.id, key]] } %>
<% company_on = ->(key) { override_for.(@company, key)&.enabled != false } %>
<% user_mode = ->(user, key) {
     o = override_for.(user, key)
     o.nil? ? "company" : (o.enabled ? "on" : "off")
   } %>
<% off_count = Feature.keys.count { |key| !company_on.(key) } %>

<div class="container mt-4" style="max-width: 1040px;">
  <div class="mb-3">
    <%= link_to companies_path, class: "text-decoration-none small" do %>
      <i class="bi bi-arrow-left me-1"></i>Volver a empresas
    <% end %>
  </div>

  <div class="mb-4">
    <h1 class="h3 mb-1"><i class="bi bi-toggles me-2"></i>Funciones de <%= @company.name %></h1>
    <p class="text-muted mb-0">
      Elige qué secciones usa esta empresa. Lo que desactives se esconde del menú y queda bloqueado,
      pero <strong>no se borra ningún dato</strong>: al volver a activarlo todo sigue ahí.
    </p>
  </div>

  <%= form_with url: company_features_path(@company), method: :patch do |f| %>
    <div class="card mb-4">
      <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 class="h6 mb-0"><i class="bi bi-building me-1"></i>Para toda la empresa</h2>
        <span class="small text-muted">
          <%= off_count.zero? ? "Todas las secciones activas" : "#{pluralize(off_count, 'sección desactivada', plural: 'secciones desactivadas')}" %>
        </span>
      </div>
      <div class="card-body">
        <p class="small text-muted mb-3">Vehículos, Dashboard y Usuarios siempre están activos porque el resto depende de ellos.</p>
        <div class="row g-4">
          <% Feature::SECTIONS.each do |section, features| %>
            <div class="col-md-6">
              <div class="small fw-bold text-uppercase text-muted mb-2"><%= section %></div>
              <% features.each do |key, info| %>
                <div class="form-check form-switch mb-2">
                  <%= hidden_field_tag "features[company][#{key}]", "off", id: nil %>
                  <%= check_box_tag "features[company][#{key}]", "on", company_on.(key),
                        id: "feature_company_#{key}", class: "form-check-input", role: "switch" %>
                  <label class="form-check-label" for="feature_company_<%= key %>">
                    <span class="fw-semibold"><%= info[:name] %></span>
                    <span class="d-block small text-muted"><%= info[:description] %></span>
                  </label>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="card mb-4">
      <div class="card-header bg-white">
        <h2 class="h6 mb-1"><i class="bi bi-person-gear me-1"></i>Excepciones por usuario</h2>
        <p class="small text-muted mb-0">
          Por defecto cada persona ve lo mismo que su empresa. Aquí puedes quitarle una sección a alguien
          o dársela aunque la empresa la tenga desactivada.
        </p>
      </div>
      <% if @users.any? %>
        <div class="list-group list-group-flush">
          <% @users.each do |user| %>
            <% exceptions = Feature.keys.count { |key| user_mode.(user, key) != "company" } %>
            <details class="list-group-item" <%= "open" if exceptions.positive? %>>
              <summary class="d-flex flex-wrap align-items-center gap-2 py-1" style="cursor: pointer;">
                <span class="fw-semibold text-break"><%= user.email %></span>
                <%= role_pill(user.role) %>
                <span class="ms-auto small <%= exceptions.positive? ? 'text-primary fw-semibold' : 'text-muted' %>">
                  <%= exceptions.zero? ? "Igual que la empresa" : pluralize(exceptions, "excepción", plural: "excepciones") %>
                </span>
              </summary>
              <div class="row g-3 pt-3 pb-2">
                <% Feature::SECTIONS.each do |section, features| %>
                  <div class="col-md-6 col-lg-3">
                    <div class="small fw-bold text-uppercase text-muted mb-2"><%= section %></div>
                    <% features.each do |key, info| %>
                      <label class="form-label small mb-1" for="feature_user_<%= user.id %>_<%= key %>"><%= info[:name] %></label>
                      <%= select_tag "features[users][#{user.id}][#{key}]",
                            options_for_select([
                              ["Igual que la empresa (#{company_on.(key) ? 'activa' : 'desactivada'})", "company"],
                              ["Activar para esta persona", "on"],
                              ["Quitar a esta persona", "off"]
                            ], user_mode.(user, key)),
                            id: "feature_user_#{user.id}_#{key}",
                            class: "form-select form-select-sm mb-2 #{'border-primary' unless user_mode.(user, key) == 'company'}" %>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </details>
          <% end %>
        </div>
      <% else %>
        <div class="card-body text-muted small">Esta empresa todavía no tiene usuarios.</div>
      <% end %>
    </div>

    <div class="d-flex justify-content-end gap-2 mb-5">
      <%= link_to "Cancelar", companies_path, class: "btn btn-outline-secondary" %>
      <%= f.button type: "submit", class: "btn btn-primary" do %>
        <i class="bi bi-check-lg me-1"></i>Guardar
      <% end %>
    </div>
  <% end %>
</div>
