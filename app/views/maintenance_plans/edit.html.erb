<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
          <li class="breadcrumb-item"><%= link_to "Planes de Mantenimiento", maintenance_plans_path, class: "text-decoration-none" %></li>
          <li class="breadcrumb-item"><%= link_to @maintenance_plan.name, @maintenance_plan, class: "text-decoration-none" %></li>
          <li class="breadcrumb-item active" aria-current="page">Editar</li>
        </ol>
      </nav>
      
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0"><i class="bi bi-pencil-square me-2"></i> Editar Plan de Mantenimiento</h1>
        <%= link_to @maintenance_plan, class: "btn btn-outline-secondary btn-sm shadow-sm" do %>
          <i class="bi bi-eye me-1"></i> Ver Plan
        <% end %>
      </div>

      <%= render "form", maintenance_plan: @maintenance_plan %>
    </div>
  </div>
</div>
