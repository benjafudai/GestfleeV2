<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div class="min-w-0">
      <h1 class="h3 mb-0"><i class="bi bi-clipboard-check me-2"></i>Editar plan de mantención</h1>
      <p class="text-muted mb-0"><%= @maintenance_plan.name_was.presence || @maintenance_plan.name %></p>
    </div>
    <%= link_to @maintenance_plan, class: "btn btn-outline-secondary text-nowrap" do %>
      <i class="bi bi-eye me-1"></i>Ver plan
    <% end %>
  </div>

  <%= render "form", maintenance_plan: @maintenance_plan %>
</div>
