<%= form_with(model: maintenance_plan, class: "needs-validation") do |form| %>
  <% if maintenance_plan.errors.any? %>
    <div class="alert alert-danger shadow-sm rounded-3">
      <h5 class="alert-heading fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Por favor corrija los siguientes errores:</h5>
      <ul class="mb-0">
        <% maintenance_plan.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
      <h5 class="fw-bold mb-0">Información General</h5>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-12">
          <%= form.label :name, "Nombre del Plan", class: "form-label fw-medium" %>
          <%= form.text_field :name, class: "form-control form-control-lg", required: true, placeholder: "Ej. Mantenimiento Preventivo 10K" %>
        </div>

        <div class="col-md-12">
          <%= form.label :description, "Descripción", class: "form-label fw-medium" %>
          <%= form.text_area :description, class: "form-control", rows: 3, placeholder: "Breve descripción de los objetivos del plan" %>
        </div>

        <div class="col-md-6">
          <%= form.label :interval_km, "Intervalo (Kilómetros)", class: "form-label fw-medium" %>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-speedometer2"></i></span>
            <%= form.number_field :interval_km, class: "form-control", placeholder: "Ej. 10000" %>
          </div>
          <div class="form-text">Cada cuántos kilómetros se debe realizar.</div>
        </div>

        <div class="col-md-6">
          <%= form.label :interval_days, "Intervalo (Días)", class: "form-label fw-medium" %>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-calendar3"></i></span>
            <%= form.number_field :interval_days, class: "form-control", placeholder: "Ej. 180" %>
          </div>
          <div class="form-text">Cada cuántos días se debe realizar si no se alcanza el kilometraje.</div>
        </div>

        <div class="col-md-6">
          <%= form.label :interval_hours, "Intervalo (Horas de uso)", class: "form-label fw-medium" %>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-hourglass-split"></i></span>
            <%= form.number_field :interval_hours, class: "form-control", placeholder: "Ej. 500" %>
          </div>
          <div class="form-text">Para maquinaria que se mide con horómetro.</div>
        </div>
      </div>
    </div>
  </div>

  <div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
      <h5 class="fw-bold mb-0">Pautas Técnicas (Tareas)</h5>
    </div>
    <div class="card-body" id="tasks-container">
      <% 
        # Si el plan es nuevo o no tiene tareas, pre-construimos 3 vacías.
        # Si ya tiene, mostramos las que tiene y talvez añadimos una vacía al final.
        tasks_to_show = maintenance_plan.maintenance_task_templates
        if tasks_to_show.empty?
          3.times { maintenance_plan.maintenance_task_templates.build }
        else
          maintenance_plan.maintenance_task_templates.build # Añadir una en blanco al editar
        end
      %>
      
      <%= form.fields_for :maintenance_task_templates do |task_form| %>
        <div class="task-row mb-3 p-3 bg-light rounded border position-relative">
          <div class="row g-2 align-items-center">
            <div class="col-md-8">
              <%= task_form.label :description, "Descripción de la Tarea", class: "form-label fw-medium visually-hidden" %>
              <%= task_form.text_field :description, class: "form-control", placeholder: "Ej. Cambio de Aceite 15W40" %>
            </div>
            <div class="col-md-3">
              <div class="input-group">
                <%= task_form.number_field :expected_duration_minutes, class: "form-control", placeholder: "Min." %>
                <span class="input-group-text"><i class="bi bi-stopwatch"></i></span>
              </div>
            </div>
            <% if task_form.object&.persisted? %>
               <div class="col-md-1 text-end">
                <div class="form-check d-inline-block">
                  <%= task_form.check_box :_destroy, class: "form-check-input" %>
                  <%= task_form.label :_destroy, "Eliminar", class: "form-check-label text-danger small pt-1" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
      
      <div class="form-text"><i class="bi bi-info-circle me-1"></i> Para agregar una tarea, simplemente escriba en uno de los espacios en blanco. Si está editando, siempre se muestra uno nuevo al final. Para eliminar, marque la casilla "Eliminar" y guarde.</div>
    </div>
  </div>

  <div class="d-flex justify-content-end gap-2 my-4">
    <%= link_to "Cancelar", maintenance_plans_path, class: "btn btn-light shadow-sm" %>
    <%= form.submit "Guardar Plan", class: "btn btn-primary shadow-sm px-4 fw-medium" %>
  </div>
<% end %>
