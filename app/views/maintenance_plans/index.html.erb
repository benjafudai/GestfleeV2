<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0"><i class="bi bi-clipboard-check me-2"></i>Planes de mantención</h1>
      <p class="text-muted mb-0">Pautas preventivas por kilometraje, horas de uso o tiempo.</p>
    </div>
    <% if policy(MaintenancePlan).create? %>
      <%= link_to new_maintenance_plan_path, class: "btn btn-primary text-nowrap" do %>
        <i class="bi bi-plus-lg me-1"></i>Nuevo plan
      <% end %>
    <% end %>
  </div>

  <div class="card">
    <% if @maintenance_plans.any? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Plan</th>
              <th>Frecuencia</th>
              <th>Tareas</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>
          <%# Un solo conteo agrupado para la columna Tareas (evita una consulta por plan). %>
          <% task_counts = MaintenanceTaskTemplate.unscope(:order).where(maintenance_plan_id: @maintenance_plans.map(&:id)).group(:maintenance_plan_id).count %>
          <tbody>
            <% @maintenance_plans.each do |plan| %>
              <tr>
                <td>
                  <div class="fw-bold"><%= plan.name %></div>
                  <% if plan.description.present? %>
                    <div class="small text-muted text-truncate d-none d-md-block" style="max-width: 26rem;" title="<%= plan.description %>"><%= plan.description %></div>
                  <% end %>
                </td>
                <td><%= maintenance_plan_interval_badges(plan) %></td>
                <td class="text-muted text-nowrap"><%= maintenance_plan_task_count(task_counts.fetch(plan.id, 0)) %></td>
                <td class="text-end">
                  <div class="gf-row-actions">
                    <%= link_to plan, class: "btn btn-sm btn-outline-primary", title: "Ver", "aria-label": "Ver" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <% if policy(plan).edit? %>
                      <%= link_to edit_maintenance_plan_path(plan), class: "btn btn-sm btn-outline-secondary", title: "Editar", "aria-label": "Editar" do %>
                        <i class="bi bi-pencil"></i>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="card-body">
        <div class="text-center py-5 text-muted">
          <i class="bi bi-clipboard-x d-block opacity-50"></i>
          <p class="mb-1 fw-bold text-body">No hay planes de mantención</p>
          <p class="small mb-0">
            <% if policy(MaintenancePlan).create? %>
              Crea el primero con el botón «Nuevo plan» o desde la ficha de un vehículo.
            <% else %>
              Cuando un administrador cree planes, aparecerán aquí.
            <% end %>
          </p>
        </div>
      </div>
    <% end %>
  </div>
  <%= render "shared/pagination", pagy: @pagy %>
</div>
