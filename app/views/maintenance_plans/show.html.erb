<% templates = @maintenance_plan.maintenance_task_templates.to_a %>
<% total_minutes = templates.sum { |t| t.expected_duration_minutes.to_i } %>
<% intervals = maintenance_plan_intervals(@maintenance_plan) %>
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div class="min-w-0">
      <h1 class="h3 mb-0"><i class="bi bi-clipboard-check me-2"></i><%= @maintenance_plan.name %></h1>
      <p class="text-muted mb-0">Plan de mantención<%= " · #{@maintenance_plan.vehicle_model.name}" if @maintenance_plan.vehicle_model %></p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <% if policy(@maintenance_plan).edit? %>
        <%= link_to edit_maintenance_plan_path(@maintenance_plan), class: "btn btn-primary text-nowrap" do %>
          <i class="bi bi-pencil me-1"></i>Editar
        <% end %>
      <% end %>
      <%= link_to maintenance_plans_path, class: "btn btn-outline-secondary text-nowrap" do %>
        <i class="bi bi-arrow-left me-1"></i>Volver
      <% end %>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-5">
      <div class="card">
        <div class="card-header bg-white">
          <%= maintenance_card_title("Información general", icon: "bi-info-circle") %>
        </div>
        <div class="card-body">
          <div class="small fw-bold text-muted mb-1">Descripción</div>
          <p class="mb-4 text-break"><%= @maintenance_plan.description.presence || tag.span("Sin descripción", class: "text-muted") %></p>

          <div class="small fw-bold text-muted mb-2">Frecuencia</div>
          <% if intervals.any? %>
            <div class="d-flex flex-column gap-2">
              <% intervals.each do |icon, text| %>
                <div class="d-flex align-items-center gap-2">
                  <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary-emphasis lh-1 p-2" aria-hidden="true"><i class="bi <%= icon %>"></i></span>
                  <span>Cada <strong><%= text %></strong></span>
                </div>
              <% end %>
            </div>
            <% if intervals.size > 1 %>
              <p class="small text-muted mt-2 mb-0">La mantención corresponde a lo que ocurra primero.</p>
            <% end %>
          <% else %>
            <p class="text-muted mb-0">Sin frecuencia definida.</p>
          <% end %>

          <% if @maintenance_plan.vehicle_model %>
            <div class="small fw-bold text-muted mt-4 mb-1">Modelo de la biblioteca</div>
            <p class="mb-0"><%= @maintenance_plan.vehicle_model.label %></p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-7">
      <div class="card">
        <div class="card-header bg-white d-flex justify-content-between align-items-center gap-2">
          <%= maintenance_card_title("Pautas técnicas", icon: "bi-list-check") %>
          <% if templates.any? %>
            <span class="small text-muted text-nowrap">
              <%= maintenance_plan_task_count(templates.size) %><%= " · #{maintenance_plan_duration(total_minutes)}" if total_minutes.positive? %>
            </span>
          <% end %>
        </div>
        <% if templates.any? %>
          <ol class="list-group list-group-flush">
            <% templates.each_with_index do |task, index| %>
              <li class="list-group-item d-flex align-items-start gap-3">
                <span class="badge text-bg-light flex-shrink-0 mt-1"><%= index + 1 %></span>
                <div class="flex-grow-1 min-w-0">
                  <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                    <span class="fw-bold text-break"><%= task.description %></span>
                    <% if task.expected_duration_minutes.present? %>
                      <span class="small text-muted text-nowrap"><i class="bi bi-stopwatch me-1"></i><%= maintenance_plan_duration(task.expected_duration_minutes) %></span>
                    <% end %>
                  </div>
                  <% if task.maintenance_task %>
                    <%= render "maintenance_plans/task_guide", template: task, vehicle_model: @maintenance_plan.vehicle_model %>
                  <% end %>
                </div>
              </li>
            <% end %>
          </ol>
        <% else %>
          <div class="card-body">
            <div class="text-center py-4 text-muted">
              <i class="bi bi-list-check d-block opacity-50"></i>
              <p class="mb-1 fw-bold text-body">Este plan aún no tiene tareas</p>
              <p class="small mb-0">
                <% if policy(@maintenance_plan).edit? %>
                  Agrégalas con el botón «Editar».
                <% else %>
                  Un administrador puede agregarlas al editar el plan.
                <% end %>
              </p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
