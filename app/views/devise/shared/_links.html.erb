<%# Enlaces estándar de Devise (las pantallas de GestFlee ponen los suyos; queda traducido por si se usa). %>
<%- if controller_name != 'sessions' %>
  <p class="mb-2"><%= link_to "Iniciar sesión", new_session_path(resource_name), class: "gf-auth-link" %></p>
<% end %>

<%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
  <p class="mb-2"><%= link_to "¿Olvidaste tu contraseña?", new_password_path(resource_name), class: "gf-auth-link" %></p>
<% end %>

<%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
  <p class="mb-2"><%= link_to "¿No recibiste las instrucciones de confirmación?", new_confirmation_path(resource_name), class: "gf-auth-link" %></p>
<% end %>

<%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
  <p class="mb-2"><%= link_to "¿No recibiste las instrucciones de desbloqueo?", new_unlock_path(resource_name), class: "gf-auth-link" %></p>
<% end %>

<%- if devise_mapping.omniauthable? %>
  <%- resource_class.omniauth_providers.each do |provider| %>
    <p class="mb-2"><%= button_to "Ingresar con #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "btn btn-outline-secondary w-100" %></p>
  <% end %>
<% end %>
