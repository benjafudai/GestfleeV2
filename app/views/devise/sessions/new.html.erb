<% content_for :title, "Acceso | GestFlee" %>

<div class="gf-auth">
  <div class="gf-auth-card">
    <section class="gf-auth-form">
      <div class="gf-auth-brand">
        <span class="gf-brand-mark"><i class="fa-solid fa-truck-fast"></i></span>
        <span>
          <span class="gf-brand-name">GestFlee</span>
          <span class="gf-brand-sub">Gestión de Flota</span>
        </span>
      </div>

      <h1 class="gf-auth-title">Iniciar sesión</h1>
      <p class="gf-auth-sub">Ingresa con tu cuenta para continuar.</p>

      <% if flash[:alert] %>
        <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
          <i class="fa-solid fa-circle-exclamation"></i> <span><%= flash[:alert] %></span>
        </div>
      <% end %>
      <% if flash[:notice] %>
        <div class="alert alert-success d-flex align-items-center gap-2" role="status">
          <i class="fa-solid fa-circle-check"></i> <span><%= flash[:notice] %></span>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="mb-3">
          <%= f.label :email, "Correo electrónico", class: "form-label" %>
          <div class="gf-input-icon">
            <i class="fa-regular fa-envelope"></i>
            <%= f.email_field :email, autofocus: true, autocomplete: "email",
                  placeholder: "nombre@empresa.cl", class: "form-control" %>
          </div>
        </div>

        <div class="mb-3">
          <div class="d-flex justify-content-between align-items-baseline">
            <%= f.label :password, "Contraseña", class: "form-label" %>
            <%= link_to "¿Olvidaste tu contraseña?", new_user_password_path, class: "gf-auth-link" %>
          </div>
          <div class="gf-input-icon">
            <i class="fa-solid fa-lock"></i>
            <%= f.password_field :password, autocomplete: "current-password",
                  placeholder: "Tu contraseña", class: "form-control" %>
          </div>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="form-check mb-4">
            <%= f.check_box :remember_me, class: "form-check-input" %>
            <%= f.label :remember_me, "Mantener la sesión iniciada", class: "form-check-label text-muted" %>
          </div>
        <% end %>

        <button type="submit" class="btn btn-primary w-100 gf-auth-submit">Ingresar</button>
      <% end %>

      <p class="gf-auth-foot">© <%= Date.current.year %> GestFlee · Sistema interno de flota</p>
    </section>

    <aside class="gf-auth-side">
      <h2>Toda tu flota en un solo lugar</h2>
      <p>Controla la operación diaria de tus vehículos desde una sola plataforma.</p>

      <ul class="gf-feature-list">
        <li>
          <span class="gf-feature-icon"><i class="fa-solid fa-clipboard-check"></i></span>
          <div><strong>Checklists diarios</strong><span>Inspecciones pre-operativas desde el celular.</span></div>
        </li>
        <li>
          <span class="gf-feature-icon"><i class="fa-solid fa-screwdriver-wrench"></i></span>
          <div><strong>Mantenimiento</strong><span>Órdenes de trabajo, planes e inventario de repuestos.</span></div>
        </li>
        <li>
          <span class="gf-feature-icon"><i class="fa-solid fa-gas-pump"></i></span>
          <div><strong>Combustible y costos</strong><span>Rendimiento por vehículo y gastos del mes.</span></div>
        </li>
        <li>
          <span class="gf-feature-icon"><i class="fa-solid fa-triangle-exclamation"></i></span>
          <div><strong>Incidentes</strong><span>Reportes desde la ruta con la ubicación del vehículo.</span></div>
        </li>
      </ul>
    </aside>
  </div>
</div>
