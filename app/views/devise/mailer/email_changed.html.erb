<p>Hola, <%= @email %>:</p>

<% if @resource.try(:unconfirmed_email?) %>
  <p>Te escribimos para avisarte que el correo de tu cuenta de GestFlee se está cambiando a <%= @resource.unconfirmed_email %>.</p>
<% else %>
  <p>Te escribimos para avisarte que el correo de tu cuenta de GestFlee se cambió a <%= @resource.email %>.</p>
<% end %>
