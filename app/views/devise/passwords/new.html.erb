<% content_for :title, "Recuperar contraseña · GestFlee" %>

<div class="gf-auth">
  <div class="gf-auth-card is-narrow">
    <section class="gf-auth-form">
      <%= render "devise/shared/auth_brand" %>

      <span class="gf-action-icon is-primary mb-3" aria-hidden="true"><i class="bi bi-key-fill"></i></span>
      <h1 class="gf-auth-title">Recuperar contraseña</h1>
      <p class="gf-auth-sub">Ingresa tu correo y avisaremos al equipo de GestFlee para que restablezca tu acceso.</p>

      <%= render "devise/shared/auth_flash" %>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="mb-4">
          <%= f.label :email, "Correo electrónico", class: "form-label" %>
          <div class="gf-input-icon">
            <i class="bi bi-envelope-fill" aria-hidden="true"></i>
            <%= f.email_field :email, autofocus: true, autocomplete: "email",
                  placeholder: "nombre@empresa.cl", class: "form-control" %>
          </div>
          <div class="form-text">Usa el mismo correo con el que inicias sesión.</div>
        </div>

        <%= f.submit "Solicitar recuperación", class: "btn btn-primary w-100 gf-auth-submit" %>
      <% end %>

      <p class="gf-auth-foot">
        <%= link_to new_session_path(resource_name), class: "gf-auth-link" do %>
          <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Volver al inicio de sesión
        <% end %>
      </p>
    </section>
  </div>
</div>
