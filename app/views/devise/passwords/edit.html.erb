<% content_for :title, "Nueva contraseña · GestFlee" %>
<% min_length = @minimum_password_length || resource_class.password_length.min %>

<div class="gf-auth">
  <div class="gf-auth-card is-narrow">
    <section class="gf-auth-form">
      <%= render "devise/shared/auth_brand" %>

      <span class="gf-action-icon is-primary mb-3" aria-hidden="true"><i class="bi bi-shield-lock-fill"></i></span>
      <h1 class="gf-auth-title">Crea una nueva contraseña</h1>
      <p class="gf-auth-sub">Elige una contraseña que no uses en otros sitios.</p>

      <%= render "devise/shared/auth_flash" %>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div class="mb-3">
          <%= f.label :password, "Nueva contraseña", class: "form-label" %>
          <div class="gf-input-icon">
            <i class="bi bi-lock-fill" aria-hidden="true"></i>
            <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control",
                  placeholder: "Mínimo #{min_length} caracteres" %>
          </div>
        </div>

        <div class="mb-4">
          <%= f.label :password_confirmation, "Confirmar contraseña", class: "form-label" %>
          <div class="gf-input-icon">
            <i class="bi bi-lock-fill" aria-hidden="true"></i>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control",
                  placeholder: "Repite la contraseña" %>
          </div>
        </div>

        <%= f.submit "Guardar contraseña", class: "btn btn-primary w-100 gf-auth-submit" %>
      <% end %>

      <p class="gf-auth-foot">
        <%= link_to new_session_path(resource_name), class: "gf-auth-link" do %>
          <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Volver al inicio de sesión
        <% end %>
      </p>
    </section>
  </div>
</div>
