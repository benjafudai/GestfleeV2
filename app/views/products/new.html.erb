<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0"><i class="bi bi-box-seam me-2"></i>Nuevo producto</h1>
      <p class="text-muted mb-0">Agrega algo que la empresa vende o guarda, con su stock actual.</p>
    </div>
  </div>

  <% provide(:submit_text, "Guardar producto") %>
  <%= render "form", product: @product %>
</div>
