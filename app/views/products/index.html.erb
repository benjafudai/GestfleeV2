<% stock_value = products_stock_value(policy_scope(Product)) %>
<% filtered = params[:q].present? || params[:category].present? || params[:stock].present? %>
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center gap-2 mb-4">
    <div class="min-w-0">
      <h1 class="h3 mb-0"><i class="bi bi-boxes me-2"></i>Productos</h1>
      <p class="text-muted mb-0">El inventario de lo que vende o guarda la empresa. Cada empresa registra sus propios productos.</p>
    </div>
    <% if policy(Product).create? %>
      <%= link_to new_product_path, class: "btn btn-primary text-nowrap" do %>
        <i class="bi bi-plus-lg me-1"></i>Nuevo<span class="d-none d-sm-inline"> producto</span>
      <% end %>
    <% end %>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-4">
      <div class="card h-100">
        <div class="card-body d-flex align-items-center gap-3">
          <span class="gf-action-icon is-primary"><i class="bi bi-box-seam"></i></span>
          <div class="min-w-0">
            <div class="small text-muted">Productos</div>
            <div class="h4 mb-0"><%= number_with_delimiter(@summary[:total], delimiter: ".") %></div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-4">
      <%= link_to products_path(stock: "bajo"), class: "card h-100 text-decoration-none text-body" do %>
        <div class="card-body d-flex align-items-center gap-3">
          <% if @summary[:low_stock].positive? %>
            <span class="gf-action-icon is-warning"><i class="bi bi-exclamation-triangle"></i></span>
          <% else %>
            <span class="gf-action-icon is-success"><i class="bi bi-check2-circle"></i></span>
          <% end %>
          <div class="min-w-0">
            <div class="small text-muted">Bajo el mínimo</div>
            <div class="h4 mb-0"><%= number_with_delimiter(@summary[:low_stock], delimiter: ".") %></div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="col-12 col-lg-4">
      <div class="card h-100">
        <div class="card-body d-flex align-items-center gap-3">
          <span class="gf-action-icon is-success"><i class="bi bi-cash-stack"></i></span>
          <div class="min-w-0">
            <div class="small text-muted">Valor del inventario</div>
            <div class="h4 mb-0"><%= format_money(stock_value, "CLP") %></div>
            <div class="small text-muted">Stock por precio, en los productos con precio</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%= form_with url: products_path, method: :get, class: "card mb-3", data: { turbo_frame: "_top" } do %>
    <div class="card-body">
      <div class="row g-2 align-items-end">
        <div class="col-12 col-md-5">
          <%= label_tag :q, "Buscar", class: "form-label small text-muted mb-1" %>
          <%= search_field_tag :q, params[:q], class: "form-control", placeholder: "Nombre o código" %>
        </div>
        <div class="col-6 col-md-3">
          <%= label_tag :category, "Categoría", class: "form-label small text-muted mb-1" %>
          <%= select_tag :category, options_for_select(@categories, params[:category]), include_blank: "Todas", class: "form-select" %>
        </div>
        <div class="col-6 col-md-2">
          <%= label_tag :stock, "Stock", class: "form-label small text-muted mb-1" %>
          <%= select_tag :stock, options_for_select([["Bajo el mínimo", "bajo"]], params[:stock]), include_blank: "Todos", class: "form-select" %>
        </div>
        <div class="col-12 col-md-2 d-flex gap-2">
          <%= submit_tag "Filtrar", class: "btn btn-outline-primary flex-fill", name: nil %>
          <% if filtered %>
            <%= link_to products_path, class: "btn btn-outline-secondary", title: "Quitar filtros", "aria-label": "Quitar filtros" do %>
              <i class="bi bi-x-lg"></i>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <div class="card">
    <% if @products.any? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Producto</th>
              <th class="d-none d-md-table-cell">Categoría</th>
              <th class="text-end">Stock</th>
              <th class="text-end d-none d-sm-table-cell">Precio</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% @products.each do |product| %>
              <tr>
                <td class="min-w-0">
                  <%= link_to product.name, product, class: "fw-bold text-body" %>
                  <% if product.code %>
                    <div class="small text-muted">Código <%= product.code %></div>
                  <% end %>
                  <% if product.category %>
                    <div class="small text-muted d-md-none"><%= product.category %></div>
                  <% end %>
                </td>
                <td class="d-none d-md-table-cell text-muted"><%= product.category || "—" %></td>
                <td class="text-end"><%= product_stock_badge(product) %></td>
                <td class="text-end d-none d-sm-table-cell">
                  <% if product.price %>
                    <%= format_money(product.price, product.currency) %>
                    <div class="small text-muted">por <%= product.unit %></div>
                  <% else %>
                    <span class="text-muted">—</span>
                  <% end %>
                </td>
                <td class="text-end">
                  <div class="gf-row-actions">
                    <%= link_to product, class: "btn btn-sm btn-outline-primary", title: "Ver y mover stock", "aria-label": "Ver" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <% if policy(product).edit? %>
                      <%= link_to edit_product_path(product), class: "btn btn-sm btn-outline-secondary", title: "Editar", "aria-label": "Editar" do %>
                        <i class="bi bi-pencil"></i>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5 px-3 text-muted">
        <i class="bi bi-boxes d-block opacity-50"></i>
        <% if filtered %>
          <p class="mb-1 fw-bold text-body">Ningún producto coincide con el filtro</p>
          <p class="small mb-0"><%= link_to "Ver todos los productos", products_path %></p>
        <% else %>
          <p class="mb-1 fw-bold text-body">Todavía no hay productos</p>
          <p class="small mb-0">
            <% if policy(Product).create? %>
              Agrega lo que vende o guarda la empresa con el botón «Nuevo producto».
            <% else %>
              Cuando la empresa registre sus productos, aparecerán aquí.
            <% end %>
          </p>
        <% end %>
      </div>
    <% end %>
  </div>
  <%= render "shared/pagination", pagy: @pagy %>
</div>
