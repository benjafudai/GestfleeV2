<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div class="min-w-0">
      <h1 class="h3 mb-0"><i class="bi bi-pencil me-2"></i>Editar producto</h1>
      <p class="text-muted mb-0"><%= @product.name %>. El stock se cambia con entradas, salidas o ajustes desde la ficha del producto.</p>
    </div>
  </div>

  <% provide(:submit_text, "Guardar cambios") %>
  <%= render "form", product: @product %>
</div>
