<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0"><i class="bi bi-tools me-2"></i>Órdenes de trabajo</h1>
      <p class="text-muted mb-0">Mantenciones preventivas y correctivas de la flota.</p>
    </div>
    <% if policy(WorkOrder).create? %>
      <%= link_to new_work_order_path, class: "btn btn-primary text-nowrap" do %>
        <i class="bi bi-plus-lg me-1"></i>Nueva orden
      <% end %>
    <% end %>
  </div>

  <% status_counts = policy_scope(WorkOrder).group(:status).count %>
  <% if status_counts.values.sum.positive? %>
    <div class="row g-3 mb-4">
      <% WorkOrder.statuses.each_key do |status| %>
        <div class="col-6 col-lg-3">
          <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-2 gap-sm-3">
              <%= work_order_status_kpi_icon(status) %>
              <div class="min-w-0">
                <div class="small text-muted text-truncate"><%= work_order_status_plural(status) %></div>
                <div class="h4 mb-0"><%= number_with_delimiter(status_counts[status].to_i) %></div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="card">
    <% if @work_orders.any? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>ID</th>
              <th>Vehículo</th>
              <th>Estado</th>
              <th>Tipo</th>
              <th>Mecánico</th>
              <th>Inicio</th>
              <th>Término</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>
          <% editable_ids = @work_orders.select { |wo| policy(wo).edit? && !work_order_terminal?(wo) }.map(&:id) %>
          <tbody>
            <% @work_orders.each do |work_order| %>
              <tr>
                <td class="text-muted">#<%= work_order.id %></td>
                <td>
                  <div class="fw-bold"><%= work_order.vehicle&.plate || "Sin vehículo" %></div>
                  <% if work_order.vehicle %>
                    <div class="small text-muted text-nowrap"><%= [work_order.vehicle.brand, work_order.vehicle.model].compact_blank.join(" ") %></div>
                  <% end %>
                </td>
                <td><%= status_badge(work_order_status_label(work_order.status), work_order.status) %></td>
                <td>
                  <div class="text-nowrap"><i class="bi <%= work_order_kind_icon(work_order) %> text-muted me-1"></i><%= work_order_kind_label(work_order) %></div>
                  <% if work_order.maintenance_plan %>
                    <div class="small text-muted"><%= work_order.maintenance_plan.name %></div>
                  <% end %>
                </td>
                <td class="text-nowrap">
                  <% if work_order.mechanic %>
                    <i class="bi bi-person-badge text-muted me-1"></i><%= work_order.mechanic.email %>
                  <% else %>
                    <span class="text-muted">Sin asignar</span>
                  <% end %>
                </td>
                <td class="text-nowrap"><%= work_order.start_date ? l(work_order.start_date.to_date) : tag.span("Sin fecha", class: "text-muted") %></td>
                <td class="text-nowrap"><%= work_order.end_date ? l(work_order.end_date.to_date) : tag.span("—", class: "text-muted") %></td>
                <td class="text-end">
                  <div class="gf-row-actions">
                    <%= link_to work_order, class: "btn btn-sm btn-outline-primary", title: "Ver", "aria-label": "Ver" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <% if editable_ids.include?(work_order.id) %>
                      <%= link_to edit_work_order_path(work_order), class: "btn btn-sm btn-outline-secondary", title: "Editar", "aria-label": "Editar" do %>
                        <i class="bi bi-pencil"></i>
                      <% end %>
                    <% elsif editable_ids.any? %>
                      <%# Hueco del botón Editar (orden cerrada) para que el ojo quede alineado con las otras filas. %>
                      <span class="btn btn-sm invisible" aria-hidden="true"><i class="bi bi-pencil"></i></span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="card-body">
        <div class="text-center py-5 text-muted">
          <i class="bi bi-clipboard-x d-block opacity-50"></i>
          <p class="mb-1 fw-bold text-body">No hay órdenes de trabajo</p>
          <p class="small mb-0">
            <% if policy(WorkOrder).create? %>
              Crea la primera con el botón «Nueva orden».
            <% else %>
              Cuando se registren órdenes de trabajo, aparecerán aquí.
            <% end %>
          </p>
        </div>
      </div>
    <% end %>
  </div>
  <%= render "shared/pagination", pagy: @pagy %>
</div>
