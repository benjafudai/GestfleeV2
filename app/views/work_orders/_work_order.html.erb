<div id="<%= dom_id work_order %>">
  <p>
    <strong>Vehicle:</strong>
    <%= work_order.vehicle_id %>
  </p>

  <p>
    <strong>Maintenance plan:</strong>
    <%= work_order.maintenance_plan_id %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= work_order.status %>
  </p>

  <p>
    <strong>Start date:</strong>
    <%= work_order.start_date %>
  </p>

  <p>
    <strong>End date:</strong>
    <%= work_order.end_date %>
  </p>

  <p>
    <strong>Mechanic:</strong>
    <%= work_order.mechanic_id %>
  </p>

  <p>
    <strong>Notes:</strong>
    <%= work_order.notes %>
  </p>

</div>
