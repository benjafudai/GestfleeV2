<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
          <li class="breadcrumb-item"><%= link_to "Órdenes de Trabajo", work_orders_path, class: "text-decoration-none" %></li>
          <li class="breadcrumb-item"><%= link_to "Orden ##{@work_order.id}", @work_order, class: "text-decoration-none" %></li>
          <li class="breadcrumb-item active" aria-current="page">Editar</li>
        </ol>
      </nav>
      
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0"><i class="bi bi-pencil-square text-primary me-2"></i> Editar Orden ##{@work_order.id}</h1>
        <%= link_to @work_order, class: "btn btn-outline-secondary btn-sm shadow-sm" do %>
          <i class="bi bi-eye me-1"></i> Ver Orden
        <% end %>
      </div>

      <%= render "form", work_order: @work_order %>
    </div>
  </div>
</div>
