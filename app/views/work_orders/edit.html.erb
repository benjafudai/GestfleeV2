<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0"><i class="bi bi-tools me-2"></i>Editar orden #<%= @work_order.id %></h1>
      <p class="text-muted mb-0"><%= work_order_vehicle_label(@work_order.vehicle) %></p>
    </div>
    <%= link_to @work_order, class: "btn btn-outline-secondary text-nowrap" do %>
      <i class="bi bi-eye me-1"></i>Ver orden
    <% end %>
  </div>

  <% if WorkOrder::TERMINAL_STATUSES.include?(@work_order.status_was) %>
    <div class="alert alert-warning d-flex gap-2" role="alert">
      <i class="bi bi-lock-fill flex-shrink-0 mt-1"></i>
      <div>Esta orden está <%= work_order_status_label(@work_order.status_was).downcase %> y ya no se puede modificar; los cambios no se guardarán.</div>
    </div>
  <% end %>

  <%= render "form", work_order: @work_order %>
</div>
