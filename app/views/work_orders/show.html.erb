<div class="container mt-4">
  <div class="row mb-4 align-items-center">
    <div class="col">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
          <li class="breadcrumb-item"><%= link_to "Órdenes de Trabajo", work_orders_path, class: "text-decoration-none" %></li>
          <li class="breadcrumb-item active" aria-current="page">Orden #<%= @work_order.id %></li>
        </ol>
      </nav>
      <div class="d-flex align-items-center gap-3">
        <h1 class="h3 mb-0"><i class="bi bi-tools me-2"></i> Orden de Trabajo #<%= @work_order.id %></h1>
        <% case @work_order.status %>
        <% when 'pending' %>
          <span class="badge bg-warning text-dark px-3 py-2 fs-6"><i class="bi bi-hourglass-split me-1"></i> Pendiente</span>
        <% when 'in_progress' %>
          <span class="badge bg-primary px-3 py-2 fs-6"><i class="bi bi-play-circle me-1"></i> En Progreso</span>
        <% when 'completed' %>
          <span class="badge bg-success px-3 py-2 fs-6"><i class="bi bi-check-circle me-1"></i> Completada</span>
        <% when 'cancelled' %>
          <span class="badge bg-danger px-3 py-2 fs-6"><i class="bi bi-x-circle me-1"></i> Cancelada</span>
        <% end %>
      </div>
    </div>
    <div class="col-auto d-flex gap-2">
      <%= link_to work_orders_path, class: "btn btn-outline-secondary shadow-sm" do %>
        <i class="bi bi-arrow-left me-1"></i> Volver
      <% end %>
      
      <% if policy(@work_order).edit? && !['completed', 'cancelled'].include?(@work_order.status) %>
        <%= link_to edit_work_order_path(@work_order), class: "btn btn-primary shadow-sm" do %>
          <i class="bi bi-pencil me-1"></i> Editar
        <% end %>
      <% end %>
    </div>
  </div>

  <% if policy(@work_order).change_status? && !['completed', 'cancelled'].include?(@work_order.status) %>
    <div class="alert bg-light border border-secondary border-opacity-25 shadow-sm d-flex align-items-center mb-4">
      <div class="me-auto">
        <i class="bi bi-arrow-right-circle fs-4 text-primary me-2 align-middle"></i>
        <strong class="align-middle">Actualizar Estado:</strong>
      </div>
      <div class="d-flex gap-2">
        <% if @work_order.status == 'pending' %>
          <%= button_to change_status_work_order_path(@work_order, status: 'in_progress'), method: :patch, class: "btn btn-outline-primary shadow-sm", data: { turbo_confirm: "¿Iniciar trabajo?" } do %>
            <i class="bi bi-play-fill me-1"></i> Iniciar Progreso
          <% end %>
        <% end %>

        <% if @work_order.status == 'in_progress' %>
          <%= button_to change_status_work_order_path(@work_order, status: 'completed'), method: :patch, class: "btn btn-outline-success shadow-sm", data: { turbo_confirm: "Al completar, el inventario se descontará. ¿Proceder?" } do %>
            <i class="bi bi-check-lg me-1"></i> Marcar Completada
          <% end %>
        <% end %>

        <%= button_to change_status_work_order_path(@work_order, status: 'cancelled'), method: :patch, class: "btn btn-outline-danger shadow-sm", data: { turbo_confirm: "¿Cancelar esta orden?" } do %>
          <i class="bi bi-x-lg me-1"></i> Cancelar
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="row">
    <!-- Información General -->
    <div class="col-md-5">
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
          <h5 class="fw-bold mb-0">Detalles de la Orden</h5>
        </div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-sm-5 text-muted fw-normal">Vehículo</dt>
            <dd class="col-sm-7 fw-medium"><%= @work_order.vehicle&.plate %> (<%= @work_order.vehicle&.brand %> <%= @work_order.vehicle&.model %>)</dd>

            <dt class="col-sm-5 text-muted fw-normal">Plan</dt>
            <dd class="col-sm-7">
              <% if @work_order.maintenance_plan %>
                <%= link_to @work_order.maintenance_plan.name, @work_order.maintenance_plan, class: "text-decoration-none fw-medium" %>
              <% else %>
                <span class="text-muted fst-italic">Correctivo (Sin Plan)</span>
              <% end %>
            </dd>

            <dt class="col-sm-5 text-muted fw-normal">Asignado A</dt>
            <dd class="col-sm-7">
              <% if @work_order.mechanic %>
                <div class="d-flex align-items-center">
                  <i class="bi bi-person-circle text-secondary me-2"></i> <%= @work_order.mechanic.email %>
                </div>
              <% else %>
                <span class="text-muted fst-italic">No Asignado</span>
              <% end %>
            </dd>

            <dt class="col-sm-5 text-muted fw-normal mt-3">Fecha Inicio</dt>
            <dd class="col-sm-7 mt-3"><i class="bi bi-calendar-event me-1 text-secondary"></i> <%= @work_order.start_date&.strftime("%d/%m/%Y") || "-" %></dd>

            <dt class="col-sm-5 text-muted fw-normal">Fecha Fin</dt>
            <dd class="col-sm-7"><i class="bi bi-calendar-check me-1 text-secondary"></i> <%= @work_order.end_date&.strftime("%d/%m/%Y") || "-" %></dd>

            <dt class="col-sm-12 text-muted fw-normal mt-3">Notas Generales</dt>
            <dd class="col-sm-12 mt-1 p-3 bg-light rounded text-break">
              <%= @work_order.notes.presence || "Sin notas u observaciones adicionales." %>
            </dd>
          </dl>
        </div>
      </div>
    </div>

    <!-- Tareas y Repuestos -->
    <div class="col-md-7">
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0">Tareas (<%= @work_order.work_order_tasks.count %>)</h5>
        </div>
        <div class="card-body">
          <% if @work_order.work_order_tasks.any? %>
            <ul class="list-group list-group-flush border rounded-3 overflow-hidden shadow-sm">
              <% @work_order.work_order_tasks.each do |task| %>
                <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                  <div class="d-flex align-items-center">
                    <% if task.completed? %>
                      <i class="bi bi-check-circle-fill fs-4 text-success me-3"></i>
                      <span class="text-decoration-line-through text-muted"><%= task.description %></span>
                    <% else %>
                      <i class="bi bi-circle fs-4 text-secondary me-3"></i>
                      <span class="fw-medium"><%= task.description %></span>
                    <% end %>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <div class="text-center py-4 bg-light rounded text-muted small">No hay tareas registradas.</div>
          <% end %>
        </div>
      </div>

      <% guided = @work_order.maintenance_plan&.maintenance_task_templates&.select(&:maintenance_task) || [] %>
      <% if guided.any? %>
        <div class="card shadow-sm border-0 mb-4">
          <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
            <h5 class="fw-bold mb-0">Guía del plan</h5>
          </div>
          <div class="card-body">
            <ul class="list-group list-group-flush border rounded-3 overflow-hidden">
              <% guided.each do |template| %>
                <li class="list-group-item p-3">
                  <div class="fw-medium"><%= template.description %></div>
                  <%= render "maintenance_plans/task_guide", template: template, vehicle_model: @work_order.maintenance_plan.vehicle_model %>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0">Repuestos Utilizados (<%= @work_order.work_order_part_usages.count %>)</h5>
        </div>
        <div class="card-body">
          <% if @work_order.work_order_part_usages.any? %>
            <div class="table-responsive border rounded-3 shadow-sm">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Repuesto</th>
                    <th class="text-end">Cantidad</th>
                  </tr>
                </thead>
                <tbody>
                  <% @work_order.work_order_part_usages.each do |usage| %>
                    <tr>
                      <td>
                        <div class="fw-medium"><%= usage.part&.name %></div>
                        <div class="small text-muted">SKU: <%= usage.part&.sku %></div>
                      </td>
                      <td class="text-end fw-bold">
                        <%= usage.quantity %> <span class="fw-normal text-muted small"><%= usage.part&.unit_of_measure %></span>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-4 bg-light rounded text-muted small">No se han registrado repuestos.</div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
