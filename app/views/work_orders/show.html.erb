<% vehicle = @work_order.vehicle %>
<% plan = @work_order.maintenance_plan %>
<% tasks = @work_order.work_order_tasks.to_a %>
<% done_tasks = tasks.count(&:completed?) %>
<% part_usages = @work_order.work_order_part_usages.includes(:part).to_a %>
<% terminal = work_order_terminal?(@work_order) %>
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0"><i class="bi bi-tools me-2"></i>Orden de trabajo #<%= @work_order.id %></h1>
      <p class="text-muted mb-0"><%= work_order_vehicle_label(vehicle) %> · Mantención <%= work_order_kind_label(@work_order).downcase %></p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <% if policy(@work_order).edit? && !terminal %>
        <%= link_to edit_work_order_path(@work_order), class: "btn btn-primary text-nowrap" do %>
          <i class="bi bi-pencil me-1"></i>Editar
        <% end %>
      <% end %>
      <%= link_to work_orders_path, class: "btn btn-outline-secondary text-nowrap" do %>
        <i class="bi bi-arrow-left me-1"></i>Volver
      <% end %>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body d-flex flex-wrap align-items-center gap-3">
      <div class="d-flex align-items-center gap-3 flex-grow-1 min-w-0">
        <%= work_order_status_icon_circle(@work_order.status) %>
        <div class="min-w-0">
          <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="fw-bold">Estado</span>
            <%= status_badge(work_order_status_label(@work_order.status), @work_order.status) %>
          </div>
          <div class="small text-muted mt-1"><%= work_order_status_hint(@work_order.status, parts_used: part_usages.any?) %></div>
        </div>
      </div>
      <% if policy(@work_order).change_status? && !terminal %>
        <div class="col-12 col-md-auto d-flex flex-wrap gap-2">
          <% if @work_order.pending? %>
            <%= button_to change_status_work_order_path(@work_order, status: 'in_progress'), method: :patch, form_class: "button_to flex-fill", class: "btn btn-outline-primary text-nowrap w-100", data: { turbo_confirm: "¿Iniciar el trabajo de esta orden?" } do %>
              <i class="bi bi-play-fill me-1"></i>Iniciar trabajo
            <% end %>
          <% end %>
          <% if @work_order.in_progress? %>
            <%= button_to change_status_work_order_path(@work_order, status: 'completed'), method: :patch, form_class: "button_to flex-fill", class: "btn btn-outline-success text-nowrap w-100", data: { turbo_confirm: "Al completar la orden se descontarán del inventario los repuestos utilizados. ¿Continuar?" } do %>
              <i class="bi bi-check-lg me-1"></i>Marcar como completada
            <% end %>
          <% end %>
          <%= button_to change_status_work_order_path(@work_order, status: 'cancelled'), method: :patch, form_class: "button_to flex-fill", class: "btn btn-outline-danger text-nowrap w-100", data: { turbo_confirm: "¿Cancelar esta orden de trabajo? Después no se podrá modificar." } do %>
            <i class="bi bi-x-lg me-1"></i>Cancelar orden
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-5">
      <div class="card">
        <div class="card-header bg-white">
          <%= maintenance_card_title("Detalles de la orden", icon: "bi-info-circle") %>
        </div>
        <ul class="list-group list-group-flush">
          <li class="list-group-item d-flex justify-content-between gap-3">
            <span class="text-muted">Vehículo</span>
            <span class="text-end">
              <% if vehicle %>
                <% if policy(vehicle).show? %>
                  <%= link_to vehicle.plate, vehicle_path(vehicle), class: "fw-bold" %>
                <% else %>
                  <span class="fw-bold"><%= vehicle.plate %></span>
                <% end %>
                <span class="d-block small text-muted"><%= [vehicle.brand, vehicle.model].compact_blank.join(" ") %></span>
              <% else %>
                <span class="text-muted">Sin vehículo</span>
              <% end %>
            </span>
          </li>
          <li class="list-group-item d-flex justify-content-between gap-3">
            <span class="text-muted">Tipo</span>
            <span class="text-end"><i class="bi <%= work_order_kind_icon(@work_order) %> text-muted me-1"></i><%= work_order_kind_label(@work_order) %></span>
          </li>
          <li class="list-group-item d-flex justify-content-between gap-3">
            <span class="text-muted">Plan</span>
            <span class="text-end">
              <% if plan %>
                <%= link_to plan.name, plan %>
              <% else %>
                <span class="text-muted">Sin plan</span>
              <% end %>
            </span>
          </li>
          <li class="list-group-item d-flex justify-content-between gap-3">
            <span class="text-muted">Mecánico</span>
            <span class="text-end text-break">
              <% if @work_order.mechanic %>
                <i class="bi bi-person-badge text-muted me-1"></i><%= @work_order.mechanic.email %>
              <% else %>
                <span class="text-muted">Sin asignar</span>
              <% end %>
            </span>
          </li>
          <% if @work_order.odometer_at_maintenance.present? %>
            <li class="list-group-item d-flex justify-content-between gap-3">
              <span class="text-muted">Odómetro</span>
              <span class="text-end"><%= number_with_delimiter(@work_order.odometer_at_maintenance) %> km</span>
            </li>
          <% end %>
          <li class="list-group-item d-flex justify-content-between gap-3">
            <span class="text-muted">Inicio</span>
            <span class="text-end"><%= @work_order.start_date ? l(@work_order.start_date.to_date, format: :long) : tag.span("Sin fecha", class: "text-muted") %></span>
          </li>
          <li class="list-group-item d-flex justify-content-between gap-3">
            <span class="text-muted">Término</span>
            <span class="text-end"><%= @work_order.end_date ? l(@work_order.end_date.to_date, format: :long) : tag.span("Sin fecha", class: "text-muted") %></span>
          </li>
          <li class="list-group-item">
            <div class="text-muted mb-2">Notas</div>
            <% if @work_order.notes.present? %>
              <div class="p-3 bg-light rounded-3 text-break"><%= simple_format(@work_order.notes, {}, wrapper_tag: "div") %></div>
            <% else %>
              <div class="text-muted fst-italic">Sin notas ni observaciones.</div>
            <% end %>
          </li>
        </ul>
      </div>
    </div>

    <div class="col-lg-7 d-flex flex-column gap-4">
      <div class="card">
        <div class="card-header bg-white d-flex justify-content-between align-items-center gap-2">
          <%= maintenance_card_title("Tareas", icon: "bi-list-check") %>
          <% if tasks.any? %>
            <span class="small text-muted text-nowrap"><%= work_order_tasks_progress(done_tasks, tasks.size) %></span>
          <% end %>
        </div>
        <% if tasks.any? %>
          <div class="px-3 pt-3">
            <div class="progress" role="progressbar" aria-label="Avance de las tareas" aria-valuenow="<%= done_tasks %>" aria-valuemin="0" aria-valuemax="<%= tasks.size %>" style="height: 6px;">
              <div class="progress-bar bg-success" style="width: <%= (done_tasks * 100.0 / tasks.size).round %>%"></div>
            </div>
          </div>
          <ul class="list-group list-group-flush mt-2">
            <% tasks.each do |task| %>
              <li class="list-group-item d-flex align-items-start gap-2">
                <% if task.completed? %>
                  <i class="bi bi-check-circle-fill text-success fs-5 lh-1" title="Completada"></i>
                  <span class="text-muted"><%= task.description %></span>
                <% else %>
                  <i class="bi bi-circle text-secondary fs-5 lh-1" title="Pendiente"></i>
                  <span><%= task.description %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <div class="card-body">
            <div class="text-center py-4 text-muted">
              <i class="bi bi-list-check d-block opacity-50"></i>
              <p class="mb-1 fw-bold text-body">No hay tareas registradas</p>
              <p class="small mb-0"><%= terminal ? "La orden se cerró sin tareas registradas." : "Las tareas se agregan al editar la orden." %></p>
            </div>
          </div>
        <% end %>
      </div>

      <% guided = plan&.maintenance_task_templates&.select(&:maintenance_task) || [] %>
      <% if guided.any? %>
        <div class="card">
          <div class="card-header bg-white">
            <%= maintenance_card_title("Guía del plan", icon: "bi-journal-text") %>
          </div>
          <ul class="list-group list-group-flush">
            <% guided.each do |template| %>
              <li class="list-group-item">
                <div class="fw-bold"><%= template.description %></div>
                <%= render "maintenance_plans/task_guide", template: template, vehicle_model: plan.vehicle_model %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="card">
        <div class="card-header bg-white d-flex justify-content-between align-items-center gap-2">
          <%= maintenance_card_title("Repuestos utilizados", icon: "bi-box-seam") %>
          <% if part_usages.any? %>
            <span class="small text-muted text-nowrap"><%= part_usages.size == 1 ? "1 repuesto" : "#{part_usages.size} repuestos" %></span>
          <% end %>
        </div>
        <% if part_usages.any? %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Repuesto</th>
                  <th class="text-end">Cantidad</th>
                </tr>
              </thead>
              <tbody>
                <% part_usages.each do |usage| %>
                  <tr>
                    <td>
                      <div class="fw-bold"><%= usage.part&.name || "Repuesto eliminado" %></div>
                      <% if usage.part&.sku.present? %>
                        <div class="small text-muted">SKU <%= usage.part.sku %></div>
                      <% end %>
                    </td>
                    <td class="text-end text-nowrap">
                      <span class="fw-bold"><%= work_order_quantity(usage.quantity) %></span>
                      <span class="small text-muted"><%= unit_of_measure_label(usage.quantity, usage.part&.unit_of_measure) %></span>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="card-body">
            <div class="text-center py-4 text-muted">
              <i class="bi bi-box-seam d-block opacity-50"></i>
              <p class="mb-1 fw-bold text-body">No se registraron repuestos</p>
              <p class="small mb-0"><%= terminal ? "La orden se cerró sin repuestos registrados." : "Los repuestos usados se descuentan del inventario al completar la orden." %></p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
