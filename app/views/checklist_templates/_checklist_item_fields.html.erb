<%# Una pregunta de la plantilla. Debe calzar con <template id="item-template"> de _form (lo usa el botón "Agregar pregunta"). %>
<% label_errors = f.object.errors.full_messages_for(:label) %>
<div class="item-fields border rounded-3 p-3" data-item>
  <% if f.object.persisted? %>
    <%= f.hidden_field :id %>
    <%= f.hidden_field :_destroy, value: '0', class: 'destroy-field' %>
  <% end %>

  <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
    <%= f.label :label, class: "form-label mb-0" do %>Pregunta <span class="text-danger">*</span><% end %>
    <button type="button" class="btn btn-sm btn-outline-danger remove-item" title="Quitar pregunta" aria-label="Quitar pregunta">
      <i class="bi bi-trash"></i>
    </button>
  </div>
  <%= f.text_field :label, class: ["form-control", ("is-invalid" if label_errors.any?)], placeholder: "Ej: ¿Frenos en buen estado?" %>
  <% if label_errors.any? %>
    <div class="invalid-feedback d-block"><%= label_errors.first %></div>
  <% end %>

  <div class="row g-2 align-items-end mt-1">
    <div class="col-12 col-sm-5">
      <%= f.label :item_type, "Tipo de respuesta", class: "form-label" %>
      <%= f.select :item_type,
            [["Sí / No", "boolean"], ["Texto", "text"], ["Número", "number"]],
            {}, class: "form-select" %>
    </div>
    <div class="col-6 col-sm-3">
      <%= f.label :position, "Posición", class: "form-label" %>
      <%= f.number_field :position, class: "form-control item-position", min: 0 %>
    </div>
    <div class="col-6 col-sm-4">
      <div class="form-check form-switch mb-2">
        <%= f.check_box :required, class: "form-check-input", role: "switch" %>
        <%= f.label :required, "Obligatoria", class: "form-check-label" %>
      </div>
    </div>
  </div>
</div>
