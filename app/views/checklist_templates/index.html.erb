<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0"><i class="bi bi-list-check me-2"></i>Plantillas de checklist</h1>
      <p class="text-muted mb-0">Las preguntas que los choferes responden antes de operar el vehículo.</p>
    </div>
    <% if policy(ChecklistTemplate).create? %>
      <%= link_to new_checklist_template_path, class: "btn btn-primary text-nowrap" do %>
        <i class="bi bi-plus-lg me-1"></i>Nueva plantilla
      <% end %>
    <% end %>
  </div>

  <% if @templates.any? %>
    <div class="row g-3">
      <% @templates.each do |tpl| %>
        <% items = tpl.checklist_items.to_a %>
        <% required_count = items.count(&:required?) %>
        <div class="col-md-6 col-xl-4">
          <div class="card h-100">
            <div class="card-body d-flex flex-column gap-3">
              <div class="d-flex align-items-start gap-3">
                <span class="gf-action-icon is-primary" aria-hidden="true"><i class="bi bi-list-check"></i></span>
                <div class="min-w-0">
                  <h2 class="card-title h5 mb-1 text-break"><%= link_to tpl.name, tpl, class: "text-reset" %></h2>
                  <p class="small text-muted mb-0"><%= tpl.description.presence || "Sin descripción" %></p>
                </div>
              </div>
              <div class="d-flex flex-wrap gap-2 mt-auto">
                <span class="badge text-bg-primary"><%= items.size == 1 ? "1 pregunta" : "#{items.size} preguntas" %></span>
                <% if required_count.positive? %>
                  <span class="badge text-bg-light"><%= required_count == 1 ? "1 obligatoria" : "#{required_count} obligatorias" %></span>
                <% end %>
              </div>
            </div>
            <div class="card-footer d-flex align-items-center justify-content-between gap-2">
              <%= link_to tpl, class: "btn btn-sm btn-outline-primary text-nowrap" do %>
                <i class="bi bi-eye me-1"></i>Ver
              <% end %>
              <% if policy(tpl).update? || policy(tpl).destroy? %>
                <div class="gf-row-actions">
                  <% if policy(tpl).update? %>
                    <%= link_to edit_checklist_template_path(tpl), class: "btn btn-sm btn-outline-secondary", title: "Editar", "aria-label": "Editar" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                  <% end %>
                  <% if policy(tpl).destroy? %>
                    <%= button_to tpl, method: :delete, class: "btn btn-sm btn-outline-danger", title: "Eliminar", "aria-label": "Eliminar",
                          form: { data: { turbo_confirm: "¿Eliminar esta plantilla? También se borrarán los checklists enviados con ella." } } do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="card">
      <div class="card-body">
        <div class="text-center py-5 text-muted">
          <i class="bi bi-clipboard-x d-block opacity-50"></i>
          <p class="mb-1 fw-bold text-body">No hay plantillas de checklist</p>
          <% if policy(ChecklistTemplate).create? %>
            <p class="small mb-3">Crea la primera para que los choferes puedan completar su checklist diario.</p>
            <%= link_to new_checklist_template_path, class: "btn btn-primary text-nowrap" do %>
              <i class="bi bi-plus-lg me-1"></i>Crear primera plantilla
            <% end %>
          <% else %>
            <p class="small mb-0">Un administrador debe crear la primera plantilla.</p>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
