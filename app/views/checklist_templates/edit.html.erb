<div class="container mt-4" style="max-width: 760px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0"><i class="bi bi-list-check me-2"></i>Editar plantilla</h1>
      <p class="text-muted mb-0"><%= @template.name_was.presence || @template.name %></p>
    </div>
    <%= link_to @template, class: "btn btn-outline-secondary text-nowrap" do %>
      <i class="bi bi-eye me-1"></i>Ver plantilla
    <% end %>
  </div>
  <%= render "form", template: @template %>
</div>
