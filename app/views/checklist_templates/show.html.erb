<% items = @template.checklist_items.to_a %>
<% required_count = items.count(&:required?) %>
<% submissions_count = @template.checklist_submissions.count %>
<% type_badges = {
     "boolean" => ["bi-check2-square", "Sí / No"],
     "text"    => ["bi-fonts",         "Texto"],
     "number"  => ["bi-123",           "Número"]
   } %>
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div class="min-w-0">
      <h1 class="h3 mb-0 text-break"><i class="bi bi-list-check me-2"></i><%= @template.name %></h1>
      <p class="text-muted mb-0"><%= @template.description.presence || "Plantilla de checklist" %></p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <%= link_to checklist_templates_path, class: "btn btn-outline-secondary text-nowrap" do %>
        <i class="bi bi-arrow-left me-1"></i>Volver
      <% end %>
      <% if policy(@template).update? %>
        <%= link_to edit_checklist_template_path(@template), class: "btn btn-primary text-nowrap" do %>
          <i class="bi bi-pencil me-1"></i>Editar
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="row g-2 g-md-3 mb-4">
    <% [
         ["bi-list-check",      "primary", items.size,        items.size == 1 ? "Pregunta" : "Preguntas"],
         ["bi-asterisk",        "danger",  required_count,    required_count == 1 ? "Obligatoria" : "Obligatorias"],
         ["bi-clipboard-check", "success", submissions_count, submissions_count == 1 ? "Checklist recibido" : "Checklists recibidos"]
       ].each do |icon, tone, count, label| %>
      <% tone = "secondary" unless count.positive? %>
      <div class="col-4">
        <div class="card h-100">
          <div class="card-body d-flex flex-column flex-md-row align-items-center gap-2 gap-md-3 p-3 text-center text-md-start">
            <span class="gf-action-icon bg-<%= tone %>-subtle text-<%= tone %>-emphasis" aria-hidden="true"><i class="bi <%= icon %>"></i></span>
            <div class="min-w-0">
              <div class="fs-4 fw-bold lh-1"><%= number_with_delimiter(count) %></div>
              <div class="small text-muted mt-1"><%= label %></div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center gap-2">
      <%= checklist_card_title("Preguntas", icon: "bi-list-ol") %>
      <span class="small text-muted text-nowrap">En el orden en que las ve el chofer</span>
    </div>
    <% if items.any? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col" style="width: 3.5rem;">#</th>
              <th scope="col">Pregunta</th>
              <th scope="col" class="d-none d-sm-table-cell">Tipo de respuesta</th>
              <th scope="col" class="d-none d-sm-table-cell">Requisito</th>
            </tr>
          </thead>
          <tbody>
            <% items.each_with_index do |item, idx| %>
              <% icon, type_label = type_badges.fetch(item.item_type.to_s, ["bi-question-circle", item.item_type.to_s.humanize]) %>
              <% type_badge = capture do %><span class="badge text-bg-light"><i class="bi <%= icon %> me-1"></i><%= type_label %></span><% end %>
              <% required_badge = capture do %><% if item.required? %><span class="badge text-bg-danger">Obligatoria</span><% else %><span class="text-muted">Opcional</span><% end %><% end %>
              <tr>
                <td class="text-muted"><%= idx + 1 %></td>
                <td class="text-wrap">
                  <div class="fw-bold"><%= item.label %></div>
                  <div class="d-flex flex-wrap align-items-center gap-2 mt-1 d-sm-none small"><%= type_badge %><%= required_badge %></div>
                </td>
                <td class="text-nowrap d-none d-sm-table-cell"><%= type_badge %></td>
                <td class="text-nowrap d-none d-sm-table-cell"><%= required_badge %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="card-body">
        <div class="text-center py-5 text-muted">
          <i class="bi bi-list-check d-block opacity-50"></i>
          <p class="mb-1 fw-bold text-body">Esta plantilla no tiene preguntas</p>
          <% if policy(@template).update? %>
            <p class="small mb-0"><%= link_to "Edítala para agregar preguntas", edit_checklist_template_path(@template) %>.</p>
          <% else %>
            <p class="small mb-0">Un administrador debe agregarle preguntas.</p>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
