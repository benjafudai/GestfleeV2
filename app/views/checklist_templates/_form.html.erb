<%= form_with model: template, local: true do |f| %>
  <%= render "shared/form_errors", object: template, subject: "la plantilla" %>

  <div class="card mb-4">
    <div class="card-header bg-white">
      <%= checklist_card_title("Datos de la plantilla", icon: "bi-card-text") %>
    </div>
    <div class="card-body">
      <div class="mb-3">
        <%= f.label :name, class: "form-label" do %>Nombre <span class="text-danger">*</span><% end %>
        <%= f.text_field :name, class: ["form-control", ("is-invalid" if template.errors[:name].any?)], placeholder: "Ej: Inspección diaria general" %>
        <% if template.errors[:name].any? %>
          <div class="invalid-feedback d-block"><%= template.errors.full_messages_for(:name).first %></div>
        <% end %>
      </div>

      <div>
        <%= f.label :description, "Descripción", class: "form-label" %>
        <%= f.text_area :description, class: "form-control", rows: 2, placeholder: "Cuándo se usa esta plantilla (opcional)" %>
      </div>
    </div>
  </div>

  <%# Preguntas %>
  <div class="card">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
      <%= checklist_card_title("Preguntas del checklist", icon: "bi-list-check", subtitle: "Lo que el chofer responde antes de salir.") %>
      <button type="button" id="add-item" class="btn btn-sm btn-outline-primary text-nowrap">
        <i class="bi bi-plus-lg me-1"></i>Agregar pregunta
      </button>
    </div>
    <div class="card-body vstack gap-3" id="items-container">
      <div id="items-empty" class="text-center text-muted small py-3"<%= " hidden" if template.checklist_items.any? { |i| !i.marked_for_destruction? } %>>
        <i class="bi bi-info-circle me-1"></i>Aún no hay preguntas. Usa «Agregar pregunta» para crear la primera.
      </div>
      <%= f.fields_for :checklist_items do |item_f| %>
        <%= render "checklist_item_fields", f: item_f %>
      <% end %>
    </div>
  </div>

  <div class="d-flex justify-content-end gap-2 mt-4">
    <%= link_to "Cancelar", template.persisted? ? template : checklist_templates_path, class: "btn btn-outline-secondary" %>
    <%= f.submit template.new_record? ? "Crear plantilla" : "Guardar cambios", class: "btn btn-primary" %>
  </div>
<% end %>

<%# Pregunta nueva (la agrega el botón "Agregar pregunta"); misma estructura que _checklist_item_fields %>
<template id="item-template">
  <div class="item-fields border rounded-3 p-3" data-item>
    <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
      <label class="form-label mb-0" for="checklist_template_checklist_items_attributes_NEW_INDEX_label">Pregunta <span class="text-danger">*</span></label>
      <button type="button" class="btn btn-sm btn-outline-danger remove-item" title="Quitar pregunta" aria-label="Quitar pregunta">
        <i class="bi bi-trash"></i>
      </button>
    </div>
    <input type="text" id="checklist_template_checklist_items_attributes_NEW_INDEX_label"
           name="checklist_template[checklist_items_attributes][NEW_INDEX][label]"
           class="form-control" placeholder="Ej: ¿Frenos en buen estado?" required>

    <div class="row g-2 align-items-end mt-1">
      <div class="col-12 col-sm-5">
        <label class="form-label" for="checklist_template_checklist_items_attributes_NEW_INDEX_item_type">Tipo de respuesta</label>
        <select id="checklist_template_checklist_items_attributes_NEW_INDEX_item_type"
                name="checklist_template[checklist_items_attributes][NEW_INDEX][item_type]" class="form-select">
          <option value="boolean">Sí / No</option>
          <option value="text">Texto</option>
          <option value="number">Número</option>
        </select>
      </div>
      <div class="col-6 col-sm-3">
        <label class="form-label" for="checklist_template_checklist_items_attributes_NEW_INDEX_position">Posición</label>
        <input type="number" id="checklist_template_checklist_items_attributes_NEW_INDEX_position"
               name="checklist_template[checklist_items_attributes][NEW_INDEX][position]"
               class="form-control item-position" value="0" min="0">
      </div>
      <div class="col-6 col-sm-4">
        <div class="form-check form-switch mb-2">
          <%# el hidden va antes del checkbox: así, si se marca, gana el "1" %>
          <input type="hidden" name="checklist_template[checklist_items_attributes][NEW_INDEX][required]" value="0">
          <input class="form-check-input" type="checkbox" role="switch" id="checklist_template_checklist_items_attributes_NEW_INDEX_required"
                 name="checklist_template[checklist_items_attributes][NEW_INDEX][required]" value="1">
          <label class="form-check-label" for="checklist_template_checklist_items_attributes_NEW_INDEX_required">Obligatoria</label>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
  (function() {
    let itemIndex = <%= template.checklist_items.size %>;
    const addBtn = document.getElementById('add-item');
    const container = document.getElementById('items-container');
    const tmpl = document.getElementById('item-template');

    addBtn.addEventListener('click', function() {
      const html = tmpl.innerHTML.replace(/NEW_INDEX/g, itemIndex);
      const wrapper = document.createElement('div');
      wrapper.innerHTML = html;
      const item = wrapper.firstElementChild;
      container.appendChild(item);
      autoPositions();
      itemIndex++;
      const input = item.querySelector('input[type="text"]');
      if (input) input.focus();
    });

    container.addEventListener('click', function(e) {
      const btn = e.target.closest('.remove-item');
      if (btn) {
        const itemDiv = btn.closest('[data-item]');
        // If persisted record, mark for destruction; else remove DOM
        const destroyInput = itemDiv.querySelector('input[name*="_destroy"]');
        if (destroyInput) {
          destroyInput.value = '1';
          itemDiv.style.display = 'none';
        } else {
          itemDiv.remove();
        }
        autoPositions();
      }
    });

    function autoPositions() {
      container.querySelectorAll('.item-position').forEach((inp, idx) => {
        inp.value = idx;
      });
      const visible = Array.from(container.querySelectorAll('[data-item]')).some((el) => el.style.display !== 'none');
      const empty = document.getElementById('items-empty');
      if (empty) empty.hidden = visible;
    }
  })();
</script>
