<div class="max-w-2xl mx-auto py-8">
  <div class="bg-white shadow rounded-lg p-6">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">Configuración de Empresa</h1>
    
    <p class="mb-4 text-gray-600">
      Configure las funcionalidades activas para <strong><%= @company.name %></strong>.
      Las opciones desactivadas ocultarán los menús correspondientes a los usuarios.
    </p>

    <%= form_with(model: @company, url: company_settings_path, local: true, method: :patch) do |f| %>
      
      <div class="space-y-4 mb-6">
        <div class="flex items-start">
          <div class="flex items-center h-5">
            <%= f.check_box :has_mechanic, class: "focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300 rounded" %>
          </div>
          <div class="ml-3 text-sm">
            <%= f.label :has_mechanic, "Habilitar Rol Mecánico", class: "font-medium text-gray-700" %>
            <p class="text-gray-500">Permite asignar mecánicos y gestionar órdenes de trabajo y mantenciones.</p>
          </div>
        </div>

        <div class="flex items-start">
          <div class="flex items-center h-5">
            <%= f.check_box :has_analyst, class: "focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300 rounded" %>
          </div>
          <div class="ml-3 text-sm">
            <%= f.label :has_analyst, "Habilitar Rol Analista", class: "font-medium text-gray-700" %>
            <p class="text-gray-500">Habilita dashboards avanzados y gestión de KPIs.</p>
          </div>
        </div>
      </div>

      <div class="flex justify-end border-t pt-4">
        <%= link_to "Cancelar", root_path, class: "mr-3 inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-gray-700 bg-gray-100 hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500" %>
        <%= f.submit "Guardar Configuración", class: "inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      </div>
    <% end %>
  </div>
</div>
